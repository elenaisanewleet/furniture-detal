# =========================================================================
#  Мастерская Архангельское — переменные окружения
#  Скопируйте в .env для локальной разработки; на Vercel задаются
#  в Settings → Environment Variables.
# =========================================================================

# ---- Домен -------------------------------------------------------------
# Боевой адрес сайта. Отсюда его берут canonical, Open Graph, sitemap.xml,
# robots.txt и schema.org — в самих страницах домена нет ни разу.
# Пока своего домена нет, оставьте пустым: на Vercel адрес берётся из
# системной VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# ---- Приём заявок ------------------------------------------------------
# Адрес обработчика. Пусто = форма работает как раньше: номер заявки
# выдаёт браузер, заявка уходит только в мессенджер.
# На Vercel функция лежит рядом с сайтом, поэтому достаточно пути.
PUBLIC_LEAD_ENDPOINT=/api/zayavka

# Почта для заявок. Пусто = кнопка «Отправить на почту» не показывается,
# чтобы не вести в пустоту.
PUBLIC_MAIL=

# Бот приёма заявок без @. Задан — заявки идут в бота; пусто — в личный
# Telegram оператора (@elenaisanewleet), как сейчас.
PUBLIC_TG_BOT=

# ---- Telegram (серверная часть) ----------------------------------------
# Токен от @BotFather и id чата, куда падают заявки. Пока не заданы,
# заявка сохраняется, но в Telegram не уходит.
# Узнать chat_id: написать боту и открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Хранилище заявок --------------------------------------------------
# Драйвер выбирается сам по тому, какие переменные заданы.
#
# 1. Upstash Redis (Vercel → Marketplace → Upstash). Даёт сквозную
#    нумерацию 73-0001, 73-0002… и хранит карточку заявки.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# 2. Vercel Blob (Vercel → Storage → Blob). Хранит JSON заявки и файл
#    голосового. Без него голосовое уходит только в Telegram.
BLOB_READ_WRITE_TOKEN=
#
# Ни одна не задана — заявка уходит в Telegram и там же хранится,
# номер выдаётся по дате и времени.

# ---- Прочее ------------------------------------------------------------
# Поиск: коды из Яндекс.Вебмастера и Google Search Console.
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=

# Яндекс.Метрика. Пусто = счётчик не подключается.
PUBLIC_METRIKA_ID=
