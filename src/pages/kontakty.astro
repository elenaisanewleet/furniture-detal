---
import Base from '~/layouts/Base.astro';
import RelatedLinks from '~/components/RelatedLinks.astro';
import { services } from '~/data/nav';
import { site, placeLine } from '~/data/site';
import { contactPage } from '~/lib/schema';
import { originOf } from '~/lib/origin';

const title = 'Контакты — Мастерская Архангельское, Ульяновская область';
const description = `Телефон ${site.phone.label}, WhatsApp, Telegram. Мастерская в селе Архангельское, работаем по Ульяновской области. Адрес и время приезда согласуем в мессенджере.`;

const breadcrumb = [
  { name: 'Главная', href: '/' },
  { name: 'Контакты', href: '/kontakty/' },
];

const schema = [contactPage(originOf(Astro.site))];
---

<Base
  title={title}
  description={description}
  keywords="мастерская село Архангельское контакты, фурнитура Ульяновск телефон, мастерская Ульяновская область адрес"
  canonical="/kontakty/"
  breadcrumb={breadcrumb}
  schema={schema}
>
  <section>
    <div class="wrap" style="padding-block:var(--sp-6) var(--section-y-md)">
      <div class="eyebrow">Связаться</div>
      <h1>Контакты</h1>

      <div class="two" style="margin-block-start:var(--sp-6)">
        <div class="pane warm">
          <a class="phone" href={`tel:${site.phone.tel}`}>{site.phone.label}</a>
          <div class="hint">{site.phone.person}, {site.phone.role}</div>
          <div class="links">
            <a href={site.whatsapp} rel="noopener">Написать в WhatsApp по этому номеру</a>
            <a href={site.telegram.botUrl} rel="noopener">Написать в Telegram</a>
            <a href="/zakaz/">Показать деталь на сайте</a>
          </div>
          <div class="sep">
            {placeLine}
            <div class="hint" style="margin-block-start:var(--sp-1)">
              Точный адрес и время приезда согласуем в мессенджере. Работаем по Ульяновской области.
            </div>
          </div>
        </div>

        <div class="pane">
          <h3>Что прислать, чтобы ответить быстро</h3>
          <ul class="plain">
            <li>фото детали или узла</li>
            <li>размеры: габарит, отверстия, резьба</li>
            <li>количество</li>
            <li>к какому сроку нужно</li>
          </ul>
          <p class="hint">Если названия детали не знаете — фотографии достаточно.</p>
          <a class="btn dark" href="/zakaz/">Показать деталь</a>
        </div>
      </div>
    </div>
  </section>

  <section class="warmbg">
    <div class="wrap pad-s">
      <h2>Работы</h2>
      <div style="margin-block-start:var(--sp-6)">
        <RelatedLinks links={services} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Телефон на странице контактов — крупная строка, а не ссылка в тексте:
     это главное, ради чего сюда заходят. */
  .phone {
    display: block;
    margin-block: var(--sp-2) var(--sp-1);
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .links {
    display: grid;
    gap: var(--sp-2);
    margin-block-start: var(--sp-2);
    font-size: var(--step-1);
  }

  .plain {
    margin: 0;
    padding-inline-start: var(--sp-5);
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .plain li + li {
    margin-block-start: var(--sp-1);
  }
</style>
