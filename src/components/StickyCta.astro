---
import { site } from '~/data/site';

/**
 * Полоса внизу экрана — только на телефоне. На десктопе телефон и кнопка
 * уже стоят в шапке, и полоса отняла бы у страницы 72 пикселя без нужды
 * (см. --sticky-cta-h: на широких экранах он равен нулю).
 *
 * Главное действие здесь то же, что и везде, — показать деталь: на
 * телефоне человек как раз и держит в руках камеру. Красное на экране
 * одно, и это оно.
 */
---

<div class="sticky no-print">
  <a href="/zakaz/#zayavka">Показать деталь</a>
  <a class="alt" href={`tel:${site.phone.tel}`}>Позвонить</a>
</div>
