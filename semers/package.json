{
  "name": "semers-store",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "localize-images": "node scripts/localize-images.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "fonts:check": "node scripts/fetch-fonts.mjs --check",
    "check:seo": "node scripts/check-seo.mjs",
    "check:html": "node scripts/check-html.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:flow": "node scripts/check-flow.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:security": "node scripts/check-security.mjs",
    "verify": "npm test && npm run build && npm run check:html && npm run check:seo && npm run check:schema && npm run check:security && npm run check:i18n",
    "test": "node scripts/test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
