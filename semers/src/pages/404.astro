---
/*
 * Astro only emits dist/404.html for a page file literally named 404.astro, and
 * that exact filename is what the Worker serves for a path that matched
 * nothing. One file per language, all three rendering the same component: see
 * src/pages/ru/404.astro and src/pages/lv/404.astro.
 */
import Base from '~/layouts/Base.astro';
import NotFound from '~/components/NotFound.astro';
---
<Base title="Page not found" description="That page fell off the tree." noindex>
  <NotFound />
</Base>
