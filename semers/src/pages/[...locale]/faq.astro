---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { FAQS, type Faq } from '~/data/faq';
import { site } from '~/data/site';
import { formatThreshold } from '~/data/products';
import { faqPage } from '~/lib/schema';

import { localeParams } from '~/i18n/config';
import type { Locale } from '~/i18n/config';
import { localizedFaqs } from '~/data/copy';

/** One page per language; the default locale keeps the bare URL. */
export function getStaticPaths() {
  return localeParams();
}
const { locale } = Astro.props as { locale: Locale };
/** Answers in the language the page is being read in. */
const LOCAL_FAQS = localizedFaqs(FAQS, locale);

const freeFrom = formatThreshold(site.shipping.freeFrom, locale);

/** Groups in reading order. `related` feeds the link row under each group's title. */
interface Group {
  key: Faq['group'];
  id: string;
  short: string;
  title: string;
  intro: string;
  related: { href: string; label: string }[];
  /** Optional caution shown under the group's answers. */
  note?: string;
}

const GROUPS: Group[] = [
  {
    key: 'product',
    id: 'products',
    short: 'Products',
    title: 'The products',
    intro: 'What pastila actually is, what goes into a bar, and how long a pack keeps in a drawer.',
    related: [
      { href: '/shop/', label: 'Shop all products' },
      { href: '/shop/apple-bars/', label: 'Apple bars' },
      { href: '/shop/pastila/', label: 'Belyov pastila' },
      { href: '/why-pastila/', label: 'Why pastila?' },
    ],
  },
  {
    key: 'nutrition',
    id: 'nutrition',
    short: 'Nutrition',
    title: 'Nutrition & ingredients',
    intro: 'Sugar, gluten, calories, egg white, and who the bars suit. The whole label, explained.',
    note: 'Egg white is a core ingredient in every product. If you have an egg allergy, please read the label before buying. Nutrition values are typical for the recipe; the pack carries the batch label.',
    related: [
      { href: '/why-pastila/', label: 'The honest numbers' },
      { href: '/how-its-made/', label: 'How it is made' },
      { href: '/journal/healthy-snacks-no-added-sugar/', label: 'Reading a snack label' },
    ],
  },
  {
    key: 'orders',
    id: 'orders',
    short: 'Orders',
    title: 'Orders, shipping & returns',
    intro: 'Where we ship, how you pay, and what happens if a parcel arrives dented.',
    related: [
      { href: '/shop/', label: 'Start an order' },
      { href: '/where-to-buy/', label: 'Where to buy in a shop' },
      { href: '/legal/shipping-returns/', label: 'Shipping & returns policy' },
    ],
  },
  {
    key: 'wholesale',
    id: 'wholesale',
    short: 'Wholesale',
    title: 'Wholesale',
    intro: 'For retailers, cafés, offices and distributors. Pallets, private label, and who to write to.',
    related: [
      { href: '/wholesale/', label: 'Wholesale & B2B' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
];

/** Questions are numbered straight through the page, 01 to the last, so the outlined numerals read as an index. */
let running = 0;
const groups = GROUPS.map((g, i) => ({
  ...g,
  n: String(i + 1).padStart(2, '0'),
  items: LOCAL_FAQS.filter((f) => f.group === g.key).map((f) => ({ ...f, n: String(++running).padStart(2, '0') })),
})).filter((g) => g.items.length !== 0);

/** One deeper link under an answer, where a longer page exists. Keyed by question. */
const more: Record<string, { href: string; label: string }> = {
  'What is pastila?': { href: '/why-pastila/', label: 'Read the longer answer' },
  'What is in an Apple Bar?': { href: '/products/apple-bar-35g/', label: 'See the Apple Bar' },
  'How long does it keep and how should I store it?': { href: '/how-its-made/', label: 'How the drying works' },
  'Is there really no added sugar?': { href: '/why-pastila/', label: 'How the sweetness happens' },
  'How many calories?': { href: '/why-pastila/', label: 'Compare it with a chocolate bar' },
  'Where do you ship?': { href: '/legal/shipping-returns/', label: 'Full shipping policy' },
  'How do I pay?': { href: '/shop/', label: 'Start an order request' },
  'Can I return something?': { href: '/legal/shipping-returns/', label: 'Returns in detail' },
  'Where can I buy in a shop?': { href: '/where-to-buy/', label: 'Where to buy' },
  'Do you sell wholesale or private label?': { href: '/wholesale/', label: 'Send a wholesale enquiry' },
};

const reading = [
  { href: '/why-pastila/', title: 'Why pastila?', text: 'The honest numbers against chocolate, granola and dried apple.' },
  { href: '/how-its-made/', title: 'How it’s made', text: 'Twelve hours, eight stages, and why nothing else goes in.' },
  { href: '/journal/', title: 'The journal', text: 'Pastila history, Antonovka apples, how to read a snack label.' },
];

const total = LOCAL_FAQS.length;
const topics = groups.length;
---
<Base
  title="FAQ: apple bars, pastila, shipping & wholesale"
  description="Answers to what people ask about Semers apple bars and Belyov pastila: ingredients, sugar, calories, storage, EU shipping, payment and wholesale."
  canonical="/faq/"
  ogImage="pastila-slices"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'FAQ', href: '/faq/' }]}
  schema={[faqPage(LOCAL_FAQS)]}
>
  <!-- ============================== HERO ============================== -->
  <!-- One enormous line, a giant outlined question mark as the light behind it, then air. -->
  <section class="page-hero container fq-hero" aria-labelledby="page-title">
    <span class="fq-hero__mark" aria-hidden="true" translate="no">?</span>
    <p class="eyebrow">FAQ</p>
    <h1 id="page-title" class="fq-hero__title" data-words>Questions, <em>answered.</em></h1>
    <div class="fq-hero__row">
      <p class="lead">Everything people ask about Semers apple bars and Belyov pastila before their first box: what is in them, whether there is really no added sugar, how long they keep, where we ship and how you pay. Short answers, no small print.</p>
      <div class="fq-hero__aside" data-reveal>
        <p class="fq-hero__count"><span class="fq-hero__big">{total}</span> <span class="fq-hero__count-text">{total} answers in {topics} topics. In a hurry? Jump to <a href="#orders">shipping</a> or <a href="#wholesale">wholesale</a>.</span></p>
        <ul class="ticks fq-hero__ticks">
          <li><Icon name="check" size={18} /> 99% baked Antonovka apples, egg white, no added sugar</li>
          <li><Icon name="check" size={18} /> Free shipping over {freeFrom}; parcels leave Riga in 1–2 business days</li>
          <li><Icon name="check" size={18} /> Keeps 12 months without a fridge</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================== RAIL + QUESTIONS ============================== -->
  <!--
    The set piece: a glass rail of topics that stays put while the questions scroll
    past, each one wearing a giant outlined numeral. The rail is a strip of pills
    under the header on a phone.
  -->
  <div class="container fq">
    <nav class="fq-rail" aria-label="FAQ topics">
      <div class="fq-rail__glass">
        <p class="fq-rail__label">Topics</p>
        <ol class="fq-rail__list">
          {groups.map((g) => (
            <li>
              <a href={`#${g.id}`} data-rail-link={g.id}>
                <span class="fq-rail__n" aria-hidden="true">{g.n}</span>
                <span class="fq-rail__t">{g.short}</span>
                <span class="fq-rail__c">{g.items.length}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="fq-rail__ask" href="#ask"><span class="fq-rail__t">Still curious?</span><Icon name="arrow" size={16} /></a>
      </div>
    </nav>

    <div class="fq-main">
      {groups.map((g) => (
        <section class="fq-group" id={g.id} aria-labelledby={`${g.id}-title`} data-rail-target={g.id}>
          <header class="fq-group__head" data-reveal>
            <p class="eyebrow">{g.n} · {g.short}</p>
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            <p class="fq-group__intro">{g.intro}</p>
            <ul class="fq-group__links">
              {g.related.map((r) => (
                <li><a class="link" href={r.href}>{r.label}</a></li>
              ))}
            </ul>
          </header>
          <div class="fq-acc" data-reveal>
            {g.items.map((f, i) => (
              <details open={i === 0}>
                <summary>
                  <span class="fq-n" aria-hidden="true">{f.n}</span>
                  <h3 class="fq-q">{f.q}</h3>
                  <span class="fq-plus" aria-hidden="true"></span>
                </summary>
                <div class="fq-a">
                  <p>{f.a}</p>
                  {more[f.q] && <p class="fq-more"><a class="link" href={more[f.q].href}>{more[f.q].label}</a></p>}
                </div>
              </details>
            ))}
            {g.note && <p class="notice fq-note">{g.note}</p>}
          </div>
        </section>
      ))}
    </div>
  </div>

  <!-- ============================== STILL CURIOUS ============================== -->
  <section class="section container fq-end" id="ask" aria-labelledby="curious-title">
    <div class="cta-band fq-cta" data-reveal>
      <p class="eyebrow">Still curious?</p>
      <h2 id="curious-title">Ask us the question that is not here yet.</h2>
      <p>We read every message ourselves, from Riga. Ingredient details, a batch label, a delivery date, a box for someone hard to buy for. Write, and we will write back.</p>
      <div class="cluster mt-2">
        <a class="btn btn--paper" href="/contact/">Write to us <Icon name="arrow" size={18} class="arrow" /></a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
      </div>
      <p class="small fq-cta__shop">Already convinced? <a href="/shop/">Go straight to the shop</a>.</p>
      <span class="fq-cta__mark" aria-hidden="true" translate="no">?</span>
    </div>

    <div class="fq-reading" data-stagger aria-labelledby="reading-title">
      <div class="fq-reading__head">
        <p class="eyebrow">Popular reading</p>
        <h2 id="reading-title">The longer answers.</h2>
      </div>
      {reading.map((r) => (
        <a class="fq-reading__item" href={r.href}>
          <span class="fq-reading__t">{r.title}</span>
          <span class="fq-reading__d">{r.text}</span>
          <Icon name="arrow" size={18} class="fq-reading__arrow" />
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  /* The rail lights the topic that is under the reader. Purely cosmetic; the links work without it. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
  const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-rail-target]'));
  if (links.length && targets.length && 'IntersectionObserver' in window) {
    const set = (id: string) => links.forEach((l) => (l.dataset.railLink === id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit) set((hit.target as HTMLElement).dataset.railTarget || '');
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.1, 0.5] },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* ------------------------------------------------------------ hero */
  .fq-hero { position: relative; overflow: clip; padding-bottom: clamp(2rem, 5vw, 4rem); }
  .fq-hero__mark { position: absolute; right: -0.05em; top: -0.12em; z-index: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(16rem, 42vw, 40rem); line-height: 1; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px rgb(243 233 214 / 0.16); pointer-events: none; user-select: none; font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .fq-hero > :not(.fq-hero__mark) { position: relative; z-index: 1; }
  .fq-hero__title { font-size: var(--fs-hero); line-height: 0.9; letter-spacing: -0.045em; max-width: 9ch; color: var(--cream-0); font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1; }
  .fq-hero__title em { display: block; font-style: italic; font-weight: 400; color: var(--accent); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .fq-hero__row { display: grid; gap: 2rem; margin-top: clamp(2rem, 5vw, 3.5rem); align-items: end; }
  @media (min-width: 56rem) { .fq-hero__row { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 6vw, 6rem); } }
  .fq-hero__row .lead { margin: 0; }
  .fq-hero__aside { display: grid; gap: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .fq-hero__count { display: flex; gap: 1rem; align-items: baseline; margin: 0; color: var(--fg-2); font-size: var(--fs-sm); max-width: 34ch; }
  .fq-hero__big { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-3xl); line-height: 0.85; letter-spacing: -0.04em; color: var(--cream-0); font-variant-numeric: tabular-nums; flex: none; }
  .fq-hero__ticks { font-size: var(--fs-sm); gap: 0.5rem; }

  /* ------------------------------------------------------------ rail + main */
  .fq { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  .fq-rail, .fq-main { min-width: 0; }
  @media (min-width: 60rem) { .fq { grid-template-columns: 15rem minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); } }

  .fq-rail { position: sticky; z-index: 5; }
  .fq-rail__glass { background: rgb(11 18 14 / 0.62); backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .fq-rail__label { margin: 0; font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-3); }
  .fq-rail__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .fq-rail__list a, .fq-rail__ask { display: flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; text-decoration: none; color: var(--fg-2); transition: color var(--dur-fast); }
  .fq-rail__t { font-variant-caps: all-small-caps; letter-spacing: 0.14em; font-weight: 600; font-size: var(--fs-md); line-height: 1; }
  .fq-rail__n { font-family: var(--font-display); font-size: var(--fs-xs); letter-spacing: 0.06em; color: var(--fg-3); font-variant-numeric: tabular-nums; transition: color var(--dur-fast); }
  .fq-rail__c { margin-left: auto; font-size: var(--fs-xs); color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .fq-rail__list a:hover, .fq-rail__ask:hover { color: var(--cream-0); }
  .fq-rail__list a[aria-current="true"] { color: var(--cream-0); }
  .fq-rail__list a[aria-current="true"] .fq-rail__n { color: var(--accent); text-shadow: 0 0 12px var(--accent); }
  .fq-rail__ask { color: var(--accent-ink); }
  .fq-rail__ask :global(svg) { transition: transform var(--dur-fast) var(--ease-out); }
  .fq-rail__ask:hover :global(svg) { transform: translateX(3px); }

  /* Wide: a card that stays put. */
  @media (min-width: 60rem) {
    .fq-rail { top: 7rem; }
    .fq-rail__glass { padding: 1.25rem 1.35rem 0.75rem; }
    .fq-rail__label { margin-bottom: 0.6rem; }
    .fq-rail__list a { padding-inline: 0.15rem; border-top: 1px solid var(--line); }
    .fq-rail__list li:first-child a { border-top: 0; }
    .fq-rail__list a[aria-current="true"] { box-shadow: inset 2px 0 0 var(--accent); padding-left: 0.75rem; }
    .fq-rail__ask { margin-top: 0.4rem; padding: 0.35rem 0.15rem 0; border-top: 1px solid var(--line); }
  }
  /* Narrow: a strip of pills under the header that bleeds to the screen edges and scrolls sideways inside itself. */
  @media (max-width: 59.99rem) {
    .fq-rail { top: 6.3rem; margin-inline: calc(-1 * var(--gutter)); }
    .fq-rail__glass { display: flex; align-items: center; gap: 0.5rem; border-radius: 0; border-inline: 0; padding: 0.6rem var(--gutter); overflow-x: auto; scrollbar-width: none; scroll-padding-inline: var(--gutter); }
    .fq-rail__glass::-webkit-scrollbar { display: none; }
    .fq-rail__label { display: none; }
    .fq-rail__list { display: flex; gap: 0.5rem; flex: none; }
    .fq-rail__list li { flex: none; }
    .fq-rail__list a, .fq-rail__ask { padding: 0.55rem 0.95rem; border: 1px solid rgb(243 233 214 / 0.22); border-radius: var(--r-pill); white-space: nowrap; }
    .fq-rail__list a[aria-current="true"] { background: var(--cream-1); color: var(--night-900); border-color: var(--cream-1); }
    .fq-rail__list a[aria-current="true"] .fq-rail__n, .fq-rail__list a[aria-current="true"] .fq-rail__c { color: var(--night-900); text-shadow: none; }
    .fq-rail__c { margin-left: 0; }
    .fq-rail__ask { flex: none; margin-left: 0.25rem; }
  }
  @media (max-width: 40rem) { .fq-rail { top: 7.45rem; } }

  /* groups */
  .fq-group { scroll-margin-top: 7.5rem; padding-block: clamp(2.5rem, 6vw, 5rem); }
  .fq-group + .fq-group { border-top: 1px solid var(--line); }
  .fq-group:first-child { padding-top: 0.5rem; }
  @media (max-width: 59.99rem) { .fq-group { scroll-margin-top: 11.5rem; } }
  .fq-group__head { display: grid; gap: 0.9rem; justify-items: start; margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .fq-group__head h2 { font-size: var(--fs-3xl); max-width: 14ch; line-height: 0.98; }
  .fq-group__intro { margin: 0; color: var(--fg-2); max-width: 52ch; font-size: var(--fs-lg); }
  .fq-group__links { list-style: none; margin: 0.35rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; font-size: var(--fs-sm); }

  /* accordion: display type, giant outlined numerals, answers in a 60ch measure */
  .fq-acc { --ncol: clamp(3.6rem, 6.5vw, 6.25rem); border-top: 1px solid var(--line); }
  .fq-acc details { border-bottom: 1px solid var(--line); }
  .fq-acc summary { display: grid; grid-template-columns: var(--ncol) minmax(0, 1fr) 2.25rem; align-items: center; column-gap: 0.75rem; padding: 1.1rem 0; cursor: pointer; list-style: none; min-height: 3.5rem; }
  .fq-acc summary::-webkit-details-marker { display: none; }
  .fq-n { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.6rem, 4.6vw, 4.5rem); line-height: 0.8; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px var(--cream-3); font-variant-numeric: tabular-nums; transition: -webkit-text-stroke-color var(--dur), text-shadow var(--dur); font-variation-settings: 'opsz' 144, 'SOFT' 60; }
  .fq-q { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.35rem, 1.05rem + 1.3vw, 2.25rem); line-height: 1.08; letter-spacing: -0.025em; color: var(--cream-0); text-wrap: balance; transition: color var(--dur-fast); font-variation-settings: 'opsz' 96, 'SOFT' 40; }
  .fq-plus { position: relative; width: 2.25rem; height: 2.25rem; border-radius: 50%; border: 1px solid rgb(243 233 214 / 0.25); justify-self: end; transition: transform var(--dur) var(--ease-out), background var(--dur-fast), border-color var(--dur-fast); }
  .fq-plus::before, .fq-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.9rem; height: 1px; background: var(--cream-1); transform: translate(-50%, -50%); transition: background var(--dur-fast); }
  .fq-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .fq-acc summary:hover .fq-q { color: var(--accent-ink); }
  .fq-acc summary:hover .fq-plus { border-color: var(--cream-1); }
  .fq-acc details[open] .fq-n { -webkit-text-stroke-color: var(--accent); text-shadow: 0 0 24px rgb(255 90 60 / 0.35); }
  .fq-acc details[open] .fq-plus { transform: rotate(45deg); background: var(--cream-1); border-color: var(--cream-1); }
  .fq-acc details[open] .fq-plus::before, .fq-acc details[open] .fq-plus::after { background: var(--night-900); }
  .fq-a { padding: 0.25rem 0 1.75rem calc(var(--ncol) + 0.75rem); max-width: calc(60ch + var(--ncol) + 0.75rem); color: var(--fg-2); font-size: var(--fs-lg); line-height: 1.6; }
  .fq-a p { margin-bottom: 0.6em; }
  .fq-more { font-size: var(--fs-sm); margin-top: 0.4rem; }
  .fq-note { margin-top: 1.5rem; max-width: 66ch; }
  @media (max-width: 40rem) {
    .fq-acc { --ncol: 3rem; }
    .fq-acc summary { column-gap: 0.6rem; grid-template-columns: var(--ncol) minmax(0, 1fr) 2rem; }
    .fq-n { font-size: 2.4rem; }
    .fq-plus { width: 2rem; height: 2rem; }
    .fq-a { padding-left: 0; font-size: var(--fs-md); }
  }
  @media (prefers-reduced-motion: reduce) { .fq-plus, .fq-n { transition: none; } }

  /* ------------------------------------------------------------ the end: one lit room, then the longer answers */
  .fq-end { display: grid; gap: clamp(2rem, 5vw, 4rem); scroll-margin-top: 6rem; }
  .fq-cta { isolation: isolate; }
  .fq-cta > * { position: relative; z-index: 1; }
  .fq-cta__mark { position: absolute; z-index: 0; right: -0.06em; bottom: -0.28em; font-family: var(--font-display); font-weight: 400; font-size: clamp(14rem, 30vw, 26rem); line-height: 1; color: transparent; -webkit-text-stroke: 1px rgb(27 22 18 / 0.16); pointer-events: none; user-select: none; font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .fq-cta .btn--ghost { --btn-fg: var(--night-900); border-color: rgb(27 22 18 / 0.35); }
  .fq-cta .btn--ghost:hover { background: var(--night-900); color: var(--cream-0); }
  .fq-cta__shop { color: var(--ink-500); margin-top: 0.5rem; }
  .fq-cta__shop a { color: var(--night-900); }

  .fq-reading { display: grid; gap: 0; border-top: 1px solid var(--line); }
  @media (min-width: 56rem) { .fq-reading { grid-template-columns: 1.1fr repeat(3, 1fr); border-top: 0; } }
  .fq-reading__head { display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem 1.5rem 1.5rem 0; }
