---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { im, SIZES } from '~/data/images';
import { PRODUCTS, collectionByKey, formatThreshold } from '~/data/products';
import { site } from '~/data/site';

import { localeParams } from '~/i18n/config';
import type { Locale } from '~/i18n/config';

/** One page per language; the default locale keeps the bare URL. */
export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };

const freeFrom = formatThreshold(site.shipping.freeFrom, locale);

/** Countries with Semers on a shelf, derived from the retailer list (Latvia + export markets). */
const countries = [...new Set(site.retailers.map((r) => r.country))];
const exportCountries = countries.filter((c) => c !== site.country);
const countryCount = countries.length;
const exportLine = exportCountries.join(', ');

/**
 * Qualitative milestones, told in order; none of them carries a year.
 * Each stop is set as one enormous outlined word on the wall, with a photograph
 * drifting under it; `long` keys are set a size smaller so they stay on one line.
 */
const milestones = [
  {
    key: 'Riga',
    image: 'hero-bars',
    title: 'A bakery in Riga',
    text: 'Where Semers Group makes its App’Lite snacks from baked apples and egg white.',
  },
  {
    key: 'Maxima & Barbora',
    image: 'hero-wide',
    title: 'On shelves across Latvia',
    text: 'App’Lite bars reach supermarket shelves and the online grocery basket at home.',
  },
  {
    key: 'Europe',
    image: 'lifestyle-desk',
    title: exportLine,
    text: 'Cases leave Riga for specialty and online stores in five more countries.',
  },
  {
    key: 'Today',
    image: 'bar-12-pack',
    title: 'This shop',
    text: 'Ordered here, packed in Riga, on its way in one to two business days.',
  },
].map((m) => ({ ...m, long: m.key.length > 6 }));

/** Everything the shop sells, one entry per product, in the order the range is told above. */
const shapes = [
  { slug: 'apple-bar-35g', label: 'The bar' },
  { slug: 'apple-meringue-35g', label: 'The meringue' },
  { slug: 'applite-baked-apple-dessert-50g', label: 'The dessert' },
  { slug: 'applite-baked-apple-dessert-500g', label: 'The carton' },
  { slug: 'flourless-apple-bar-50g', label: 'The flourless cake' },
].flatMap((s) => {
  const p = PRODUCTS.find((x) => x.slug === s.slug);
  return p ? [{ ...s, product: p }] : [];
});

/**
 * The two brands printed on the packs. They are listed here rather than read from the
 * site's brand list so that this page can only ever explain a brand it has a note for;
 * a brand with no products in the catalogue drops out instead of showing an empty row.
 */
const LINE_NOTES: Record<string, string> = {
  "App'Lite": 'Baked apples and egg white as a bar, a meringue and a dessert. The bar and the meringue come in Classic and Berry Mix, the 50 g dessert in Classic, Cinnamon and Berry Mix.',
  "Blum Baker's": 'A flourless apple cake, 50 g, in Classic, Cinnamon, Blueberry and Cranberry: apples and egg white, with the fruit or spice in the name. We sell it alongside our own range.',
};
const lines = Object.keys(LINE_NOTES).flatMap((brand) => {
  const products = PRODUCTS.filter((p) => p.brand === brand && p.collection !== 'gift-sets').sort((a, b) => a.order - b.order);
  const first = products[0];
  if (!first) return [];
  const col = collectionByKey(first.collection);
  return [{ brand, products, href: col ? `/shop/${col.key}/` : '/shop/', colName: col ? col.name : 'Shop', note: LINE_NOTES[brand] }];
});

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Our story: baked-apple snacks made in Riga"
  description="Semers Group makes App’Lite snacks in Riga from baked apples and egg white, and sells Blum Baker’s flourless apple cakes. No added sugar, no flour."
  canonical="/story/"
  ogImage="hero-bars"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Our story', href: '/story/' }]}
>
  <!-- ============================== HERO: one enormous line, then air ============================== -->
  <section class="page-hero container story-hero" aria-labelledby="page-title">
    <p class="eyebrow">Our story · {site.locality}, {site.country}</p>
    <h1 id="page-title" class="story-hero__title" data-words>Baked apples, egg white and a bakery in <em>Riga</em>.</h1>
    <div class="story-hero__row">
      <div class="story-hero__copy" data-reveal>
        <p class="lead">Semers makes baked-apple snacks in Riga under the App’Lite name: baked apples and egg white, with berries or cinnamon in some flavours, no added sugar and no flour. The shop also sells Blum Baker’s flourless apple cakes. This page is what we make, what we sell, and how.</p>
        <div class="cluster story-hero__cta">
          <a class="btn btn--lg" href="/shop/">Shop the range <Icon name="arrow" size={20} class="arrow" /></a>
          <a class="btn btn--lg btn--ghost" href="/how-its-made/">How it’s made</a>
        </div>
      </div>
      <div class="story-hero__media" data-reveal>
        <div class="pf story-hero__frame">
          <img src={im('hero-bars').src} srcset={im('hero-bars').srcset} sizes={im('hero-bars').srcset && SIZES.half} alt={im('hero-bars').alt} width={im('hero-bars').width} height={im('hero-bars').height} loading="eager" fetchpriority="high" decoding="async" data-parallax="0.12" />
        </div>
        <div class="story-hero__note"><strong>2</strong><span>ingredients in every Classic: apples and egg white.</span></div>
      </div>
    </div>
    <div class="stats story-stats" data-stagger>
      <div class="stat"><strong data-count="2">2</strong><span>ingredients in a Classic Apple Bar: baked apples, egg white</span></div>
      <div class="stat"><strong data-count="99">99%</strong><span>baked apples, printed on the front of the Apple Bar</span></div>
      <div class="stat"><strong data-count={lines.length}>{lines.length}</strong><span>brands in the shop: App’Lite and Blum Baker’s</span></div>
      <div class="stat"><strong data-count={countryCount}>{countryCount}</strong><span>countries with Semers on a shelf</span></div>
    </div>
  </section>

  <!-- ============================== THE RECIPE ============================== -->
  <section class="section container" aria-labelledby="recipe-title">
    <div class="split">
      <div class="pf pf--1x1 pf--honey" data-reveal>
        <img src={im('process-oven').src} srcset={im('process-oven').srcset} sizes={im('process-oven').srcset && SIZES.third} alt={im('process-oven').alt} width={im('process-oven').width} height={im('process-oven').height} loading="lazy" decoding="async" data-parallax="0.15" />
      </div>
      <div data-reveal>
        <p class="eyebrow">The recipe</p>
        <h2 id="recipe-title" data-words>Baked apples and egg white. That is the list.</h2>
        <div class="prose mt-4">
          <p>The apples are baked, then whipped with egg white until the purée holds air. It is spread thin and dried slowly, in layers. Berries or cinnamon go in for some flavours. Sugar and flour do not.</p>
        </div>
        <ul class="cluster recipe" aria-label="The recipe">
          <li class="chip"><Icon name="apple" size={14} /> Baked apples</li>
          <li class="chip"><Icon name="egg" size={14} /> Egg white</li>
          <li class="chip"><Icon name="clock" size={14} /> Thin layers, slow drying</li>
        </ul>
        <div class="cluster mt-4">
          <a class="btn" href="/how-its-made/">How it’s made</a>
          <a class="link" href="/journal/what-is-pastila/">What pastila is, in full</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== THE RANGE ============================== -->
  <section class="section container" aria-labelledby="loaf-title">
    <div class="loaf">
      <div data-reveal>
        <p class="eyebrow">The range</p>
        <h2 id="loaf-title" data-words>Apples and egg white, five ways.</h2>
        <div class="prose mt-4">
          <p>App’Lite is the 35 g Apple Bar, the 35 g Apple Meringue and the 50 g Baked Apple Dessert. The shop also sells the Classic Apple Dessert in a 500 g carton, and Blum Baker’s 50 g flourless apple cake. Every one of them lists apples and egg white as its ingredients, with berries or cinnamon in some flavours.</p>
          <p>This shop came last. Until now you found us at Maxima, on Barbora and in stores across Europe; now the same cases can leave Riga for your door.</p>
        </div>
        <ul class="shapes" aria-label="What we sell">
          {shapes.map((s, i) => (
            <li>
              <a href={`/products/${s.product.slug}/`}>
                <span class="shapes__n" aria-hidden="true">{pad(i + 1)}</span>
                <strong>{s.label}</strong>
                <span>{s.product.name} · {s.product.weightGrams} g</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="duo" data-stagger>
        <figure>
          <div class="pf pf--4x5">
            <img src={im('orchard-picking').src} srcset={im('orchard-picking').srcset} sizes={im('orchard-picking').srcset && SIZES.third} alt={im('orchard-picking').alt} width={im('orchard-picking').width} height={im('orchard-picking').height} loading="lazy" decoding="async" data-parallax="0.12" />
          </div>
          <figcaption>It starts with apples.</figcaption>
        </figure>
        <figure>
          <div class="pf pf--4x5">
            <img src={im('retail-boxes').src} srcset={im('retail-boxes').srcset} sizes={im('retail-boxes').srcset && SIZES.third} alt={im('retail-boxes').alt} width={im('retail-boxes').width} height={im('retail-boxes').height} loading="lazy" decoding="async" data-parallax="0.2" />
          </div>
          <figcaption>It ends as cases packed in Riga, on their way to a shop shelf or to you.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================== THE WALL: four stops as enormous outlined words ============================== -->
  <!--
    The timeline is a wall. Each stop is set as one huge outlined word,
    with its photograph drifting up over the lower half and a short paragraph
    beside it; sides alternate. The stop nearest the middle of the screen is
    lit in the accent (a class the script toggles; without it the wall is
    simply cream on the night).
  -->
  <section class="section wall" aria-labelledby="journey-title">
    <div class="container">
      <div class="wall__head">
        <p class="eyebrow">The journey</p>
        <h2 id="journey-title" data-words>Four stops between Riga and your kitchen drawer.</h2>
        <p class="muted wall__note">Told in the order they happened.</p>
      </div>
      <ol class="wall__list">
        {milestones.map((m, i) => (
          <li class={`wall__stop ${i % 2 ? 'wall__stop--rev' : ''} ${m.long ? 'wall__stop--long' : ''}`} data-lit>
            <span class={`wall__year ${m.long ? 'wall__year--long' : ''}`}>{m.key}</span>
            <div class="wall__media" data-reveal>
              <div class="wall__frame">
                <img src={im(m.image).src} srcset={im(m.image).srcset} sizes={im(m.image).srcset && SIZES.half} alt={im(m.image).alt} width={im(m.image).width} height={im(m.image).height} loading="lazy" decoding="async" data-parallax="0.2" />
              </div>
            </div>
            <div class="wall__text" data-reveal>
              <span class="wall__n" aria-hidden="true">{pad(i + 1)} / {pad(milestones.length)}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================== THE FAMILY, FULL BLEED, AND THE ONE SENTENCE ============================== -->
  <section class="fam" aria-labelledby="quote-title">
    <div class="fam__media">
      <img src={im('family-kitchen').src} srcset={im('family-kitchen').srcset} sizes="100vw" alt={im('family-kitchen').alt} width={im('family-kitchen').width} height={im('family-kitchen').height} loading="lazy" decoding="async" data-parallax="0.2" />
    </div>
    <div class="container fam__say" data-reveal>
      <p class="eyebrow" id="quote-title">In one sentence</p>
      <p class="fam__quote">Baked apples and egg white, with no added sugar and no flour, made in Riga.</p>
      <p class="fam__by">Semers is made by {site.brand.legalName}, {site.locality}, {site.country}.</p>
    </div>
  </section>

  <!-- ============================== WHAT WE BELIEVE: a ledger ============================== -->
  <!-- One row per rule: the numeral outlined in the margin, the rule as a display line, the reason beside it, a hairline between rows. -->
  <section class="section container" aria-labelledby="believe-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">What we believe</p>
        <h2 id="believe-title" data-words>Three things we will not argue about.</h2>
      </div>
      <p class="muted" style="max-width:36ch">Not a mission statement. Three rules the recipe taught us, and the reasons we keep them.</p>
    </div>
    <ol class="creed" data-stagger>
      <li>
        <span class="creed__n" aria-hidden="true">01</span>
        <h3>Two ingredients</h3>
        <p>Baked apples and egg white. Berries or cinnamon join them in some flavours, because they are food. Sugar and flour do not.</p>
      </li>
      <li>
        <span class="creed__n" aria-hidden="true">02</span>
        <h3>Honest labels</h3>
        <p>The front of the pack says what the back of the pack says. No “natural flavouring”, no E-numbers, no claims we cannot stand behind. “No added sugar” means exactly that: none is added, and the apples’ own sugars are still there, as the label says.</p>
      </li>
      <li>
        <span class="creed__n" aria-hidden="true">03</span>
        <h3>Apples first</h3>
        <p>Everything we make starts from baked apples. When the apple is right, the recipe has nothing to fix, and most of our work is keeping it that way.</p>
      </li>
    </ol>
  </section>

  <!-- ============================== THE BRANDS ============================== -->
  <section class="section band" aria-labelledby="lines-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Two names on the packs</p>
          <h2 id="lines-title" data-words>The names on the packs, explained.</h2>
        </div>
        <a class="link" href="/shop/">Shop all products</a>
      </div>
      <ul class="lines" data-stagger>
        {lines.map((l) => (
          <li class="line">
            <h3>{l.brand}</h3>
            <div>
              <p>{l.note}</p>
              <div class="line__products">
                {l.products.map((p) => (
                  <a class="chip" href={`/products/${p.slug}/`}>{p.name} · {p.weightGrams} g</a>
                ))}
                <a class="chip chip--solid" href={l.href}>All {l.colName.toLowerCase()}</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="small muted mt-4">Gift sets, tasting boxes and the box of twelve live under <a href="/shop/gift-sets/">gift sets</a>. Questions about ordering are answered in the <a href="/faq/">FAQ</a>, or <a href="/contact/">write to us</a>.</p>
    </div>
  </section>

  <!-- ============================== CTA: the one lit room ============================== -->
  <section class="section container cta-sec" aria-labelledby="cta-title">
    <div class="cta-band" data-reveal>
      <p class="eyebrow">Taste the story</p>
      <h2 id="cta-title">Start with a bar, then work through the range.</h2>
      <p>Parcels leave Riga in 1–2 business days and ship across the EU; orders over {freeFrom} ship free. Retailer, café or office? We pack cases as happily as parcels.</p>
      <div class="cluster mt-2">
        <a class="btn btn--paper" href="/shop/">Shop all products <Icon name="arrow" size={18} class="arrow" /></a>
        <a class="btn btn--ghost" href="/wholesale/">Wholesale &amp; B2B</a>
        <a class="link cta-band__link" href="/where-to-buy/">Where to buy</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { lit } from '~/scripts/motion';

  /*
   * The wall: the stop nearest the middle of the screen is lit. With reduced
   * motion, or with no JavaScript, the wall is complete as it is, every stop
   * outlined in cream. One IntersectionObserver; it used to be ScrollTrigger.
   */
  lit('[data-lit]', 38);
</script>

<style>
  /* ---------------------------------------------------------- parallax frames */
  /* A photograph that drifts needs to be taller than its window, or the drift shows the ground behind it. */
  .pf { position: relative; overflow: clip; border-radius: var(--r-xl); background: var(--bg-sunken); box-shadow: var(--shadow-2); }
  .pf img { position: absolute; left: 0; right: 0; top: -12%; width: 100%; height: 124%; object-fit: cover; }
  .pf--1x1 { aspect-ratio: 1; }
  .pf--4x5 { aspect-ratio: 4 / 5; }
  .pf--honey { box-shadow: var(--shadow-2), var(--glow-honey); }

  /* ---------------------------------------------------------- hero */
  .story-hero { padding-bottom: clamp(2rem, 5vw, 4rem); }
  .story-hero .story-hero__title { font-size: clamp(3rem, 2rem + 6.5vw, 8.5rem); line-height: 0.92; letter-spacing: -0.04em; max-width: 16ch; }
  .story-hero__title em { font-style: italic; font-weight: 400; color: var(--accent-display); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .story-hero__row { display: grid; gap: clamp(2rem, 5vw, 4rem); margin-top: clamp(2rem, 5vw, 3.5rem); align-items: end; }
  @media (min-width: 56rem) { .story-hero__row { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } }
  .story-hero__copy { max-width: 40rem; }
  .story-hero__cta { margin-top: var(--sp-6); }
  .story-hero__media { position: relative; }
  .story-hero__frame { aspect-ratio: 3 / 2; box-shadow: var(--shadow-3); }
  @media (min-width: 56rem) { .story-hero__frame { aspect-ratio: 16 / 10; } }
  .story-hero__note { position: absolute; left: clamp(0.75rem, 3vw, 2rem); bottom: clamp(0.75rem, 3vw, 2rem); max-width: 16rem; display: grid; gap: 0.25rem; padding: 1rem 1.2rem; border-radius: var(--r-md); background: rgb(251 249 244 / 0.72); backdrop-filter: blur(14px); border: 1px solid var(--line); font-size: var(--fs-sm); line-height: 1.3; color: var(--cream-2); }
  @supports (-webkit-backdrop-filter: none) { .story-hero__note { -webkit-backdrop-filter: blur(14px); } }
  .story-hero__note strong { font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 500; letter-spacing: -0.03em; line-height: 1; color: var(--honey-ink); }
  .story-stats { margin-top: clamp(2.5rem, 6vw, 4.5rem); padding-top: var(--sp-5); border-top: 1px solid var(--line); }

  /* ---------------------------------------------------------- the recipe */
  .recipe { list-style: none; margin: var(--sp-5) 0 0; padding: 0; gap: 0.5rem; }
  .recipe .chip :global(svg) { color: var(--leaf-500); }

  /* ---------------------------------------------------------- the range */
  .loaf { display: grid; gap: var(--sp-6); }
  @media (min-width: 56rem) { .loaf { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; } }
  .shapes { list-style: none; margin: var(--sp-5) 0 0; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shapes a { position: relative; display: grid; gap: 0.1rem; height: 100%; padding: 1rem 1.1rem 1rem; border-radius: var(--r-md); background: var(--bg-raised); box-shadow: var(--shadow-1); text-decoration: none; transition: transform var(--dur) var(--ease-expo), box-shadow var(--dur); }
  .shapes a:hover { transform: translateY(-3px); box-shadow: var(--shadow-2), var(--glow-honey); }
  .shapes__n { position: absolute; right: 0.8rem; top: 0.5rem; font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 400; color: transparent; -webkit-text-stroke: 1px var(--cream-3); letter-spacing: -0.04em; }
  .shapes strong { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 500; letter-spacing: -0.01em; color: var(--cream-0); }
  .shapes span:not(.shapes__n) { font-size: var(--fs-xs); color: var(--fg-3); }
  @media (max-width: 26rem) { .shapes { grid-template-columns: 1fr; } }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); align-items: end; }
  .duo figure { margin: 0; display: grid; gap: var(--sp-3); }
  .duo figure:first-child { padding-bottom: clamp(2rem, 6vw, 4rem); }
  .duo figcaption { font-size: var(--fs-sm); color: var(--fg-3); max-width: 24ch; }
  .duo .pf { border-radius: var(--r-lg); }

  /* ---------------------------------------------------------- the wall */
  .wall { overflow: clip; padding-bottom: 0; }
  .wall__head { display: grid; gap: var(--sp-4); max-width: 60rem; margin-bottom: clamp(2rem, 6vw, 5rem); }
  .wall__head h2 { max-width: 16ch; }
  .wall__note { max-width: 44ch; }
  .wall__list { list-style: none; margin: 0; padding: 0; }
  /* `--overlap` is the share of the word's height the photograph is allowed to cover; most of every glyph stays in view. */
  .wall__stop { --year: clamp(5.5rem, 24vw, 15rem); --overlap: 0.12; position: relative; display: grid; gap: var(--sp-5); padding-block: clamp(2.5rem, 6vw, 5rem); border-top: 1px solid var(--line); }
  .wall__year { display: block; margin: 0; font-family: var(--font-display); font-size: var(--year); font-weight: 400; line-height: 0.85; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px var(--cream-3); overflow-wrap: break-word; font-variation-settings: 'opsz' 144, 'SOFT' 30; transition: -webkit-text-stroke-color var(--dur-slow) var(--ease-out), filter var(--dur-slow) var(--ease-out); }
  .wall__stop--long { --year: clamp(4rem, 18vw, 9.5rem); }
  .wall__stop:first-child { --year: clamp(6rem, 26vw, 19rem); }
  .wall__stop.is-lit .wall__year { -webkit-text-stroke-color: var(--accent); filter: none; }
  .wall__media { position: relative; z-index: 1; margin-top: calc(var(--year) * -1 * var(--overlap)); }
  .wall__frame { position: relative; aspect-ratio: 4 / 3; overflow: clip; border-radius: var(--r-xl); background: var(--bg-sunken); box-shadow: var(--shadow-3); }
  .wall__frame img { position: absolute; left: 0; right: 0; top: -12%; width: 100%; height: 124%; object-fit: cover; }
  .wall__text { display: grid; gap: 0.6rem; align-content: end; max-width: 42ch; }
  .wall__n { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.16em; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .wall__text h3 { font-size: var(--fs-2xl); letter-spacing: -0.02em; text-wrap: balance; }
  .wall__text p { margin: 0; color: var(--fg-2); font-size: var(--fs-lg); }
  @media (min-width: 56rem) {
    .wall__stop { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(2rem, 6vw, 6rem); align-items: end; }
    .wall__year { grid-column: 1 / -1; }
    .wall__stop { --overlap: 0.2; }
    .wall__stop--long { --overlap: 0.14; }
    .wall__media { grid-column: 1; grid-row: 2; max-width: 36rem; width: 100%; }
    .wall__text { grid-column: 2; grid-row: 2; padding-bottom: 1.25rem; }
    .wall__stop--rev .wall__year { text-align: right; }
    .wall__stop--rev .wall__media { grid-column: 2; justify-self: end; }
    .wall__stop--rev .wall__text { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .wall__year { transition: none; } }

  /* ---------------------------------------------------------- the family, full bleed */
  .fam { position: relative; isolation: isolate; overflow: clip; min-height: min(92svh, 56rem); display: grid; align-items: center; background: var(--night-950); }
