---
import Base from '~/layouts/Base.astro';
import GoverningLanguage from '~/components/GoverningLanguage.astro';
import Icon from '~/components/Icon.astro';
import { im, SIZES } from '~/data/images';
import { site } from '~/data/site';
import { formatPrice, formatThreshold } from '~/data/products';
import { originOf } from '~/lib/origin';

import { localeParams } from '~/i18n/config';
import type { Locale } from '~/i18n/config';

/** One page per language; the default locale keeps the bare URL. */
export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };

const origin = originOf(Astro.site);
const path = '/legal/terms/';
const updated = 'September 2026';
const title = 'Terms and conditions of sale';
const description =
  'Terms of sale for the Semers web shop: ordering and payment, delivery, the 14-day right of withdrawal, damaged goods, allergens and Latvian consumer law.';

const freeFrom = formatThreshold(site.shipping.freeFrom, locale);
/** Flat Baltic rate; mirrors data-shipping="3.9" on the checkout page. */
const flatRate = formatPrice(3.9, locale);

const band = im('packshot-classic');

const legalNav = [
  { href: '/legal/privacy/', label: 'Privacy policy' },
  { href: '/legal/terms/', label: 'Terms of sale' },
  { href: '/legal/shipping-returns/', label: 'Shipping & returns' },
].map((l) => ({ ...l, active: l.href === path }));

const sections = [
  { id: 'summary', label: 'In plain words' },
  { id: 'parties', label: 'Who we are and what these terms cover' },
  { id: 'products', label: 'Products and images' },
  { id: 'prices', label: 'Prices' },
  { id: 'ordering', label: 'How ordering works' },
  { id: 'delivery', label: 'Delivery' },
  { id: 'withdrawal', label: 'Right of withdrawal' },
  { id: 'defects', label: 'Damaged or defective goods' },
  { id: 'allergens', label: 'Allergens and food information' },
  { id: 'liability', label: 'Liability' },
  { id: 'law', label: 'Governing law and disputes' },
  { id: 'changes', label: 'Changes to these terms' },
  { id: 'contact', label: 'Contact' },
];

const webPage = {
  '@type': 'WebPage',
  '@id': `${origin}${path}#webpage`,
  url: `${origin}${path}`,
  name: 'Terms and conditions of sale',
  description,
  inLanguage: 'en',
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#org` },
  dateModified: '2026-09-01',
};
---
<Base
  title={title}
  description={description}
  canonical={path}
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Terms of sale', href: path }]}
  schema={[webPage]}
>
  <!-- ============================== HERO ============================== -->
  <section class="legal-hero container" aria-labelledby="page-title">
    <p class="eyebrow">Legal · {site.brand.legalName}</p>
    <h1 id="page-title" class="legal-title" data-words>Terms of sale, <em>in plain language.</em></h1>
    <div class="legal-hero__row">
      <div class="legal-hero__meta">
        <p class="legal__updated"><Icon name="clock" size={16} /> Last updated: {updated}</p>
      </div>
      <div class="legal-hero__lead">
        <p class="lead">These terms and conditions of sale govern every order placed with SIA Semers Group through the web shop at semers.org. They explain how ordering and payment work, when a contract is concluded, how delivery and the 14-day right of withdrawal work, and what happens if something arrives damaged.</p>
        <GoverningLanguage />
      </div>
    </div>
  </section>

  <!-- ============================== BODY ============================== -->
  <div class="container legal">
    <aside class="legal__aside">
      <nav class="legal__nav" aria-label="Legal pages">
        <p class="eyebrow">Legal</p>
        <div class="pills legal__pills">
          {legalNav.map((l) => (
            <a class={`pill${l.active ? ' is-active' : ''}`} href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
          ))}
        </div>
      </nav>
      <nav class="legal__toc" aria-label="On this page" data-toc>
        <p class="eyebrow">On this page</p>
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ol>
      </nav>
      <div class="legal__help">
        <p class="small"><strong>Something unclear?</strong> Write to <a href={`mailto:${site.email}`}>{site.email}</a>. A person in Riga replies within one business day.</p>
      </div>
    </aside>

    <div class="prose legal__body" data-legal-body>
      <div class="legal__summary" id="summary">
        <h2>In plain words</h2>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> You send an order request; we confirm by e-mail with the total and a payment link; the contract is concluded when you pay.</li>
          <li><Icon name="check" size={18} /> Prices are in euro and include VAT. Shipping is free over {freeFrom}.</li>
          <li><Icon name="check" size={18} /> You may withdraw within 14 days of receiving your parcel, for products that are still sealed.</li>
          <li><Icon name="check" size={18} /> Arrived damaged? A photo within 48 hours gets you a replacement or a refund.</li>
          <li><Icon name="check" size={18} /> Everything we make contains egg white.</li>
        </ul>
      </div>

      <h2 id="parties">Who we are and what these terms cover</h2>
      <p>These terms apply to purchases made by consumers through the web shop at semers.org (“the shop”), operated by <strong>{site.brand.legalName}</strong>, {site.locality}, {site.country} (“Semers”, “we”).</p>
      <!-- TODO Semers: add the company registration number (Reģ. Nr.) and VAT number here as visible text. -->
      <!-- TODO Semers: add the registered street address here as visible text. -->
      <p>A consumer is a natural person acting for purposes outside their trade, business or profession. If you are a retailer, café, office or distributor, please go through our <a href="/wholesale/">wholesale page</a>; those sales are governed by a separate supply agreement, not by these terms.</p>
      <p>By placing an order you accept these terms. The version published at the time of your order is the one that applies to it. Nothing in these terms limits the rights you have under the Latvian Consumer Rights Protection Law or under mandatory consumer law in the EU country where you live.</p>

      <h2 id="products">Products and images</h2>
      <p>We sell food: baked-apple bars, apple meringues, Belyov pastila, zephyr and boxes that combine them, made in Riga from Antonovka apples and egg white. Because it is a natural product, colour, texture and exact weight vary a little from batch to batch, and the colour on your screen will never be quite the colour in your hand. Photographs are illustrative; the weights, pack sizes and flavour lists on each product page describe what you are buying.</p>
      <p>Ingredient lists, allergen statements and typical nutrition values are published on every product page, for example the <a href="/products/apple-bar-35g/">App’Lite Apple Bar</a>. The label on the pack you receive is the definitive source: if the pack and the website ever differ, the pack is right, and we would like to know about it. Every product carries a printed best-before date and keeps for months at room temperature; storage advice is on the pack.</p>

      <h2 id="prices">Prices</h2>
      <p>All prices are shown in euro (EUR) and include Latvian value added tax at the applicable rate. Shipping is charged separately and shown in the cart, at checkout and in our confirmation e-mail: free for orders over {freeFrom}, otherwise a flat {flatRate} in Latvia, Lithuania and Estonia, and for other EU countries a courier rate that we quote in the confirmation. Full details are on the <a href="/legal/shipping-returns/">shipping &amp; returns</a> page, which forms part of these terms.</p>
      <p>We may change prices at any time. The price shown when you place your order request, and confirmed in our e-mail, is the price you pay. If a price on the site is obviously wrong, a typing slip rather than a discount, we will tell you before confirming, and you can cancel the request at no cost.</p>

      <h2 id="ordering">How ordering works</h2>
      <p>The shop takes order requests. No payment is collected on the site itself, and no account is needed. The sequence is:</p>
      <ol class="steps legal__steps">
        <li class="step"><h3>Fill your box</h3><p>Add products to your cart and go to checkout. You can change quantities and flavours right up to the moment you send the request.</p></li>
        <li class="step"><h3>Send an order request</h3><p>Enter your delivery details and send the request. You receive an automatic e-mail with an order reference. This is your offer to buy; it is not yet a contract, and nothing is charged.</p></li>
        <li class="step"><h3>We confirm</h3><p>Within one business day we check stock and shipping and send a confirmation e-mail with the final total and a secure payment link. If something cannot be supplied, we say so and offer an alternative or leave that item out.</p></li>
        <li class="step"><h3>You pay, we ship</h3><p>The contract of sale is concluded when your payment reaches us. The parcel then leaves Riga within 1–2 business days. If the payment link is not used within seven days, the request lapses quietly and nothing is owed.</p></li>
      </ol>
      <p>We may decline or limit an order in a few cases: quantities that look like resale rather than a family’s snack drawer (please write to <a href="/wholesale/">wholesale</a> instead), an address our carriers cannot reach, or suspected fraud. We will always tell you why.</p>
      <p>Once online card payment is live, you will pay on the payment provider’s pages during checkout, and the contract will be concluded when that payment succeeds. We will update this section when it changes.</p>
      <!-- TODO Semers: revise this section when online card payment goes live (provider name, moment of contract). -->

      <h2 id="delivery">Delivery</h2>
      <p>We ship to Latvia, Lithuania, Estonia and the rest of the European Union, from Riga, within 1–2 business days of receiving payment. Estimated delivery times, costs, carriers and the option to collect in Riga are set out on the <a href="/legal/shipping-returns/">shipping &amp; returns</a> page. Delivery estimates are estimates, not guaranteed dates. If a parcel is seriously late, write to us: we will chase the carrier or send a replacement.</p>
      <p>The risk of loss of or damage to the goods passes to you when you, or a person you have nominated, take physical possession of them. For a parcel locker, that is when you collect the parcel. If a parcel comes back to us because the address was incomplete or it was not collected from the locker in time, we will contact you; sending it again is charged at the standard shipping rate.</p>

      <h2 id="withdrawal">Right of withdrawal</h2>
      <p>As a consumer in the EU, you may withdraw from the contract within <strong>14 days</strong> of the day on which you, or a person you nominated other than the carrier, received the goods, without giving any reason. For an order delivered in several parcels the period runs from the last parcel. This right comes from Directive 2011/83/EU on consumer rights and the Latvian rules that implement it.</p>
      <h3>Exceptions that matter for food</h3>
      <p>Under the same rules, the right of withdrawal does not apply to:</p>
      <ul>
        <li>sealed goods which are not suitable for return for health protection or hygiene reasons and were unsealed after delivery; and</li>
        <li>goods that are liable to deteriorate or expire rapidly.</li>
      </ul>
      <p>In practice: you can return products that are still sealed and in the condition in which you received them. An opened bar, bag, box or loaf cannot be returned. Products with a short remaining shelf life may fall under the second exception; we will tell you if that is the case.</p>
      <h3>How to withdraw</h3>
      <p>Send us a clear statement before the 14 days end, by e-mail to <a href={`mailto:${site.email}`}>{site.email}</a>, with your order reference. You are welcome to use this wording:</p>
      <blockquote class="legal__form">To {site.brand.legalName}, {site.locality}, {site.country}, {site.email}: I hereby give notice that I withdraw from my contract of sale of the following goods: [products]. Ordered on [date], received on [date], order reference [SM-…]. Name, address, date.</blockquote>
      <p>Then send the goods back within 14 days of telling us, well packed, to the return address we give you in our reply. You bear the direct cost of returning the goods, unless the return is the result of our mistake. You are liable for any diminished value of the goods resulting from handling beyond what is needed to establish their nature and characteristics; for sealed food, that means keeping the seal intact.</p>
      <p>We refund the price of the goods and the standard outbound shipping, but not any premium delivery option you chose, within 14 days of receiving your notice, using the same payment method you used. We may hold the refund until the goods are back with us or you have shown proof of sending them, whichever comes first.</p>

      <h2 id="defects">Damaged or defective goods</h2>
      <p>You are entitled to goods that conform to the contract, under the Latvian Consumer Rights Protection Law and EU law. If something arrives damaged, spoiled, wrong or missing, e-mail us a photo of the parcel and the product, together with your order reference, within <strong>48 hours</strong> of delivery. We then send a replacement or refund the affected items, including any shipping you paid, whichever you prefer. You do not need to send damaged food back unless we ask.</p>
      <p>Reporting within 48 hours lets us claim from the carrier, which is why we ask for it. It is not a deadline for your statutory rights, which do not depend on this window.</p>

      <h2 id="allergens">Allergens and food information</h2>
      <p>Every product we make contains <strong>egg white</strong>; it is what makes pastila light. The Pine Nut pastila contains nuts, and all our products may contain traces of nuts because they are made in the same facility. The chocolate-covered zephyr contains soy and may contain milk. The full allergen statement is on each product page and on the pack.</p>
      <p>If you have an allergy or intolerance, please read the label before eating and write to us if anything is unclear. We are makers of apple snacks, not medical advisers: nothing on this site is dietary or medical advice. “No added sugar” means exactly that, and no more: the sugars naturally present in apples remain.</p>

      <h2 id="liability">Liability</h2>
      <p>We are liable, as the law requires, for damage caused intentionally or through gross negligence, for death or personal injury caused by our fault, and for defective products under product liability law. Beyond that, our liability for a consumer order is limited to the value of that order, and we are not liable for indirect or unforeseeable loss, or for delays and failures caused by events outside our reasonable control, such as carrier strikes, extreme weather or border delays. Nothing in this section limits rights that cannot be limited under the law of the country where you live.</p>

      <h2 id="law">Governing law and disputes</h2>
      <p>These terms and every contract concluded under them are governed by the law of the Republic of Latvia. If you are a consumer living in another EU country, you also keep the protection of the mandatory rules there.</p>
      <p>Disputes: talk to us first. Most things are solved with one e-mail. If we cannot agree, consumers in Latvia can turn to the Consumer Rights Protection Centre (<span lang="lv">Patērētāju tiesību aizsardzības centrs</span>, <a href="https://www.ptac.gov.lv/" rel="noopener">ptac.gov.lv</a>) and the Consumer Dispute Resolution Commission that works alongside it. Consumers in other EU countries can get help with a cross-border complaint from their national European Consumer Centre (ECC-Net). The European Commission’s online dispute resolution (ODR) platform was discontinued in July 2025 and no longer accepts new complaints.</p>
      <p>The courts of Latvia have jurisdiction, without prejudice to a consumer’s right under EU law to bring or defend a claim in the courts of their home country.</p>

      <h2 id="changes">Changes to these terms</h2>
      <p>We may update these terms from time to time. The version published when you place your order applies to that order. The current version is always at this address, with the date at the top.</p>

      <h2 id="contact">Contact</h2>
      <p>{site.brand.legalName}, {site.locality}, {site.country}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <!-- TODO Semers: repeat the registration number and street address here as visible text. -->
      <p>Prefer a form? Use the <a href="/contact/">contact page</a>. For how we handle your data, see the <a href="/legal/privacy/">privacy policy</a>. Most practical questions are answered in the <a href="/faq/">FAQ</a>.</p>
    </div>

    <!-- Marginalia: the numbers that matter on this page, set as outlined type in the otherwise empty right third. -->
    <ul class="legal__facts">
      <li><strong>14 days</strong><span>to return sealed products</span></li>
      <li><strong>48 hours</strong><span>to report a damaged parcel</span></li>
      <li><strong>{freeFrom}</strong><span>free shipping above this, across the EU</span></li>
    </ul>
  </div>

  <!-- ============================== CTA ============================== -->
  <section class="section container section--tight" aria-labelledby="cta-title">
    <div class="cta-band legal__band" data-reveal>
      <div class="legal__band-copy">
        <p class="eyebrow">Ready when you are</p>
        <h2 id="cta-title">The terms are long. The ingredient list isn’t.</h2>
        <p>Apple bars, meringues and Belyov pastila, made in Riga and shipped across the EU. Free shipping over {freeFrom}.</p>
        <div class="cluster mt-2">
          <a class="btn btn--paper" href="/shop/">Shop the range <Icon name="arrow" size={18} class="arrow" /></a>
          <a class="btn btn--ghost legal__ghost" href="/shop/apple-bars/">Start with the bars</a>
        </div>
      </div>
      <div class="legal__band-media">
        <img src={band.src} srcset={band.srcset} sizes={band.srcset && SIZES.third} alt={band.alt} width={band.width} height={band.height} loading="lazy" decoding="async" data-parallax="0.1" />
      </div>
    </div>
  </section>
</Base>

<script>
  /*
   * The rail: which section is under the reader lights up in the table of
   * contents, and a thin honey line grows down the rail as the reading goes.
   * On a phone the same list is a strip of chips and the lit chip is kept in view.
   */
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const body = document.querySelector<HTMLElement>('[data-legal-body]');
  if (toc && body) {
    const list = toc.querySelector<HTMLElement>('ol');
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const heads = [...body.querySelectorAll<HTMLElement>('[id]')].filter((h) => byId.has(h.id));
    let current: HTMLAnchorElement | null = null;
    let raf = 0;
    const set = (a: HTMLAnchorElement | null) => {
      if (a === current) return;
      current?.classList.remove('is-on');
      current?.removeAttribute('aria-current');
      current = a;
      if (!a) return;
      a.classList.add('is-on');
      a.setAttribute('aria-current', 'location');
      if (list && list.scrollWidth > list.clientWidth) list.scrollTo({ left: a.offsetLeft - list.clientWidth / 2 + a.offsetWidth / 2, behavior: 'smooth' });
    };
    const update = () => {
      raf = 0;
      const line = innerHeight * 0.35;
      let pick: HTMLElement | null = null;
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= line) pick = h;
        else break;
      }
      set(pick ? byId.get(pick.id)! : null);
      const r = body.getBoundingClientRect();
      toc.style.setProperty('--p', Math.min(1, Math.max(0, (line - r.top) / r.height)).toFixed(3));
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', ask);
    update();
  }
</script>

<style>
  /* ------------------------------------------------------------- hero */
  .legal-hero { padding-block: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 4vw, 3rem); }
  .legal-hero .eyebrow { margin-bottom: 1.25rem; }
  .legal-title { font-size: var(--fs-4xl); line-height: var(--lh-tight); letter-spacing: -0.04em; max-width: 13ch; text-wrap: balance; }
  /* Phones: a long Cyrillic or Latvian word must still fit one line at a size the ground can carry. */
  @media (max-width: 48rem) { .legal-title { max-width: none; font-size: clamp(2.25rem, 9.5vw, 3.25rem); overflow-wrap: anywhere; hyphens: auto; } }
  /* Russian legal nouns run to 19 letters; a step smaller keeps them whole on a 390 px screen. */
  @media (max-width: 48rem) { .legal-title:lang(ru) { font-size: clamp(2rem, 8.2vw, 3rem); } }
  .legal-title em { font-style: italic; font-weight: 400; color: var(--honey-500); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .legal-hero__row { display: grid; gap: 1.25rem; margin-top: clamp(1.5rem, 4vw, 3rem); }
  .legal-hero__lead { max-width: 65ch; }
  .legal-hero__lead .lead { max-width: none; font-size: var(--fs-lg); line-height: 1.55; }
  .legal-hero .legal-hero__lead :global(.governing) { margin: 1.25rem 0 0; }
  .legal__updated { display: inline-flex; align-items: center; gap: 0.5em; margin: 0; font-size: var(--fs-sm); color: var(--fg-3); }
  .legal__updated svg { color: var(--honey-500); }
  @media (min-width: 60rem) {
    .legal-hero__row { grid-template-columns: 16rem minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
    .legal-hero__meta { padding-top: 0.4rem; }
  }

  /* ------------------------------------------------------------- shell */
  .legal { display: grid; gap: var(--sp-6); align-items: start; padding-block: var(--sp-5) clamp(2rem, 5vw, 4rem); }
  @media (min-width: 60rem) {
    .legal { grid-template-columns: 16rem minmax(0, 1fr); gap: var(--sp-8); }
    /* The rail stays put and only the table of contents scrolls inside it, so the help box is never cut off. */
    .legal__aside { position: sticky; top: 7rem; max-height: calc(100vh - 7.5rem); grid-template-rows: auto minmax(0, 1fr) auto; }
    .legal__toc { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding-bottom: 1.25rem; scrollbar-width: thin; scrollbar-color: rgb(243 233 214 / 0.18) transparent; mask-image: linear-gradient(#000 calc(100% - 1.25rem), transparent); -webkit-mask-image: linear-gradient(#000 calc(100% - 1.25rem), transparent); }
    .legal__pills { flex-direction: column; align-items: stretch; }
    .legal__pills .pill { text-align: left; }
  }
  .legal__aside { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); min-width: 0; }
  .legal__nav, .legal__toc { min-width: 0; }
  .legal__aside .eyebrow { margin-bottom: 0.75rem; }

  /* The rail: every section as a small outlined numeral; the one in view lights, and a honey line grows with the reading. */
  .legal__toc ol { position: relative; counter-reset: toc; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .legal__toc ol::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .legal__toc ol::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--honey-500); box-shadow: 0 0 12px var(--honey-500); transform: scaleY(var(--p, 0)); transform-origin: top; transition: transform 0.25s linear; }
  .legal__toc li { counter-increment: toc; }
  .legal__toc a { position: relative; display: grid; grid-template-columns: 1.7rem 1fr; align-items: baseline; gap: 0.4rem; padding: 0.35rem 0 0.35rem 1.1rem; font-size: var(--fs-sm); line-height: 1.35; color: var(--fg-2); text-decoration: none; transition: color var(--dur-fast); }
  .legal__toc a::before { content: counter(toc, decimal-leading-zero); font-family: var(--font-display); font-size: 0.95rem; font-weight: 400; letter-spacing: 0.02em; color: transparent; -webkit-text-stroke: 1px var(--cream-3); font-variation-settings: 'opsz' 48, 'SOFT' 0; transition: color var(--dur-fast); }
  .legal__toc a:hover { color: var(--cream-0); }
  .legal__toc a.is-on { color: var(--cream-0); }
  .legal__toc a.is-on::before { color: var(--honey-500); -webkit-text-stroke: 0; }
  @media (max-width: 59.99rem) {
    .legal__toc { margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .legal__toc ol { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; scrollbar-width: none; scroll-snap-type: x proximity; }
    .legal__toc ol::-webkit-scrollbar { display: none; }
    .legal__toc ol::before, .legal__toc ol::after { display: none; }
    .legal__toc li { flex: none; scroll-snap-align: start; }
    .legal__toc a { grid-template-columns: auto auto; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: var(--r-pill); white-space: nowrap; }
    .legal__toc a.is-on { border-color: rgb(240 176 74 / 0.55); background: var(--honey-100); }
  }
  .legal__help { padding: 1rem 1.1rem; border-radius: var(--r-md); background: var(--bg-raised); box-shadow: var(--shadow-1); }
  .legal__help p { margin: 0; color: var(--fg-2); }

  /* ------------------------------------------------------------- reading column */
  .legal__body { min-width: 0; max-width: 65ch; font-size: 1.125rem; line-height: 1.75; counter-reset: sec; }
  .legal__body p, .legal__body li { color: var(--fg-2); }
  .legal__body p strong, .legal__body li strong { color: var(--cream-0); }
  .legal__body a { color: var(--cream-0); }
  .legal__body h2 { position: relative; counter-increment: sec; scroll-margin-top: 7.5rem; margin: 3.4rem 0 0.9rem; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: var(--fs-2xl); letter-spacing: -0.03em; line-height: 1.05; }
  .legal__body h2::before { content: counter(sec, decimal-leading-zero); display: block; margin-bottom: 0.6rem; font-size: 1.1rem; font-weight: 400; letter-spacing: 0.02em; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--cream-3); font-variation-settings: 'opsz' 48, 'SOFT' 0; }
