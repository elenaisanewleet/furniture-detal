---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ProductCard from '~/components/ProductCard.astro';
import { PRODUCTS, FLAVORS, collectionByKey, formatPrice, unitPrice, productsInCollection, type Product, type FlavorKey, formatThreshold } from '~/data/products';
import { img, imgSrc, im, imgSmall, imgSrcset, SIZES } from '~/data/images';
import { productSchema, faqPage } from '~/lib/schema';
import { originOf } from '~/lib/origin';
import { site } from '~/data/site';
import { withLocales } from '~/i18n/config';
import type { Locale } from '~/i18n/config';
import { localizedProduct, localizedCollection } from '~/data/copy';
import { t } from '~/i18n/ui';

export function getStaticPaths() {
  return withLocales(PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } })));
}
const { product: rawProduct, locale } = Astro.props as { product: Product; locale: Locale };
const ui = t(locale);
const p = localizedProduct(rawProduct, locale);
const col = localizedCollection(collectionByKey(rawProduct.collection)!, locale);
const origin = originOf(Astro.site);
const gallery = p.images.map((k) => ({ key: k, ...im(k), small: imgSmall(k) }));
const first = p.variants[0];
const addPayload = JSON.stringify({
  slug: p.slug,
  name: p.title,
  variant: first.key,
  variantLabel: ui.flavours[first.key],
  price: first.price ?? p.price,
  image: gallery[0].src,
  weight: p.weightGrams,
  url: `/products/${p.slug}/`,
  // Gift sets and multi-packs are already priced as a bundle; stacking the
  // volume ladder on top of them would discount the same thing twice.
  tier: p.collection !== 'gift-sets',
});
const related = [
  ...productsInCollection(p.collection).filter((x) => x.slug !== p.slug),
  ...PRODUCTS.filter((x) => x.collection !== p.collection && x.bestseller),
  ...PRODUCTS.filter((x) => x.collection !== p.collection && !x.bestseller),
].slice(0, 3);
const multi = p.variants.length > 1;
/**
 * The trust line may only quote a number for the base recipe (the first sentence of the ingredient
 * list, brackets removed): "Baked apples, egg white" → 2. Flavour additions, mixed boxes and
 * "see individual products" fall back to the wording that is true for every variant.
 */
const baseRecipe = p.ingredients.split(/[.;]/)[0].replace(/\([^)]*\)/g, '');
const ingredientCount = /egg white/i.test(baseRecipe) ? baseRecipe.split(',').length : 0;
const ingredientLine =
  ingredientCount === 2 ? `2 ingredients${multi && p.variants.some((v) => v.key === 'classic') ? ' in the Classic' : ''}` : 'Short ingredient list';
/** "Belyov Pastila · Belyov pastila" reads like a stutter when the brand is the collection. */
const showBrand = p.brand.toLowerCase() !== col.name.toLowerCase();
const isBundle = p.collection === 'gift-sets';
/** Zephyr is the one product made with sugar; every claim below is switched on it. */
const noAddedSugar = p.diet.includes('no-added-sugar');
/** kcalPerUnit is per single piece (bar, loaf, box); multi-packs list the piece weight. A 0 means "mixed box, see each item". */
const hasKcal = p.kcalPerUnit > 0;
const unitGrams = p.pack > 1 ? Math.round(p.weightGrams / p.pack) : p.weightGrams;
const kcalLine = p.pack > 1 ? `${p.kcalPerUnit} kcal per ${unitGrams} g piece` : `${p.kcalPerUnit} kcal per ${unitGrams} g`;

/*
 * The three big numbers. They are counted from the English catalogue entry so
 * that every language shows the same figures: a loaf or a box quotes kcal per
 * 100 g rather than a whole-pack total nobody eats in one go, and a mixed box
 * that cannot count its ingredients quotes its shelf life instead.
 */
const isBar = p.collection === 'apple-bars' || p.collection === 'flourless-bars';
const per100 = !hasKcal || (p.pack === 1 && p.weightGrams >= 150);
const bigKcal = per100 ? p.nutrition.energyKcal : p.kcalPerUnit;
const bigKcalLabel = per100 ? 'kcal per 100 g' : p.pack > 1 ? 'kcal a piece' : isBar ? 'kcal a bar' : 'kcal a pack';
const rawRecipe = rawProduct.ingredients.split(/[.;]/)[0].replace(/\([^)]*\)/g, '');
const rawCount = /egg white/i.test(rawRecipe) ? rawRecipe.split(',').length : 0;
const bigMid = rawCount > 0 ? rawCount : p.shelfLifeMonths;
const bigMidLabel = rawCount > 0 ? 'ingredients' : 'months on the shelf';
/** The swatch may be a gradient (Assorted); the glow needs one colour. */
const swatch = (k: FlavorKey) => FLAVORS[k].color;
const glow = (k: FlavorKey) => (k === 'assorted' ? 'var(--honey-500)' : FLAVORS[k].color);
const longName = p.name.length > 14;

const faqs = [
  ...(hasKcal
    ? [
        p.pack > 1
          ? { q: 'How many calories are in each piece?', a: `About ${p.kcalPerUnit} kcal per ${unitGrams} g piece, so around ${p.kcalPerUnit * p.pack} kcal in the whole pack of ${p.pack}. Per 100 g: ${p.nutrition.energyKcal} kcal.` }
          : { q: isBar ? 'How many calories are in one bar?' : 'How many calories are in one pack?', a: `About ${p.kcalPerUnit} kcal per ${p.weightGrams} g. Per 100 g: ${p.nutrition.energyKcal} kcal.` },
      ]
    : []),
  noAddedSugar
    ? { q: 'Does it contain added sugar?', a: 'No. The sweetness comes from the baked Antonovka apples themselves. Nothing else is added.' }
    : { q: 'Does it contain added sugar?', a: 'Yes. Belevini zephyr is a traditional recipe made with apple purée, egg white, agar and sugar, and the pack says so. Our bars, meringues, dessert squares and Belyov pastila are the no-added-sugar range.' },
  { q: 'How long does it keep?', a: `${p.shelfLifeMonths} months in a cool, dry place. Once opened, enjoy within a few days.` },
  { q: 'Do you ship outside Latvia?', a: `Yes — we ship across ${site.shipping.regions.slice(0, 3).join(', ')} and the EU. Orders over ${formatThreshold(site.shipping.freeFrom, locale)} ship free.` },
];

const rows: [string, string][] = [
  ['Energy', `${p.nutrition.energyKcal} kcal`],
  ['Fat', `${p.nutrition.fat} g`],
  ['of which saturates', `${p.nutrition.saturates} g`],
  ['Carbohydrate', `${p.nutrition.carbs} g`],
  ['of which sugars', `${p.nutrition.sugars} g`],
  ['Fibre', `${p.nutrition.fibre} g`],
  ['Protein', `${p.nutrition.protein} g`],
  ['Salt', `${p.nutrition.salt} g`],
];
---
<Base
  title={p.title}
  description={p.summary}
  canonical={`/products/${p.slug}/`}
  ogImage={p.images[0]}
  ogType="product"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Shop', href: '/shop/' }, { name: col.name, href: `/shop/${col.key}/` }, { name: p.name, href: `/products/${p.slug}/` }]}
  schema={[productSchema(origin, p, ui.flavours), faqPage(faqs)]}
  bodyClass="has-sticky-buy"
>
  <Fragment slot="head">
    <meta property="product:price:amount" content={(first.price ?? p.price).toFixed(2)} />
    <meta property="product:price:currency" content={site.currency} />
    <meta property="product:availability" content="in stock" />
    <meta property="product:brand" content={p.brand} />
  </Fragment>
  <article class="pdp" data-pdp data-slug={p.slug}>
    <!-- ============================== THE STAGE ==============================
         The photograph stays put on the left while the buy panel and the
         story scroll past it. --fl is the colour of the chosen flavour: the
         frame's glow and the chips read it. On a phone the two columns stack,
         photograph first. -->
    <div class="stage container" data-stage style={`--fl:${glow(first.key)}`}>
      <div class="stage__gal">
        <div class="gal" style={`--gal-accent:${p.accent}`}>
          <div class={`gal__main ${gallery[0].fit === 'contain' ? 'is-contain' : ''}`} data-gal-wrap>
            {p.badge || p.bestseller ? <span class="badge">{p.badge || 'Bestseller'}</span> : null}
            <img data-gal-main src={gallery[0].src} alt={gallery[0].alt} width={gallery[0].width} height={gallery[0].height} loading="eager" fetchpriority="high" decoding="async" />
          </div>
          {gallery.length > 1 && (
            <div class="gal__thumbs" role="group" aria-label={ui.productImages}>
              {gallery.map((g, i) => (
                <button type="button" data-gal-thumb data-src={g.src} data-alt={g.alt} data-fit={g.fit || 'cover'} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Image ${i + 1} of ${gallery.length}`} class={g.fit === 'contain' ? 'is-contain' : ''}>
                  <img src={g.small} alt="" width="72" height="72" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="stage__buy">
        <div class="buy">
          <p class="eyebrow">{showBrand && <Fragment><span translate="no">{p.brand}</span> · </Fragment>}<a href={`/shop/${col.key}/`}>{col.name}</a></p>
          <h1 class={`pdp__title ${longName ? 'pdp__title--long' : ''}`}>{p.name} <span class="pdp__w">{p.weightGrams} g{p.pack > 1 ? ` · ${p.pack} pcs` : ''}</span></h1>
          <p class="pdp__hook">{p.hook}</p>

          <div class="pdp__price">
            <span class="pdp__amount num" data-price>{formatPrice(first.price ?? p.price, locale)}</span>
            {p.compareAt && <s class="pdp__was num">{formatPrice(p.compareAt, locale)}</s>}
            <span class="pdp__unit">{p.pack > 1 ? `${ui.perPiece(formatPrice((first.price ?? p.price) / p.pack, locale))} · ` : ''}{unitPrice(p, locale)} {ui.per100g} · {ui.inclVat}</span>
          </div>

          <ul class="pdp__facts" aria-label={ui.keyFacts}>
            {hasKcal && <li><Icon name="apple" size={16} /> {kcalLine}</li>}
            {p.diet.slice(0, 3).map((d) => <li><Icon name="check" size={16} /> {ui.diet[d]}</li>)}
          </ul>

          {multi && (
            <fieldset class="pdp__vars">
              <legend>{ui.flavour}: <strong data-variant-name>{ui.flavours[first.key]}</strong></legend>
              <div class="vars">
                {p.variants.map((v, i) => (
                  <label class="var" style={`--sw:${swatch(v.key)};--sg:${glow(v.key)}`}>
                    <input type="radio" name="flavour" value={v.key} data-variant data-price={v.price ?? p.price} data-label={ui.flavours[v.key]} data-gtin={v.gtin || ''} data-glow={glow(v.key)} checked={i === 0} disabled={v.inStock === false} />
                    <span><i></i>{ui.flavours[v.key]}</span>
                  </label>
                ))}
              </div>
              <p class="tiny pdp__varnote">{p.variants.map((v) => `${ui.flavours[v.key]}: ${ui.flavourNotes[v.key]}`).join(' · ')}</p>
            </fieldset>
          )}

          {site.storefront.tiersOn && !isBundle && (
            <div class="tiers" data-tiers role="group" aria-label={ui.quantityDiscounts}>
              {[
                { qty: 1, pct: 0 },
                { qty: site.storefront.tier1Qty, pct: site.storefront.tier1Pct },
                { qty: site.storefront.tier2Qty, pct: site.storefront.tier2Pct },
              ].map((t, i) => (
                <button type="button" class={`tier ${i === 0 ? 'is-on' : ''}`} data-tier data-tier-qty={t.qty} data-tier-pct={t.pct} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <b>{t.qty} {t.qty === 1 ? 'pack' : 'packs'}</b>
                  <span class="tier__unit num" data-tier-unit>{formatPrice(((first.price ?? p.price) * (100 - t.pct)) / 100, locale)}</span>
                  <span class="tier__note">{t.pct ? `each · save ${t.pct}%` : 'each'}</span>
                </button>
              ))}
            </div>
          )}

          <div class="pdp__cta" data-buy-anchor>
            <div class="qty" role="group" aria-label={ui.quantity}>
              <button type="button" data-qty-dec aria-label={ui.decreaseShort}>−</button>
              <input data-qty-input type="number" min="1" max="99" value="1" inputmode="numeric" aria-label="Quantity" />
              <button type="button" data-qty-inc aria-label={ui.increaseShort}>+</button>
            </div>
            <button class="btn btn--lg btn--accent pdp__add" type="button" data-add={addPayload}>
              <Icon name="cart" size={20} /> Add to box
            </button>
          </div>

          {/* Revealed by the storefront sync when an override marks this product out of stock. */}
          <form class="restock" data-restock hidden>
            <p class="restock__t"><strong>Out of stock right now.</strong> Leave your e-mail and we will write to you the day the next batch is ready — nothing else.</p>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
            <div class="restock__row">
              <label class="sr-only" for="restock-email">E-mail</label>
              <input id="restock-email" type="email" name="email" required maxlength="160" autocomplete="email" placeholder="you@example.com" class="input" />
              <button class="btn" type="submit">{ui.notifyMe}</button>
            </div>
            <p class="restock__note" data-restock-note hidden></p>
          </form>

          {site.storefront.guaranteeOn && (
            <p class="pdp__promise" data-guarantee>
              <Icon name="shield" size={18} /> <span data-guarantee-text>{site.storefront.guarantee}</span>
            </p>
          )}

          <ul class="pdp__trust">
            <li><Icon name="truck" size={18} /> Free shipping over {formatThreshold(site.shipping.freeFrom, locale)} · ships from Riga in 1–2 business days</li>
            <li><Icon name="leaf" size={18} /> {noAddedSugar ? `${ingredientLine}, nothing artificial` : 'Made with sugar and agar, and the label says so'}</li>
            <li><Icon name="clock" size={18} /> Keeps {p.shelfLifeMonths} months — no fridge needed</li>
            <li data-batch hidden><Icon name="apple" size={18} /> <span data-batch-text></span></li>
          </ul>
        </div>

        <!-- The story: it scrolls past the photograph. -->
        <div class="story">
          <div class="pdp__desc prose" data-reveal>
            {p.description.map((d) => <p>{d}</p>)}
          </div>

          <div class="acc pdp__acc">
            <details>
              <summary>{ui.shippingReturnsTitle}</summary>
              <div class="acc__body">
                <p>{site.shipping.note} Free shipping over {formatThreshold(site.shipping.freeFrom, locale)}; otherwise a flat €3.90 in the Baltics; EU courier rates are confirmed by e-mail. We ship to {site.shipping.regions.slice(0, 3).join(', ')} and the rest of the EU.</p>
                <p>Damaged in transit? Send us a photo within 48 hours and we replace it. <a href="/legal/shipping-returns/">{ui.fullPolicy}</a>.</p>
              </div>
            </details>
            {isBundle && (
              <details>
                <summary>{ui.whatsInTheBox}</summary>
                <div class="acc__body"><p>{p.summary}</p></div>
              </details>
            )}
          </div>

          <div class="why" data-reveal>
            {noAddedSugar ? (
              <div>
                <p class="eyebrow">Why it works</p>
                <h2 class="why__title">Sweet because apples are sweet.</h2>
                <p class="lead">We bake Antonovka apples until their sugars caramelise, whip the purée with egg white, and dry it in thin layers. That is the whole trick: concentrate the fruit, add air, add nothing else.</p>
                <ul class="ticks">
                  <li><Icon name="check" /> No added sugar, sweeteners or syrups</li>
                  <li><Icon name="check" /> No flour, no gluten, no fat added</li>
                  <li><Icon name="check" /> Source of fibre from the whole fruit</li>
                </ul>
                <a class="link" href="/how-its-made/">See how it’s made</a>
              </div>
            ) : (
              <div>
                <p class="eyebrow">Good to know</p>
                <h2 class="why__title">Apple first, even here.</h2>
                <p class="lead">Zephyr is set with agar rather than gelatine and, unlike the rest of our range, it is made with sugar. We start it from the same Antonovka purée as our pastila, and the pack says exactly what is in it.</p>
                <ul class="ticks">
                  <li><Icon name="check" /> Antonovka apple purée, egg white, agar, sugar</li>
                  <li><Icon name="check" /> Set with agar, not gelatine</li>
                  <li><Icon name="check" /> The one Semers product with sugar in it, labelled as such</li>
                </ul>
                <a class="link" href="/shop/apple-bars/">The no-added-sugar range</a>
              </div>
            )}
            <div class="why__frame">
              <img src={imgSrc('pastila-texture')} srcset={imgSrcset('pastila-texture')} sizes={imgSrcset('pastila-texture') && SIZES.half} alt={img('pastila-texture').alt} width={img('pastila-texture').width} height={img('pastila-texture').height} loading="lazy" decoding="async" data-parallax="0.2" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================== THREE NUMBERS ==============================
         The label, set as display type. The numbers count up as they come into view. -->
    <section class="big3" aria-labelledby="big3-title">
      <div class="container">
        <div class="big3__head">
          <p class="eyebrow">By the numbers</p>
          <h2 id="big3-title" class="big3__title" data-words>The whole label, in three numbers.</h2>
        </div>
        <div class="big3__row" data-stagger>
          <div class="big3__cell">
            <b class="big3__n" data-count={bigKcal}>{bigKcal}</b>
            <span class="big3__l">{bigKcalLabel}</span>
          </div>
          <div class="big3__cell big3__cell--em">
            <em class="big3__n" data-count={bigMid}>{bigMid}</em>
            <span class="big3__l">{bigMidLabel}</span>
          </div>
          <div class="big3__cell">
            <b class="big3__n" data-count={p.weightGrams}>{p.weightGrams}</b>
            <span class="big3__l">grams</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== WHAT'S INSIDE ============================== -->
    <section class="pdp-inside section" aria-labelledby="inside-title">
      <div class="container pdp-inside__grid">
        <div class="pdp-inside__text">
          <p class="eyebrow">What’s inside</p>
          <h2 id="inside-title" data-words>Read the label. <em>All of it.</em></h2>
          <p class="pdp-inside__ing"><strong>{ui.ingredients}</strong> {p.ingredients}</p>
          <p class="pdp-inside__all"><strong>{ui.allergens}</strong> {p.allergens}</p>
          {multi && <p class="small muted pdp-inside__ean">EAN for the selected flavour: <span data-gtin translate="no">{first.gtin || '—'}</span></p>}
          <ul class="pdp-inside__diet" aria-label={ui.keyFacts}>
            {p.diet.map((d) => <li class="chip chip--leaf">{ui.diet[d]}</li>)}
          </ul>
        </div>
        <div class="lit" data-reveal>
          <h3 class="lit__title">{ui.nutritionPer100}</h3>
          <table class="nutri">
            <thead><tr><th>{ui.typicalValues}</th><th>{ui.per100g}</th></tr></thead>
            <tbody>
              {rows.map(([k, v]) => <tr class={k.startsWith('of which') ? 'sub' : ''}><td>{k}</td><td>{v}</td></tr>)}
            </tbody>
          </table>
          <p class="tiny muted lit__note">{hasKcal ? `Approximate per ${unitGrams} g: ${p.kcalPerUnit} kcal. ` : 'Typical values for the baked-apple pastila base; each product in the box carries its own nutrition label. '}Values are typical for the recipe; see the pack for the batch label.</p>
        </div>
      </div>
    </section>

    {site.storefront.reviewsOn && (
      <section class="pdp__reviews section--tight container" data-reviews aria-labelledby="pdp-reviews-title">
        <div class="pdp__revhead">
          <h2 id="pdp-reviews-title">{ui.reviewsTitle}</h2>
          <p class="pdp__revsum" data-review-summary hidden></p>
        </div>
        <div class="pdp__revbody">
          <div>
            <div data-review-list></div>
            <p class="muted" data-review-empty hidden>{ui.noReviewsYet(p.name)}</p>
          </div>
          <details class="revform">
            <summary>{ui.writeReview}</summary>
            <form data-review-form novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
              <div class="revform__row">
                <label>
                  Rating
                  <select name="rating" required class="select">
                    <option value="5">5 — excellent</option>
                    <option value="4">4 — good</option>
                    <option value="3">3 — fine</option>
                    <option value="2">2 — poor</option>
                    <option value="1">1 — bad</option>
                  </select>
                </label>
                <label>{ui.yourName}<input type="text" name="author" required maxlength="60" autocomplete="name" class="input" /></label>
                <label>City <span class="muted">(optional)</span><input type="text" name="city" maxlength="60" class="input" /></label>
              </div>
              <label>Headline <span class="muted">(optional)</span><input type="text" name="title" maxlength="120" class="input" /></label>
              <label>{ui.yourReview}<textarea name="body" required minlength="10" maxlength="2000" rows="4" class="textarea"></textarea></label>
              <label>E-mail <span class="muted">(not published — only so we can reply)</span><input type="email" name="email" maxlength="160" autocomplete="email" class="input" /></label>
              <p class="tiny muted">We read every review before it appears, so it will not show up straight away.</p>
              <button class="btn" type="submit">Send review</button>
              <p class="revform__note" data-review-note hidden></p>
            </form>
          </details>
        </div>
      </section>
    )}

    <section class="section--tight container" aria-labelledby="rel-title">
      <div class="section-head">
        <h2 id="rel-title">Pairs well with</h2>
        <a class="link" href="/shop/">All products</a>
      </div>
      <div class="grid pdp__related" data-stagger>
        {related.map((r) => <ProductCard product={r} compact />)}
        <a class="boxtile" href="/shop/build-your-box/" data-cursor="Build">
          <span class="boxtile__six" aria-hidden="true">6</span>
          <span class="boxtile__body">
            <span class="eyebrow">Build your box</span>
            <span class="boxtile__title">Pick six bars, save 10%.</span>
            <span class="boxtile__cta">Start building <Icon name="arrow" size={18} class="arrow" /></span>
          </span>
        </a>
      </div>
    </section>

    <section class="section--tight container pdp__faq" aria-labelledby="pdp-faq-title">
      <div class="pdp__faq-grid">
        <div>
          <p class="eyebrow">{p.name}</p>
          <h2 id="pdp-faq-title">Questions people ask.</h2>
          <p class="muted mt-2">More in the <a href="/faq/">full FAQ</a>, or <a href="/contact/">write to us</a>.</p>
        </div>
        <div class="acc" data-reveal>
          {faqs.map((f) => (
            <details><summary>{f.q}</summary><div class="acc__body"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>
  </article>

  <div class="sticky-buy" data-sticky-buy>
    <div class="sticky-buy__in container">
      <img class="sticky-buy__img" src={gallery[0].small} alt="" width="48" height="48" loading="lazy" />
      <div class="sticky-buy__t"><strong>{p.title}</strong><span><span data-price>{formatPrice(first.price ?? p.price, locale)}</span> · <span data-variant-name>{ui.flavours[first.key]}</span></span></div>
      <button class="btn btn--accent" type="button" data-add={addPayload}>Add to box</button>
    </div>
  </div>
</Base>

<script>
  /*
   * The stage takes the colour of the flavour in hand: the frame's glow and
   * the chosen chip both read --fl. The picker itself lives in site.ts; this
   * only follows it. Without it the stage keeps the first flavour's colour.
   */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) {
    const radios = Array.from(stage.querySelectorAll<HTMLInputElement>('[data-variant]'));
    const paint = (r: HTMLInputElement) => {
      if (r.dataset.glow) stage.style.setProperty('--fl', r.dataset.glow);
    };
    radios.forEach((r) => r.addEventListener('change', () => paint(r)));
    const preset = new URL(location.href).searchParams.get('flavour');
    const on = radios.find((r) => r.value === preset) || radios.find((r) => r.checked);
    if (on) paint(on);
  }
</script>

