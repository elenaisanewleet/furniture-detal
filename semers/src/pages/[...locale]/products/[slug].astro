---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import ProductCard from '~/components/ProductCard.astro';
import { PRODUCTS, FLAVORS, collectionByKey, formatPrice, unitPrice, hasNetWeight, productsInCollection, type Product, type FlavorKey, type Nutrition, type Variant, formatThreshold } from '~/data/products';
import { im, imgSmall } from '~/data/images';
import { productSchema, faqPage } from '~/lib/schema';
import { originOf } from '~/lib/origin';
import { site } from '~/data/site';
import { withLocales } from '~/i18n/config';
import type { Locale } from '~/i18n/config';
import { localizedProduct, localizedCollection } from '~/data/copy';
import { t } from '~/i18n/ui';

export function getStaticPaths() {
  return withLocales(PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } })));
}
const { product: rawProduct, locale } = Astro.props as { product: Product; locale: Locale };
const ui = t(locale);
const p = localizedProduct(rawProduct, locale);
const col = localizedCollection(collectionByKey(rawProduct.collection)!, locale);
const origin = originOf(Astro.site);
const gallery = p.images.map((k) => ({ key: k, ...im(k), small: imgSmall(k) }));
const first = p.variants[0];
const addPayload = JSON.stringify({
  slug: p.slug,
  name: p.title,
  variant: first.key,
  variantLabel: ui.flavours[first.key],
  price: first.price ?? p.price,
  image: gallery[0].src,
  weight: p.weightGrams,
  url: `/products/${p.slug}/`,
  // Gift sets and multi-packs are already priced as a bundle; stacking the
  // volume ladder on top of them would discount the same thing twice.
  tier: p.collection !== 'gift-sets',
});
const related = [
  ...productsInCollection(p.collection).filter((x) => x.slug !== p.slug),
  ...PRODUCTS.filter((x) => x.collection !== p.collection && x.bestseller),
  ...PRODUCTS.filter((x) => x.collection !== p.collection && !x.bestseller),
].slice(0, 3);
const multi = p.variants.length > 1;
/**
 * The trust line may only quote a number for the base recipe (the first sentence of the ingredient
 * list, brackets removed): "Baked apples, egg white" → 2. Flavour additions, mixed boxes and
 * "see individual products" fall back to the wording that is true for every variant.
 */
const baseRecipe = p.ingredients.split(/[.;]/)[0].replace(/\([^)]*\)/g, '');
const ingredientCount = /egg white/i.test(baseRecipe) ? baseRecipe.split(',').length : 0;
const ingredientLine =
  ingredientCount === 2 ? `2 ingredients${multi && p.variants.some((v) => v.key === 'classic') ? ' in the Classic' : ''}` : 'Short ingredient list';
/** A product whose card names no brand shows none; a brand repeated as the collection's own name would read like a stutter. */
const showBrand = !!p.brand && p.brand.toLowerCase() !== col.name.toLowerCase();
/** A box whose contents are not settled has no net quantity: no weight and no price per 100 g is printed for it. */
const showWeight = hasNetWeight(p);
const isBundle = p.collection === 'gift-sets';
/** "35 g", or "12 × 35 g" for a multi-pack; the facts list adds the total for a multi-pack. */
const weightLine = showWeight ? (p.pack > 1 ? ui.packOf(p.pack, Math.round(p.weightGrams / p.pack)) : ui.grams(p.weightGrams)) : '';
const netLine = showWeight ? (p.pack > 1 ? `${weightLine} (${ui.grams(p.weightGrams)})` : weightLine) : '';
/** Every product is sold on the no-added-sugar claim today; the claims below still follow the tag rather than assume it. */
const noAddedSugar = p.diet.includes('no-added-sugar');
/** A mixed box is a single "assorted" line: it has no declaration of its own, only its contents' declarations. */
const isMixedBox = p.variants.length === 1 && p.variants[0].key === 'assorted';
/** kcalPerUnit is per single piece (bar, pack, cake); multi-packs list the piece weight. null means no card backs a figure. */
const kcalPerUnit = p.kcalPerUnit ?? 0;
const hasKcal = kcalPerUnit > 0;
const unitGrams = p.pack > 1 ? Math.round(p.weightGrams / p.pack) : p.weightGrams;
const kcalLine = p.pack > 1 ? `${kcalPerUnit} kcal per ${unitGrams} g piece` : `${kcalPerUnit} kcal per ${unitGrams} g`;

/*
 * The nutrition declaration. A flavour may carry its own figures (the two
 * meringues differ); when any does, the table gets one column per flavour, so
 * no flavour is shown another one's numbers. Otherwise one column serves all.
 */
const nutritionOf = (v: Variant): Nutrition => v.nutrition ?? p.nutrition;
const sameNutrition = (a: Nutrition, b: Nutrition) => (Object.keys(a) as (keyof Nutrition)[]).every((k) => a[k] === b[k]);
const flavoursDiffer = p.variants.some((v) => !sameNutrition(nutritionOf(v), p.nutrition));
const nutriCols = flavoursDiffer ? p.variants.map((v) => ({ head: ui.flavours[v.key], n: nutritionOf(v) })) : [{ head: ui.per100g, n: p.nutrition }];
/** One energy figure for the whole product, or null when the flavours differ or nothing is declared. */
const sharedKcal = flavoursDiffer ? null : p.nutrition.energyKcal;

/*
 * The label in three numbers, as on the approved shop: energy per 100 g, the
 * grams in the pack and the price of 100 g. Only what is declared is shown:
 * where the flavours declare different energy the range between them is given,
 * and a box whose contents are not settled has neither a weight nor a unit
 * price. With nothing left to show, the band is not rendered.
 */
const kcals = p.variants.map((v) => nutritionOf(v).energyKcal);
const kcalBig = kcals.every((k): k is number => k != null)
  ? Math.min(...kcals) === Math.max(...kcals) ? String(kcals[0]) : `${Math.min(...kcals)}–${Math.max(...kcals)}`
  : null;
const isBar = p.collection === 'apple-bars';
type LabelCell = { n: string; label: string; em?: boolean };
const labelCells = [
  kcalBig != null ? { n: kcalBig, label: 'kcal per 100 g' } : null,
  showWeight ? { n: String(p.weightGrams), label: ui.gInPack, em: true } : null,
  showWeight ? { n: unitPrice(p, locale), label: ui.per100g } : null,
].filter((c): c is LabelCell => c != null);
/** The swatch may be a gradient (Assorted). */
const swatch = (k: FlavorKey) => FLAVORS[k].color;
/** The flavour's own pack photo, so picking a flavour shows its wrapper (site.ts clicks the matching thumbnail). */
const variantSrc = (v: Variant) => (v.image ? im(v.image).src : '');

/*
 * The mandatory particulars (Reg. 1169/2011 art. 9), shown beside the food.
 * The name of the food can differ by flavour; every flavour's name is listed
 * rather than only the selected one's, so the page is complete without script.
 */
const legalNames = p.legalName ? p.variants.map((v) => ({ key: v.key, name: p.legalNameByFlavour?.[v.key] ?? p.legalName! })) : [];
const oneLegalName = new Set(legalNames.map((l) => l.name)).size === 1;
/** Named beside the food only once the owner has confirmed the address; half an operator is not a declaration. */
const operatorLine = site.operator.name && site.operator.address ? `${site.operator.name}, ${site.operator.address}` : '';
/*
 * Art. 21: the allergen is emphasised inside the ingredient list itself. The
 * list arrives already translated, so the words are matched in all three
 * languages (egg white, яичный белок, olu baltums, and the bare forms).
 */
const ALLERGEN = /(egg whites?|eggs?(?![a-z])|яичн[а-яё]*\s+бел[а-яё]*|яйц[а-яё]*|olu baltum[a-zāēīūšžčņļķģ]*|olas(?![a-zāēīūšžčņļķģ]))/iu;
const ingredientParts = p.ingredients.split(ALLERGEN);
/*
 * The allergen sentence, in the card's words. A card may word it differently
 * per flavour (the Russian and Latvian meringue cards do), and then every
 * flavour's sentence is listed, as with the name of the food. A product whose
 * card gives no sentence gets none: the list above already emphasises the egg.
 */
const allergenLines = p.allergens ? p.variants.map((v) => ({ key: v.key, text: p.allergensByFlavour?.[v.key] ?? p.allergens! })) : [];
const oneAllergenLine = new Set(allergenLines.map((l) => l.text)).size === 1;

/*
 * How long it keeps: the card's shelf life, else its storage conditions, else
 * nothing at all. Built from the localised copy, so the answer, and the FAQ
 * JSON-LD made from it, is in the language of the page. A storage text that
 * already names its months ("9 months when stored at…") answers on its own;
 * whether it does is read off the English, which is the same card in every language.
 */
const storageNamesMonths = !!rawProduct.storage && /month/i.test(rawProduct.storage);
const shelfSentence = p.shelfLifeMonths != null && !storageNamesMonths ? ui.shelfLifeIs(p.shelfLifeMonths) : '';
const keepAnswer = [shelfSentence, p.storage ?? ''].filter(Boolean).join(' ');
/** The trust line beside the button: the months where the card gives them, else the storage conditions. */
const keepLine = p.shelfLifeMonths != null ? ui.keepsMonths(p.shelfLifeMonths) : p.storage;
const per100Line = sharedKcal != null ? ` Per 100 g: ${sharedKcal} kcal.` : '';

const faqs = [
  ...(hasKcal
    ? [
        p.pack > 1
          ? { q: 'How many calories are in each piece?', a: `About ${kcalPerUnit} kcal per ${unitGrams} g piece, so around ${kcalPerUnit * p.pack} kcal in the whole pack of ${p.pack}.${per100Line}` }
          : { q: isBar ? 'How many calories are in one bar?' : 'How many calories are in one pack?', a: `About ${kcalPerUnit} kcal per ${p.weightGrams} g.${per100Line}` },
      ]
    : []),
  ...(noAddedSugar ? [{ q: 'Does it contain added sugar?', a: 'No. No sugar is added; the sugars it contains occur naturally in the fruit.' }] : []),
  ...(keepAnswer ? [{ q: ui.keepQuestion, a: keepAnswer }] : []),
  { q: 'Do you ship outside Latvia?', a: `Yes — we ship across ${site.shipping.regions.slice(0, 3).join(', ')} and the EU. Orders over ${formatThreshold(site.shipping.freeFrom, locale)} ship free.` },
];

/** A value the card does not give stays null, and the table says so instead of printing a number. */
const grams = (v: number | null) => (v == null ? null : `${v} g`);
const energy = (n: Nutrition) =>
  n.energyKj == null && n.energyKcal == null ? null : [n.energyKj != null ? `${n.energyKj} kJ` : '', n.energyKcal != null ? `${n.energyKcal} kcal` : ''].filter(Boolean).join(' / ');
const rows: { label: string; sub?: boolean; cells: (string | null)[] }[] = [
  { label: 'Energy', cells: nutriCols.map((c) => energy(c.n)) },
  { label: 'Fat', cells: nutriCols.map((c) => grams(c.n.fat)) },
  { label: 'of which saturates', sub: true, cells: nutriCols.map((c) => grams(c.n.saturates)) },
  { label: 'Carbohydrate', cells: nutriCols.map((c) => grams(c.n.carbs)) },
  { label: 'of which sugars', sub: true, cells: nutriCols.map((c) => grams(c.n.sugars)) },
  { label: 'Protein', cells: nutriCols.map((c) => grams(c.n.protein)) },
  { label: 'Salt', cells: nutriCols.map((c) => grams(c.n.salt)) },
];
const hasUndeclared = rows.some((r) => r.cells.some((c) => c == null));---
<Base
  title={p.title}
  description={p.summary}
  canonical={`/products/${p.slug}/`}
  ogImage={p.images[0]}
  ogType="product"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Shop', href: '/shop/' }, { name: col.name, href: `/shop/${col.key}/` }, { name: p.name, href: `/products/${p.slug}/` }]}
  schema={[productSchema(origin, p, ui.flavours), faqPage(faqs)]}
  bodyClass="has-sticky-buy"
>
  <Fragment slot="head">
    <meta property="product:price:amount" content={(first.price ?? p.price).toFixed(2)} />
    <meta property="product:price:currency" content={site.currency} />
    <meta property="product:availability" content="in stock" />
    {p.brand && <meta property="product:brand" content={p.brand} />}
  </Fragment>
  <article class="pdp" data-pdp data-slug={p.slug}>
    <!-- ============================== THE PRODUCT ==============================
         The photographs on the left, everything needed to buy on the right,
         and under the button the food information the law wants shown before
         the purchase. On a phone the two columns stack, photographs first. -->
    <div class="stage container">
      <div class="stage__gal">
        <div class="gal" style={`--gal-accent:${p.accent}`}>
          <div class={`gal__main ${gallery[0].fit === 'contain' ? 'is-contain' : ''}`} data-gal-wrap>
            {p.badge || p.bestseller ? <span class="badge">{p.badge || 'Bestseller'}</span> : null}
            <img data-gal-main src={gallery[0].src} alt={gallery[0].alt} width={gallery[0].width} height={gallery[0].height} loading="eager" fetchpriority="high" decoding="async" />
          </div>
          {gallery.length > 1 && (
            <div class="gal__thumbs" role="group" aria-label={ui.productImages}>
              {gallery.map((g, i) => (
                <button type="button" data-gal-thumb data-src={g.src} data-alt={g.alt} data-fit={g.fit || 'cover'} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Image ${i + 1} of ${gallery.length}`} class={g.fit === 'contain' ? 'is-contain' : ''}>
                  <img src={g.small} alt="" width="88" height="66" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="stage__buy">
        <div class="buy">
          <p class="eyebrow">{showBrand && <Fragment><span translate="no">{p.brand}</span> · </Fragment>}<a href={`/shop/${col.key}/`}>{col.name}</a></p>
          <h1 class="pdp__title">{p.name}</h1>
          {weightLine && <p class="pdp__sub">{weightLine}</p>}
          <p class="pdp__lead">{p.summary}</p>

          {/* The claims this product's own pack prints (its diet tags), and the energy of one piece where a card backs it. */}
          <ul class="claims" aria-label={ui.keyFacts}>
            {p.diet.map((d) => <li><Icon name="check" size={14} /> {ui.diet[d]}</li>)}
            {hasKcal && <li><Icon name="check" size={14} /> {kcalLine}</li>}
          </ul>

          <div class="pdp__price">
            <span class="pdp__amount num" data-price>{formatPrice(first.price ?? p.price, locale)}</span>
            {/* The same contents bought one by one, written out as the sum it is rather than struck out as an earlier price. */}
            {p.compareAt && <span class="pdp__was num">{ui.boughtSingly(p.pack, formatPrice(p.compareAt / p.pack, locale), formatPrice(p.compareAt, locale))}</span>}
            <span class="pdp__unit">{p.pack > 1 ? `${ui.perPiece(formatPrice((first.price ?? p.price) / p.pack, locale))} · ` : ''}{showWeight ? `${unitPrice(p, locale)} ${ui.per100g} · ` : ''}{ui.inclVat}</span>
          </div>

          {multi && (
            <fieldset class="pdp__vars">
              <legend>{ui.flavour}: <strong data-variant-name>{ui.flavours[first.key]}</strong></legend>
              <div class="vars">
                {p.variants.map((v, i) => (
                  <label class="var" style={`--sw:${swatch(v.key)}`}>
                    <input type="radio" name="flavour" value={v.key} data-variant data-price={v.price ?? p.price} data-label={ui.flavours[v.key]} data-gtin={v.gtin || ''} data-src={variantSrc(v) || undefined} checked={i === 0} disabled={v.inStock === false} />
                    <span><i></i>{ui.flavours[v.key]}</span>
                  </label>
                ))}
              </div>
              <p class="tiny pdp__varnote">{p.variants.map((v) => `${ui.flavours[v.key]}: ${ui.flavourNotes[v.key]}`).join(' · ')}</p>
            </fieldset>
          )}

          {site.storefront.tiersOn && !isBundle && (
            <div class="tiers" data-tiers role="group" aria-label={ui.quantityDiscounts}>
              {[
                { qty: 1, pct: 0 },
                { qty: site.storefront.tier1Qty, pct: site.storefront.tier1Pct },
                { qty: site.storefront.tier2Qty, pct: site.storefront.tier2Pct },
              ].map((t, i) => (
                <button type="button" class={`tier ${i === 0 ? 'is-on' : ''}`} data-tier data-tier-qty={t.qty} data-tier-pct={t.pct} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <b>{t.qty} {t.qty === 1 ? 'pack' : 'packs'}</b>
                  <span class="tier__unit num" data-tier-unit>{formatPrice(((first.price ?? p.price) * (100 - t.pct)) / 100, locale)}</span>
                  <span class="tier__note">{t.pct ? `each · save ${t.pct}%` : 'each'}</span>
                </button>
              ))}
            </div>
          )}

          <div class="pdp__cta" data-buy-anchor>
            <div class="qty" role="group" aria-label={ui.quantity}>
              <button type="button" data-qty-dec aria-label={ui.decreaseShort}>−</button>
              <input data-qty-input type="number" min="1" max="99" value="1" inputmode="numeric" aria-label="Quantity" />
              <button type="button" data-qty-inc aria-label={ui.increaseShort}>+</button>
            </div>
            <button class="btn btn--lg btn--accent pdp__add" type="button" data-add={addPayload}>
              {ui.addToCartLong} <span class="pdp__add-sep" aria-hidden="true">—</span> <span class="num" data-price>{formatPrice(first.price ?? p.price, locale)}</span>
            </button>
          </div>

          {/* Revealed by the storefront sync when an override marks this product out of stock. */}
          <form class="restock" data-restock hidden>
            <p class="restock__t"><strong>Out of stock right now.</strong> Leave your e-mail and we will write to you the day the next batch is ready — nothing else.</p>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
            <div class="restock__row">
              <label class="sr-only" for="restock-email">E-mail</label>
              <input id="restock-email" type="email" name="email" required maxlength="160" autocomplete="email" placeholder="you@example.com" class="input" />
              <button class="btn" type="submit">{ui.notifyMe}</button>
            </div>
            <p class="restock__note" data-restock-note hidden></p>
          </form>

          <ul class="pdp__trust">
            <li><Icon name="check" size={17} /> Free shipping over {formatThreshold(site.shipping.freeFrom, locale)} · ships from Riga in 1–2 business days</li>
            {keepLine && <li><Icon name="check" size={17} /> {keepLine}</li>}
            <li><Icon name="check" size={17} /> {ingredientLine}</li>
            <li data-batch hidden><Icon name="check" size={17} /> <span data-batch-text></span></li>
          </ul>
          {site.storefront.guaranteeOn && (
            <p class="pdp__promise" data-guarantee>
              <Icon name="shield" size={18} /> <span data-guarantee-text>{site.storefront.guarantee}</span>
            </p>
          )}

          <!-- ============================== THE FOOD INFORMATION ==============================
               The particulars a distance sale must show before the purchase (Reg. 1169/2011
               art. 14). The pdp-inside__* classes and the data- markers are what
               scripts/check-food.mjs looks for. -->
          <section class="info" aria-labelledby="info-title">
            <h2 class="info__title" id="info-title">{ui.foodInformation}</h2>
            <dl class="facts">
              {legalNames.length > 0 && (
                <div>
                  <dt>{ui.facts.name}</dt>
                  {oneLegalName ? (
                    <dd data-legal-name>{legalNames[0].name}</dd>
                  ) : (
                    <dd data-legal-name>
                      <ul>{legalNames.map((l) => <li><span class="muted">{ui.flavours[l.key]}:</span> {l.name}</li>)}</ul>
                    </dd>
                  )}
                </div>
              )}
              <div>
                <dt>{ui.facts.ingredients}</dt>
                {/* Art. 18 wants the list headed by the word "ingredients": the row label shows it, and the list carries it too, so it is headed wherever it is read. */}
                <dd><p class="pdp-inside__ing"><span class="sr-only">{ui.ingredients} </span>{ingredientParts.map((part, i) => (i % 2 ? <strong class="pdp-inside__em">{part}</strong> : part))}</p></dd>
              </div>
              {allergenLines.length > 0 && (
                <div>
                  <dt>{ui.facts.allergens}</dt>
                  <dd>
                    <p class="pdp-inside__all">
                      {oneAllergenLine ? allergenLines[0].text : allergenLines.map((l) => <span class="pdp-inside__flv"><span class="muted">{ui.flavours[l.key]}:</span> {l.text}</span>)}
                    </p>
                  </dd>
                </div>
              )}
              <div>
                <dt>{ui.facts.nutrition}</dt>
                <dd>
                  <table class="nutri">
                    <thead><tr><th>{ui.typicalValues}</th>{nutriCols.map((c) => <th>{c.head}</th>)}</tr></thead>
                    <tbody>
                      {rows.map((r) => (
                        <tr class={r.sub ? 'sub' : ''}>
                          <td>{r.label}</td>
                          {r.cells.map((v) => <td>{v ?? <span class="nutri__nd">{ui.notDeclared}</span>}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="facts__note">
                    {hasKcal ? `Approximate per ${unitGrams} g: ${kcalPerUnit} kcal. ` : ''}
                    {isMixedBox ? 'Each product in the box carries its own nutrition declaration.' : 'Values per 100 g, from the producer’s product information.'}
                    {hasUndeclared && !isMixedBox ? ' A value not yet declared is missing from the information we have; it is not zero.' : ''}
                  </p>
                  {noAddedSugar && <p class="facts__note">{ui.naturalSugars}</p>}
                </dd>
              </div>
              {netLine && (
                <div>
                  <dt>{ui.facts.net}</dt>
                  <dd>{netLine}</dd>
                </div>
              )}
              {p.storage && (
                <div>
                  <dt>{ui.facts.storage}</dt>
                  <dd data-storage>{p.storage}</dd>
                </div>
              )}
              {p.shelfLifeMonths != null && !storageNamesMonths && (
                <div>
                  <dt>{ui.facts.shelf}</dt>
                  <dd>{ui.months(p.shelfLifeMonths)}</dd>
                </div>
              )}
              {operatorLine && (
                <div>
                  <dt>{ui.facts.operator}</dt>
                  <dd data-operator>{operatorLine}</dd>
                </div>
              )}
              {multi && (
                <div>
                  <dt>{ui.facts.ean}</dt>
                  <dd><span class="sr-only">{ui.eanForFlavour} </span><span data-gtin translate="no">{first.gtin || '—'}</span></dd>
                </div>
              )}
            </dl>
          </section>
        </div>
      </div>
    </div>

    <!-- ============================== THE LABEL IN THREE NUMBERS ============================== -->
    {labelCells.length > 0 && (
      <section class="container" aria-labelledby="three-title">
        <div class="three" style={`--cells:${labelCells.length}`}>
          <h2 class="three__title" id="three-title">The whole label, in three numbers.</h2>
          {labelCells.map((c) => (
            <div class="three__cell">
              <b class={`three__n num ${c.em ? 'is-on' : ''}`}>{c.n}</b>
              <span class="three__l">{c.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ============================== ABOUT IT ============================== -->
    <section class="container about" aria-labelledby="about-title">
      <div class="about__grid">
        <div>
          <h2 id="about-title" class="about__title">{p.name}</h2>
          <div class="pdp__desc prose">
            {p.description.map((d) => <p>{d}</p>)}
          </div>
        </div>
        <div class="acc pdp__acc">
          <details>
            <summary>{ui.shippingReturnsTitle}</summary>
            <div class="acc__body">
              <p>{site.shipping.note} Free shipping over {formatThreshold(site.shipping.freeFrom, locale)}; otherwise a flat €3.90 in the Baltics; EU courier rates are confirmed by e-mail. We ship to {site.shipping.regions.slice(0, 3).join(', ')} and the rest of the EU.</p>
              <p>Damaged in transit? Send us a photo within 48 hours and we replace it. <a href="/legal/shipping-returns/">{ui.fullPolicy}</a>.</p>
            </div>
          </details>
          {isBundle && (
            <details>
              <summary>{ui.whatsInTheBox}</summary>
              <div class="acc__body"><p>{p.summary}</p></div>
            </details>
          )}
        </div>
      </div>
    </section>

    {site.storefront.reviewsOn && (
      <section class="pdp__reviews section--tight container" data-reviews aria-labelledby="pdp-reviews-title">
        <div class="pdp__revhead">
          <h2 id="pdp-reviews-title">{ui.reviewsTitle}</h2>
          <p class="pdp__revsum" data-review-summary hidden></p>
        </div>
        <div class="pdp__revbody">
          <div>
            <div data-review-list></div>
            <p class="muted" data-review-empty hidden>{ui.noReviewsYet(p.name)}</p>
          </div>
          <details class="revform">
            <summary>{ui.writeReview}</summary>
            <form data-review-form novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
              <div class="revform__row">
                <label>
                  Rating
                  <select name="rating" required class="select">
                    <option value="5">5 — excellent</option>
                    <option value="4">4 — good</option>
                    <option value="3">3 — fine</option>
                    <option value="2">2 — poor</option>
                    <option value="1">1 — bad</option>
                  </select>
                </label>
                <label>{ui.yourName}<input type="text" name="author" required maxlength="60" autocomplete="name" class="input" /></label>
                <label>City <span class="muted">(optional)</span><input type="text" name="city" maxlength="60" class="input" /></label>
              </div>
              <label>Headline <span class="muted">(optional)</span><input type="text" name="title" maxlength="120" class="input" /></label>
              <label>{ui.yourReview}<textarea name="body" required minlength="10" maxlength="2000" rows="4" class="textarea"></textarea></label>
              <label>E-mail <span class="muted">(not published — only so we can reply)</span><input type="email" name="email" maxlength="160" autocomplete="email" class="input" /></label>
              <p class="tiny muted">We read every review before it appears, so it will not show up straight away.</p>
              <button class="btn" type="submit">Send review</button>
              <p class="revform__note" data-review-note hidden></p>
            </form>
          </details>
        </div>
      </section>
    )}

    <section class="section--tight container" aria-labelledby="rel-title">
      <div class="section-head">
        <h2 id="rel-title">Pairs well with</h2>
        <a class="link" href="/shop/">All products</a>
      </div>
      <div class="grid pdp__related">
        {related.map((r) => <ProductCard product={r} compact />)}
        <a class="boxtile" href="/shop/build-your-box/">
          <span class="boxtile__six" aria-hidden="true">6</span>
          <span class="boxtile__body">
            <span class="eyebrow">Build your box</span>
            <span class="boxtile__title">Pick six bars, save 10%.</span>
            <span class="boxtile__cta">Start building <Icon name="arrow" size={18} class="arrow" /></span>
          </span>
        </a>
      </div>
    </section>

    <section class="section--tight container pdp__faq" aria-labelledby="pdp-faq-title">
      <div class="pdp__faq-grid">
        <div>
          <p class="eyebrow">{p.name}</p>
          <h2 id="pdp-faq-title">Questions people ask.</h2>
          <p class="muted mt-2">More in the <a href="/faq/">full FAQ</a>, or <a href="/contact/">write to us</a>.</p>
        </div>
        <div class="acc">
          {faqs.map((f) => (
            <details><summary>{f.q}</summary><div class="acc__body"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>
  </article>

  <div class="sticky-buy" data-sticky-buy>
    <div class="sticky-buy__in container">
      <img class="sticky-buy__img" src={gallery[0].small} alt="" width="48" height="48" loading="lazy" />
      <div class="sticky-buy__t"><strong>{p.title}</strong><span><span data-price>{formatPrice(first.price ?? p.price, locale)}</span> · <span data-variant-name>{ui.flavours[first.key]}</span></span></div>
      <button class="btn btn--accent" type="button" data-add={addPayload}>{ui.addToBox}</button>
    </div>
  </div>
</Base>

<style>
  /* ------------------------------------------------------------- the product */
  .stage { display: grid; gap: clamp(1.5rem, 4vw, 3.75rem); padding-block: 1.25rem clamp(2.5rem, 5vw, 3.5rem); }
  @media (min-width: 55.01rem) {
    .stage { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; }
    .stage__gal { position: sticky; top: calc(var(--hdr-h) + 1.25rem); }
  }
  .stage__buy { min-width: 0; }

  /* The gallery: the pack on its own tint, the other photographs as a row of thumbnails beneath. */
  .gal__main { box-shadow: var(--lift); }
  .gal__main img { position: absolute; inset: 0; }
  .gal__thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; }
  .gal__thumbs button { width: auto; }

  /* ------------------------------------------------------------- buy panel */
  .buy .eyebrow a { text-decoration: none; color: inherit; }
  .buy .eyebrow a:hover { color: var(--cream-0); text-decoration: underline; }
  .pdp__title { margin: 0.9rem 0 0.6rem; font-size: clamp(2.125rem, 1.4rem + 3vw, 3.125rem); line-height: 1; }
  .pdp__sub { margin: 0 0 0.4rem; font-size: 0.9375rem; color: var(--fg-2); }
  .pdp__lead { margin: 0 0 1.4rem; font-size: 1.0625rem; line-height: 1.55; color: var(--fg-2); }

  /* The claims the pack prints: small green chips with a tick. */
  .claims { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.4rem; padding: 0; }
  .claims li { display: inline-flex; align-items: center; gap: 0.45em; min-height: 2rem; padding: 0 0.8rem; border-radius: var(--r-pill); background: var(--leaf-100); color: #2f4a1c; font-size: 0.8125rem; font-weight: 700; }
  .claims :global(svg) { color: var(--leaf-500); }

  .pdp__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.75rem; margin: 0 0 1.5rem; }
  .pdp__amount { font-family: var(--font-display); font-size: 2.375rem; font-weight: 500; letter-spacing: -0.025em; line-height: 1; color: var(--cream-0); }
  /* A sum in words beside the price, set small: it is a comparison, not a second price. */
  .pdp__was { font-size: var(--fs-sm); color: var(--fg-3); }
  .pdp__unit { flex-basis: 100%; font-size: 0.8125rem; color: var(--fg-3); }

  .pdp__vars { border: 0; padding: 0; margin: 0 0 1.5rem; min-width: 0; }
  .pdp__vars legend { font-size: 0.8125rem; font-weight: 700; color: var(--cream-0); margin-bottom: 0.6rem; padding: 0; }
  .pdp__vars legend strong { font-weight: 400; color: var(--fg-2); }
  .pdp__varnote { margin: 0.6rem 0 0; color: var(--fg-3); }

  .tiers { margin: 0 0 1.25rem; gap: 0.4rem; }

  /*
   * Flex with a wrap: a grid's `auto` track shrinks under a `1fr` neighbour and
   * the stepper, which clips its own overflow, once had the add button drawn
   * across its "+". A long Latvian button label is enough to do that at 390px.
   */
  .pdp__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: stretch; }
  .pdp__cta .qty { flex: 0 0 auto; min-width: max-content; height: auto; min-height: 3.625rem; grid-template-columns: 3rem 2.25rem 3rem; }
  .pdp__cta .qty button { min-height: 3.625rem; }
  .pdp__cta .pdp__add { flex: 1 1 15rem; min-height: 3.625rem; }
  /*
   * A small phone: "Добавить в корзину — 14,90 €" is wider than the column at
   * the large button's padding. The padding narrows first, and a label longer
   * still wraps inside the button rather than running off the screen. The type
   * stays at 19 px, which white on the orange needs.
   */
  @media (max-width: 26rem) {
    .pdp__cta .pdp__add { min-width: 0; padding-inline: 1em; white-space: normal; text-align: center; }
  }
  .pdp__add:global(.is-done) { --btn-bg: var(--leaf-500); --btn-fg: #fff; box-shadow: none; }

  .pdp__trust { list-style: none; display: grid; gap: 0.4rem; margin: 1.1rem 0 0; padding: 0; font-size: var(--fs-sm); color: var(--leaf-500); }
  .pdp__trust li { display: flex; gap: 0.55em; align-items: flex-start; }
  .pdp__trust :global(svg) { flex: none; margin-top: 0.15em; }
  .restock { margin-top: 1.25rem; }
  .restock .btn { min-height: 3.2rem; }

  /* ------------------------------------------------------------- the facts list */
  .info { margin-top: 1.5rem; }
  .info__title { margin: 0 0 0.6rem; font-family: var(--font-sans); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0; color: var(--cream-0); }
  .facts { margin: 0; background: var(--bg-raised); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
  .facts > div { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; padding: 0.95rem 1.35rem; border-bottom: 1px solid var(--line-2); }
  .facts > div:last-child { border-bottom: 0; }
  .facts dt { flex: none; width: 6.75rem; margin: 0; font-size: 0.8125rem; color: var(--fg-3); }
  .facts dd { flex: 1; min-width: 11.25rem; margin: 0; font-size: var(--fs-sm); line-height: 1.5; color: #2a3226; }
  .facts dd p { margin: 0; }
  .facts dd ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
  /* The allergen inside the list, in bold (Reg. 1169/2011 art. 21). */
  .pdp-inside__em { font-weight: 700; color: var(--cream-0); }
  /* One line per flavour where the card words the allergen differently for each. */
  .pdp-inside__flv { display: block; }
  .facts .nutri { width: 100%; }
  .facts .nutri th { font-size: var(--fs-xs); font-weight: 700; color: var(--fg-3); }
  .facts .nutri td:not(:first-child), .facts .nutri th:not(:first-child) { text-align: right; padding-left: 0.75rem; }
  /* Where there is room, a figure stays on one line ("1560 kJ / 370 kcal") and the row label wraps instead. */
  @media (min-width: 34.01rem) { .facts .nutri td:not(:first-child) { white-space: nowrap; } }
  /*
   * Phones: the label above its value, as on the approved shop. Side by side,
   * a meringue's two flavour columns were wider than the value cell and the
   * card's rounded clip cut the second one off.
   */
  @media (max-width: 34rem) {
    .facts > div { display: block; padding-inline: 1.1rem; }
    .facts dt { width: auto; margin-bottom: 0.35rem; }
  }
  /* "Not yet declared" must be visible, but must not read as a figure. */
  .nutri__nd { font-size: var(--fs-xs); color: var(--fg-3); }
  .facts__note { margin-top: 0.6rem !important; font-size: var(--fs-xs); color: var(--fg-3); }

  /* ------------------------------------------------------------- the label in three numbers */
  .three { display: grid; grid-template-columns: 14.375rem repeat(var(--cells, 3), minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: center; padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.25rem, 4vw, 3rem); border-radius: var(--r-xl); background: var(--bg-sunken); }
  .three__title { margin: 0; font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 400; letter-spacing: 0; line-height: 1.4; color: var(--fg-2); }
  /* Outlined, as on the approved design: ink for the figures, orange for the weight. */
  .three__n { display: block; font-family: var(--font-display); font-weight: 500; font-size: clamp(2.375rem, 5.4vw, 3.625rem); line-height: 0.95; letter-spacing: -0.035em; color: transparent; -webkit-text-stroke: 1.4px var(--cream-0); white-space: nowrap; }
  .three__n.is-on { -webkit-text-stroke-color: var(--accent-ink); }
  @supports not (-webkit-text-stroke: 1px black) { .three__n { color: var(--cream-0); } .three__n.is-on { color: var(--accent-ink); } }
  .three__l { display: block; margin-top: 0.5rem; font-size: var(--fs-sm); color: var(--fg-2); }
  @media (max-width: 55rem) { .three { grid-template-columns: repeat(var(--cells, 3), minmax(0, 1fr)); } .three__title { grid-column: 1 / -1; } }
  @media (max-width: 30rem) { .three__n { font-size: clamp(1.75rem, 9vw, 2.375rem); } }

  /* ------------------------------------------------------------- about */
  .about { padding-block: clamp(2.5rem, 5vw, 3.75rem) 0; }
  .about__grid { display: grid; gap: 2rem; }
  @media (min-width: 55.01rem) { .about__grid { grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); } }
  .about__title { font-size: var(--fs-2xl); margin-bottom: 1rem; }
  .pdp__desc p:first-child { font-size: var(--fs-lg); color: var(--cream-1); }

  /* ------------------------------------------------------------- reviews */
  .pdp__reviews { margin-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  /* No reviews yet: one quiet band — the sentence on the left, the invitation as a button on the right. */
  .pdp__reviews:has([data-review-empty]:not([hidden])) .pdp__revhead { margin-bottom: 1rem; }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .pdp__revhead h2 { font-size: var(--fs-2xl); }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .pdp__revbody { grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 2rem; align-items: center; padding: 1.1rem 0; border-block: 1px solid var(--line); }
  .pdp__reviews:has([data-review-empty]:not([hidden])) [data-review-empty] { margin: 0; }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform { border: 0; padding: 0; background: none; border-radius: 0; }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform > summary { display: inline-flex; align-items: center; justify-content: center; gap: 0.6em; min-height: 2.75rem; padding: 0.55em 1.25em; border: 1px solid var(--night-500); border-radius: var(--r-pill); background: var(--bg-raised); font-family: var(--font-sans); font-size: var(--fs-sm); font-weight: 700; color: var(--cream-0); cursor: pointer; transition: border-color var(--dur-fast); }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform > summary:hover { border-color: var(--cream-0); }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform > summary::after { font-size: 1.2em; color: inherit; }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform[open] { grid-column: 1 / -1; padding-top: 0.5rem; }
  .pdp__reviews:has([data-review-empty]:not([hidden])) .revform[open] > summary { margin-bottom: 0.5rem; }
  @media (max-width: 40rem) { .pdp__reviews:has([data-review-empty]:not([hidden])) .pdp__revbody { grid-template-columns: minmax(0, 1fr); } }
  .pdp__revhead { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .pdp__revsum { font-size: var(--fs-md); }
  .pdp__revbody { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 56rem) { .pdp__revbody { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
  .pdp__revbody :global(.rev:first-child) { border-top: 0; }
  .revform { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.25rem 1.5rem; background: var(--bg-raised); }
  .revform > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: var(--fs-lg); font-weight: 700; list-style: none; }
  .revform > summary::-webkit-details-marker { display: none; }
  .revform > summary::after { content: '+'; content: '+' / ''; font-size: 1.4em; font-weight: 400; line-height: 1; color: var(--accent-ink); transition: transform var(--dur) var(--ease-out); }
  .revform[open] > summary::after { transform: rotate(45deg); }
  .revform :global(form) { max-width: none; padding-top: 1rem; }

  /* ------------------------------------------------------------- related & faq */
  /* Four fixed tracks — three products and the box tile — so the row is always complete and the cards never balloon. */
  .pdp__related { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.375rem; }
  @media (max-width: 56rem) { .pdp__related { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; } }
  /* On a phone the row becomes a strip that scrolls sideways; the cut-off card is the hint. */
  @media (max-width: 40rem) {
    .pdp__related { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0.75rem; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); padding-bottom: 0.5rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .pdp__related::-webkit-scrollbar { display: none; }
    .pdp__related > :global(*) { flex: 0 0 72vw; min-width: 0; scroll-snap-align: start; }
  }
  .boxtile { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-height: 100%; padding: 1.4rem; border-radius: var(--r-lg); overflow: clip; text-decoration: none; color: var(--cream-0); background: var(--bg-sunken); border: 1px solid var(--line); transition: transform var(--dur) ease, box-shadow var(--dur) ease; }
  .boxtile:hover { transform: translateY(-4px); box-shadow: var(--lift); }
  .boxtile__six { position: absolute; right: -0.05em; top: -0.12em; z-index: -1; font-family: var(--font-display); font-weight: 500; font-size: clamp(9rem, 18vw, 15rem); line-height: 0.8; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1px rgb(20 26 18 / 0.18); pointer-events: none; }
  .boxtile__body { display: grid; gap: 0.6rem; }
  .boxtile__title { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-2xl); line-height: 1; letter-spacing: -0.025em; max-width: 9ch; }
  .boxtile__cta { display: inline-flex; align-items: center; gap: 0.4em; margin-top: 0.4rem; font-weight: 700; font-size: var(--fs-sm); }
  @media (max-width: 40rem) { .boxtile { aspect-ratio: 4 / 5; } }
  @media (prefers-reduced-motion: reduce) { .boxtile:hover { transform: none; } }
  .pdp__faq { border-top: 1px solid var(--line); margin-top: clamp(1rem, 3vw, 2rem); }
  .pdp__faq-grid { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .pdp__faq-grid { grid-template-columns: 1fr 1.4fr; gap: 4rem; } }
  .pdp__faq h2 { margin-top: 0.8rem; }

  /* ------------------------------------------------------------- sticky bar */
  .sticky-buy__t strong { font-weight: 700; font-size: var(--fs-md); }
  .sticky-buy .btn { min-height: 2.9rem; padding-inline: 1.3em; }
  /* A long localised button must not crush the title to one syllable. */
  @media (max-width: 30rem) {
    .sticky-buy__in { gap: 0.75rem; }
    .sticky-buy__t strong { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: var(--fs-sm); line-height: 1.2; }
    .sticky-buy__t > span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sticky-buy .btn { padding-inline: 1em; }
  }
</style>
