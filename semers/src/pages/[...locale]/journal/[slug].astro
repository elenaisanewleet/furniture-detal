---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { ARTICLES, ARTICLES_SORTED, type Article } from '~/data/journal';
import { im, SIZES } from '~/data/images';
import { site } from '~/data/site';
import { formatThreshold } from '~/data/products';
import { article as articleSchema } from '~/lib/schema';
import { originOf } from '~/lib/origin';
import { withLocales } from '~/i18n/config';
import type { Locale } from '~/i18n/config';

export function getStaticPaths() {
  return withLocales(ARTICLES.map((a) => ({ params: { slug: a.slug }, props: { article: a } })));
}

const { locale } = Astro.props as { locale: Locale };
const { article: a } = Astro.props as { article: Article };
const origin = originOf(Astro.site);
const href = `/journal/${a.slug}/`;
const canonicalUrl = `${origin}${href}`;
const freeFrom = formatThreshold(site.shipping.freeFrom, locale);
const hero = im(a.image);

/* ---- Body: written separately into src/data/articles/<slug>.ts. Never crash if it is not there yet. ---- */
const bodies = import.meta.glob('../../data/articles/*.ts', { eager: true, import: 'default' }) as Record<string, unknown>;
const bodyKey = Object.keys(bodies).find((k) => k.endsWith(`/${a.slug}.ts`));
const loaded = bodyKey ? bodies[bodyKey] : undefined;
const rawBody = typeof loaded === 'string' && loaded.trim() ? loaded : a.body || '';
const hasBody = rawBody.trim().length > 0;

/* ---- Table of contents: give every <h2> in the body an id and collect the labels. ---- */
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/&[a-z#0-9]+;/g, ' ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const toc: { id: string; label: string }[] = [];
const seen = new Set<string>();
const withIds = hasBody
  ? rawBody.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/gi, (_m: string, attrs: string | undefined, inner: string) => {
      const at = attrs || '';
      const label = inner.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      const existing = at.match(/\sid=["']([^"']+)["']/);
      let id = existing ? existing[1] : slugify(label) || 'section';
      const base = id;
      let n = 2;
      while (seen.has(id)) id = `${base}-${n++}`;
      seen.add(id);
      toc.push({ id, label });
      return existing ? `<h2${at}>${inner}</h2>` : `<h2${at} id="${id}">${inner}</h2>`;
    })
  : '';
/* A wide table scrolls inside its own box on a phone instead of pushing the page sideways. Content untouched. */
const body = withIds.replace(/<table(\s[^>]*)?>/gi, '<div class="art__table"><table$1>').replace(/<\/table>/gi, '</table></div>');
const showToc = toc.length >= 2;

/* ---- Meta ---- */
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${MONTHS[(m || 1) - 1]} ${y}`;
};
const dateLabel = fmtDate(a.date);
const readLabel = `${a.readMinutes} min read`;
const tagLine = a.tags.join(' · ');

/** <title> must stay within 60 characters including the " — Semers" suffix (51 for the page part); article headlines are longer than that on purpose. */
const SEO_TITLES: Record<string, string> = {
  'what-is-pastila': 'What is pastila? A two-ingredient baked-apple sweet',
  'healthy-snacks-no-added-sugar': 'Healthy snacks with no added sugar: read the label',
  'antonovka-apples': 'Why Antonovka apples? The sour apple in every bar',
};
const shortTitle = (t: string) => {
  if (t.length <= 51) return t;
  const clause = t.match(/^(.{12,50}?[?:.])\s/);
  if (clause) return clause[1];
  return `${t.slice(0, 49).replace(/\s+\S*$/, '')}…`;
};
const pageTitle = SEO_TITLES[a.slug] ?? shortTitle(a.title);

/** Meta descriptions 120–155 chars; the card description is allowed to run longer. */
const SEO_DESC: Record<string, string> = {
  'what-is-pastila': 'Pastila is a baked-apple sweet from Belyov: apple purée whipped with egg white, dried in thin layers. Where it comes from and why it needs no added sugar.',
  'healthy-snacks-no-added-sugar': 'Most “sugar-free” snack bars hide syrups, sweeteners or fruit concentrates. How to read an ingredient list properly, and a short list of snacks that pass.',
  'antonovka-apples': 'Antonovka is a hardy, tart, aromatic apple from the north. Its pectin and acidity are exactly what pastila needs. Why we will not bake with anything else.',
};
const trimDesc = (d: string) => {
  if (d.length <= 155) return d;
  const head = d.slice(0, 155);
  const stop = Math.max(head.lastIndexOf('. '), head.lastIndexOf('.'));
  if (stop >= 119) return head.slice(0, stop + 1);
  return `${d.slice(0, 152).replace(/\s+\S*$/, '')}…`;
};
const pageDesc = SEO_DESC[a.slug] ?? trimDesc(a.description);

/* ---- Share ---- */
const mailShare = `mailto:?subject=${encodeURIComponent(a.title)}&body=${encodeURIComponent(canonicalUrl)}`;
const waShare = `https://wa.me/?text=${encodeURIComponent(`${a.title} ${canonicalUrl}`)}`;

/* ---- Related ---- */
const others = ARTICLES_SORTED.filter((x) => x.slug !== a.slug).slice(0, 3);
const hasOthers = others.length > 0;

/** The product most of the journal is about; used in the panel after the body. */
const shopcard = im('packshot-classic');
const facts = ['99% baked Antonovka apples, 1% egg white', 'No added sugar, no flour, no gluten', 'About 97 kcal per 35 g bar', 'Keeps 12 months without a fridge'];
---
<Base
  title={pageTitle}
  description={pageDesc}
  canonical={href}
  ogImage={a.image}
  ogType="article"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Journal', href: '/journal/' }, { name: a.title, href }]}
  schema={[articleSchema(origin, { title: a.title, description: a.description, href, date: a.date, image: a.image })]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={a.date} />
    <meta property="article:modified_time" content={a.date} />
    {a.tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>
  <!-- A hairline of light along the top edge that fills as the reader gets through the piece. -->
  <div class="art__progress" aria-hidden="true" data-progress><i></i></div>

  <article class="art">
    <!-- ============================== HEADER ============================== -->
    <!-- Big title, dek, meta. The photograph follows full-bleed, so the header is the only thing on the first screen. -->
    <header class="page-hero container art__head">
      <p class="eyebrow">{tagLine}</p>
      <h1 id="page-title" class="art__title" data-words>{a.title}</h1>
      <div class="art__headrow">
        <p class="art__dek">{a.description}</p>
        <p class="art__meta">
          <time datetime={a.date}>{dateLabel}</time>
          <span class="art__dot" aria-hidden="true">·</span>
          <span><Icon name="clock" size={16} /> {readLabel}</span>
          <span class="art__dot" aria-hidden="true">·</span>
          <span>{site.brand.name}, {site.locality}</span>
        </p>
      </div>
    </header>

    <!-- ============================== HERO IMAGE ============================== -->
    <div class="art__hero" data-reveal>
      <div class="art__hero-media">
        <img src={hero.src} srcset={hero.srcset} sizes={hero.srcset && SIZES.full} alt={hero.alt} width={hero.width} height={hero.height} loading="eager" fetchpriority="high" decoding="async" data-parallax="0.2" />
      </div>
    </div>

    <!-- ============================== BODY + RAIL ============================== -->
    <div class="container art__grid">
      <div class="art__body">
        {hasBody ? (
          <div class="prose art__prose" set:html={body} />
        ) : (
          <div class="prose art__prose">
            <p class="lead">{a.description}</p>
            <p class="muted">Full article coming shortly.</p>
          </div>
        )}

        <footer class="art__foot">
          <ul class="cluster art__tags" aria-label="Topics">
            {a.tags.map((t) => <li class="chip">{t}</li>)}
          </ul>
          <div class="cluster">
            <button class="btn btn--ghost btn--sm" type="button" data-copy={canonicalUrl}>Copy link</button>
            <a class="link small" href="/journal/">All articles</a>
          </div>
        </footer>
      </div>

      <aside class="art__rail">
        {showToc && (
          <nav class="toc" aria-labelledby="toc-title">
            <p class="eyebrow" id="toc-title">In this article</p>
            <ol>
              {toc.map((t) => (
                <li><a href={`#${t.id}`} data-toc-link={t.id} set:html={t.label} /></li>
              ))}
            </ol>
          </nav>
        )}
        <div class="art__share">
          <p class="eyebrow">Share</p>
          <div class="art__share-row">
            <button class="art__share-btn" type="button" data-copy={canonicalUrl}><Icon name="check" size={16} /> Copy link</button>
            <a class="art__share-btn" href={mailShare}><Icon name="mail" size={16} /> E-mail</a>
            <a class="art__share-btn" href={waShare} rel="noopener">WhatsApp</a>
          </div>
        </div>
      </aside>
    </div>

    <!-- ============================== THE PRODUCT ============================== -->
    <!-- The bar the journal keeps talking about, as one lit panel: the packshot on a mint field, the facts, one button. -->
    <section class="container art__shopwrap" aria-labelledby="shop-title">
      <div class="art__shop" data-reveal>
        <div class="art__shop-img"><img src={shopcard.src} srcset={shopcard.srcset} sizes={shopcard.srcset && SIZES.third} alt="" width={shopcard.width} height={shopcard.height} loading="lazy" decoding="async" /></div>
        <div class="art__shop-body">
          <p class="eyebrow">From the bakery</p>
          <h2 id="shop-title" class="art__shop-title">The bar these notes are about.</h2>
          <ul class="ticks art__shop-ticks">
            {facts.map((f) => <li><Icon name="check" size={16} /> {f}</li>)}
          </ul>
          <div class="cluster art__shop-cta">
            <a class="btn btn--accent" href="/shop/apple-bars/">Shop apple bars <Icon name="arrow" size={18} class="arrow" /></a>
            <a class="link small" href="/shop/">See everything in the shop</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== ALSO READ ============================== -->
    {hasOthers && (
      <section class="section band art__also" aria-labelledby="also-title">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Also read</p>
              <h2 id="also-title">Keep <em>reading.</em></h2>
            </div>
            <a class="link" href="/journal/">Back to the journal</a>
          </div>
        </div>
        <div class="art__rel" data-stagger>
          {others.map((o) => (
            <a class="jc art__rel-card" href={`/journal/${o.slug}/`} data-cursor="Read">
              <div class="frame frame--3x2"><img src={im(o.image).src} srcset={im(o.image).srcset} sizes={im(o.image).srcset && SIZES.third} alt="" width={im(o.image).width} height={im(o.image).height} loading="lazy" decoding="async" /></div>
              <p class="eyebrow art__rel-eyebrow">{o.readMinutes} min read</p>
              <h3>{o.title}</h3>
              <p>{o.description}</p>
              <time class="jc__meta" datetime={o.date}>{fmtDate(o.date)}</time>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ============================== CTA ============================== -->
    <section class="section container art__end" aria-labelledby="cta-title">
      <div class="cta-band" data-reveal>
        <p class="eyebrow">Taste the subject</p>
        <h2 id="cta-title">Reading about apples is the slow way to find out.</h2>
        <p>Apple bars, meringues and Belyov pastila, baked in {site.locality} from two ingredients. Parcels leave in 1–2 business days and ship across the EU; orders over {freeFrom} ship free.</p>
        <div class="cluster mt-2">
          <a class="btn btn--paper" href="/shop/">Shop all products <Icon name="arrow" size={18} class="arrow" /></a>
          <a class="btn btn--ghost" href="/why-pastila/">Why pastila</a>
          <a class="link cta-band__link" href="/how-its-made/">How it’s made</a>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  /* Reading progress along the top edge, and the rail lighting the section under the reader. Both cosmetic; the page reads without them. */
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('.art__prose');
  if (bar && prose) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = prose.getBoundingClientRect();
      const span = r.height - innerHeight * 0.5;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 1;
      bar.style.setProperty('--p', String(p));
      bar.classList.toggle('is-on', r.top < innerHeight * 0.9 && p < 1);
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const heads = links.map((l) => document.getElementById(l.dataset.tocLink || '')).filter((h): h is HTMLElement => Boolean(h));
  if (links.length && heads.length && 'IntersectionObserver' in window) {
    const set = (id: string) => links.forEach((l) => (l.dataset.tocLink === id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
    let current = '';
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) current = (e.target as HTMLElement).id;
        if (current) set(current);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );
    heads.forEach((h) => io.observe(h));
  }
</script>

<style>
  /* ------------------------------------------------------------ progress */
  .art__progress { position: fixed; left: 0; right: 0; top: 0; z-index: 60; height: 2px; pointer-events: none; opacity: 0; transition: opacity var(--dur); }
  .art__progress.is-on { opacity: 1; }
  .art__progress i { display: block; height: 100%; width: 100%; background: var(--accent); box-shadow: 0 0 12px var(--accent); transform: scaleX(var(--p, 0)); transform-origin: left; }

  /* ------------------------------------------------------------ header */
  .art__head { padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  .art__title { font-size: var(--fs-3xl); line-height: 0.98; letter-spacing: -0.035em; max-width: 20ch; margin-top: 0.75rem; color: var(--cream-0); text-wrap: balance; font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1; }
  @media (min-width: 72rem) { .art__title { font-size: clamp(3.5rem, 2rem + 4.2vw, 6rem); } }
  .art__headrow { display: grid; gap: 1.5rem; align-items: end; margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 56rem) { .art__headrow { grid-template-columns: minmax(0, 1fr) auto; gap: 4rem; } }
  .art__dek { margin: 0; max-width: 56ch; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-xl); line-height: 1.3; letter-spacing: -0.01em; color: var(--cream-2); font-variation-settings: 'opsz' 48, 'SOFT' 50; }
  .art__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.6rem; margin: 0; font-size: var(--fs-sm); color: var(--fg-3); }
  .art__meta span { display: inline-flex; align-items: center; gap: 0.35em; }
  .art__meta time { color: var(--cream-1); font-weight: 600; }
  .art__dot { opacity: 0.6; }

  /* ------------------------------------------------------------ hero: a lit window as wide as the page */
  .art__hero { position: relative; isolation: isolate; overflow: clip; height: min(72svh, 46rem); min-height: 22rem; background: var(--night-800); }
  .art__hero-media { position: absolute; inset: -12% 0; z-index: 0; }
  .art__hero-media img { width: 100%; height: 100%; object-fit: cover; }
  .art__hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to bottom, var(--night-900) 0%, transparent 18%, transparent 70%, var(--night-900) 100%); pointer-events: none; }
  @media (max-width: 48rem) { .art__hero { height: auto; aspect-ratio: 4 / 5; min-height: 0; } }

  /* ------------------------------------------------------------ body grid. DOM: prose, then the rail (TOC + share). Narrow screens read TOC, prose, share. */
  .art__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); padding-block: clamp(2.5rem, 6vw, 5rem); }
  .art__rail { display: contents; }
  .toc { order: 1; }
  .art__body { order: 2; min-width: 0; }
  .art__share { order: 3; }
  @media (min-width: 64rem) {
    .art__grid { grid-template-columns: minmax(0, 1fr) 17rem; gap: clamp(3rem, 7vw, 8rem); align-items: start; }
    .art__body { order: 0; }
    .art__rail { display: grid; gap: 2rem; position: sticky; top: 6rem; order: 1; }
  }

  /* the rail */
  .toc { padding: 1.1rem 1.25rem 1rem; border-radius: var(--r-lg); background: rgb(11 18 14 / 0.62); backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%); border: 1px solid var(--line); }
  .toc ol { margin: 0.9rem 0 0; padding: 0; list-style: none; counter-reset: toc; display: grid; }
  .toc li { counter-increment: toc; }
  .toc a { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); align-items: baseline; gap: 0.5rem; min-height: 2.6rem; padding: 0.55rem 0; border-top: 1px solid var(--line); font-size: var(--fs-sm); line-height: 1.3; text-decoration: none; color: var(--fg-2); transition: color var(--dur-fast); }
  .toc li:first-child a { border-top: 0; }
  .toc a::before { content: counter(toc, decimal-leading-zero); font-family: var(--font-display); font-size: var(--fs-xs); letter-spacing: 0.06em; color: var(--fg-3); font-variant-numeric: tabular-nums; transition: color var(--dur-fast); }
  .toc a:hover { color: var(--cream-0); }
  .toc a[aria-current="true"] { color: var(--cream-0); }
  .toc a[aria-current="true"]::before { color: var(--accent); text-shadow: 0 0 12px var(--accent); }
  .art__share { display: grid; gap: 0.75rem; }
  .art__share-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .art__share-btn { display: inline-flex; align-items: center; gap: 0.45em; min-height: 2.75rem; padding: 0.5rem 1rem; border-radius: var(--r-pill); border: 1px solid rgb(243 233 214 / 0.25); background: transparent; color: var(--cream-1); font: inherit; font-size: var(--fs-sm); font-weight: 600; text-decoration: none; cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast); }
  .art__share-btn:hover { background: var(--cream-1); color: var(--night-900); border-color: var(--cream-1); }
  .art__share-btn :global(svg) { color: var(--accent); transition: color var(--dur-fast); }
  .art__share-btn:hover :global(svg) { color: var(--night-900); }

  /* ------------------------------------------------------------ prose: a 65ch measure, generous leading, a drop cap, numbered chapters, pull quotes at display size */
  .art__prose { max-width: 65ch; font-size: var(--fs-lg); line-height: 1.7; color: var(--fg-2); counter-reset: chapter; }
  .art__prose :global(p) { margin-bottom: 1.25em; }
  .art__prose > :global(p:first-of-type)::first-letter { float: left; font-family: var(--font-display); font-weight: 500; font-size: 4.4em; line-height: 0.78; padding: 0.06em 0.12em 0 0; margin-bottom: -0.1em; color: var(--accent); font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1; }
  .art__prose :global(h2) { counter-increment: chapter; margin-top: 2.4em; margin-bottom: 0.6em; font-size: var(--fs-2xl); line-height: 1.02; letter-spacing: -0.025em; color: var(--cream-0); scroll-margin-top: 6rem; text-wrap: balance; }
  .art__prose :global(h2)::before { content: counter(chapter, decimal-leading-zero); display: block; margin-bottom: 0.7rem; font-family: var(--font-sans); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.16em; color: var(--accent-ink); font-variant-numeric: tabular-nums; }
  .art__prose :global(h3) { margin-top: 1.8em; margin-bottom: 0.5em; font-size: var(--fs-xl); color: var(--cream-0); scroll-margin-top: 6rem; }
  .art__prose :global(a) { color: var(--cream-1); text-decoration-color: var(--accent); text-underline-offset: 0.16em; }
  .art__prose :global(a:hover) { color: var(--accent-ink); }
  .art__prose :global(strong) { color: var(--cream-0); }
  .art__prose :global(ul), .art__prose :global(ol) { padding-left: 1.2em; margin: 0 0 1.25em; }
  .art__prose :global(li) { margin-bottom: 0.5em; padding-left: 0.2em; }
  .art__prose :global(li)::marker { color: var(--accent); }
  .art__prose :global(img) { border-radius: var(--r-lg); margin: 1.5em 0; }
  .art__prose :global(hr) { margin: 2.5em 0; border: 0; border-top: 1px solid var(--line); }
  .art__prose :global(.art__table) { overflow-x: auto; margin: 1.75em 0; border-radius: var(--r-md); border: 1px solid var(--line); -webkit-overflow-scrolling: touch; }
  .art__prose :global(table) { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: var(--fs-sm); line-height: 1.45; }
  .art__prose :global(th), .art__prose :global(td) { padding: 0.75em 0.9em; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .art__prose :global(tr:last-child td) { border-bottom: 0; }
  .art__prose :global(th) { font-weight: 600; color: var(--cream-0); background: rgb(243 233 214 / 0.04); }
  .art__prose :global(blockquote) { position: relative; margin: 2.2em 0; padding: 0.4em 0 0 0; border: 0; font-family: var(--font-display); font-weight: 400; font-style: italic; font-size: var(--fs-2xl); line-height: 1.12; letter-spacing: -0.02em; color: var(--cream-0); text-wrap: balance; font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .art__prose :global(blockquote)::before { content: '“'; position: absolute; left: -0.06em; top: -0.42em; font-size: 2.6em; line-height: 1; font-style: normal; color: transparent; -webkit-text-stroke: 1px var(--accent); opacity: 0.9; pointer-events: none; }
  .art__prose :global(blockquote)::after { content: ''; display: block; width: 3rem; height: 1px; margin-top: 0.7em; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .art__prose :global(blockquote p) { margin: 0; color: inherit; }
  @media (min-width: 72rem) { .art__prose :global(blockquote) { margin-left: -4rem; padding-left: 4rem; } .art__prose :global(blockquote)::before { left: 0; } }

  /* footer of the article */
  .art__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; max-width: 65ch; margin-top: clamp(2rem, 5vw, 3.5rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .art__tags { list-style: none; margin: 0; padding: 0; }
  .art__tags .chip { text-transform: capitalize; }

  /* ------------------------------------------------------------ the product panel */
