---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { im, SIZES } from '~/data/images';
import { FAQS } from '~/data/faq';
import { site } from '~/data/site';
import { formatThreshold } from '~/data/products';
import { faqPage } from '~/lib/schema';

import { localeParams } from '~/i18n/config';
import type { Locale } from '~/i18n/config';

/** One page per language; the default locale keeps the bare URL. */
export function getStaticPaths() {
  return localeParams();
}

const { locale } = Astro.props as { locale: Locale };

const freeFrom = formatThreshold(site.shipping.freeFrom, locale);

/** Five nutrition / product questions from the shared FAQ, in the order a first-time reader asks them. */
const pick = [
  'Is there really no added sugar?',
  'How many calories?',
  'Is it gluten free?',
  'Is it suitable for vegetarians, vegans, kids?',
  'How long does it keep and how should I store it?',
];
const faqs = pick.flatMap((q) => {
  const f = FAQS.find((x) => x.q === q);
  return f ? [f] : [];
});

/**
 * Typical values for the mainstream product in each category. Apple Bar values
 * are per 35 g bar. The numbers are kept as the reader sees them (`kcal`, `sugar`)
 * and as the meters need them (`kcalN`, `sugarN`); both meters are drawn against
 * the chocolate bar, which is the tallest thing on the wall.
 */
const rows = [
  { name: "App’Lite Apple Bar", size: '35 g · per bar', kcal: '97', kcalN: 97, sugar: '0 g', sugarN: 0, n: '2', note: 'Baked apples and egg white. About 1.8 g fibre from the whole fruit; the sweetness is the apple’s own.', ours: true, approx: false },
  { name: 'Milk chocolate bar', size: '45 g · typical', kcal: '~240', kcalN: 240, sugar: '~24 g', sugarN: 24, n: '8–12', note: 'Nearly all of its sugar is added. It is usually the first word on the label.', ours: false, approx: true },
  { name: 'Granola bar', size: '40 g · typical', kcal: '~180', kcalN: 180, sugar: '~10 g', sugarN: 10, n: '10 or more', note: 'Oats need syrup or honey to hold together, and oil to stay soft.', ours: false, approx: true },
  { name: 'Dried apple', size: '30 g · typical', kcal: '~90', kcalN: 90, sugar: '0 g', sugarN: 0, n: '1–2', note: 'The closest rival. Often treated with sulphites to keep it pale; check the label.', ours: false, approx: true },
];
const KCAL_MAX = 240;
const SUGAR_MAX = 24;

const who = [
  { icon: 'box', title: 'Lunchbox parents', text: 'A sweet that is, in fact, a baked apple. Sealed, survives a school bag, leaves no crumbs.' },
  { icon: 'clock', title: 'Desk snackers', text: 'The four o’clock moment, answered with 97 kcal instead of whatever the vending machine had left.' },
  { icon: 'globe', title: 'Hikers and runners', text: 'Weighs 35 g, lies flat in a jersey pocket, does not melt, and keeps for months without a fridge.' },
  { icon: 'shield', title: 'People cutting added sugar', text: 'Read the label once and stop reading labels. Two ingredients, both of which you could buy at a market.' },
  { icon: 'star', title: 'Gift-givers', text: 'A loaf of pastila is unusual enough to be a story and good enough to be finished. Boxes ship from Riga with a card if you ask.' },
] as const;

const ideas = [
  { title: 'With tea', text: 'The original way. A thick slice of Belyov pastila beside strong black tea, no sugar in either.' },
  { title: 'On porridge', text: 'Crumble a bar over morning oats or yoghurt instead of honey. It softens into the warm bowl.' },
  { title: 'In a lunchbox', text: 'One bar in the corner of the box. It does not leak, melt or crumble, and it is still good at three.' },
  { title: 'After a run', text: 'Something sweet and light before the proper meal. Chase it with water.' },
  { title: 'With cheese', text: 'Slice the 180 g loaf thin and lay it on a board with an aged hard cheese. Tart apple, salty cheese, done.' },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---
<Base
  title="Why pastila? The apple snack with no added sugar"
  description="Why baked-apple pastila beats the snack bar: 99% Antonovka apples, egg white, no added sugar, about 97 kcal. Honest numbers, who it suits, how to eat it."
  canonical="/why-pastila/"
  ogImage="apple-split"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Why pastila', href: '/why-pastila/' }]}
  schema={[faqPage(faqs)]}
>
  <!-- ============================== HERO ============================== -->
  <!-- One enormous line, then air. The photograph below it is the first lit window. -->
  <section class="page-hero container wp-hero" aria-labelledby="page-title">
    <div class="wp-hero__copy">
      <p class="eyebrow">Why pastila</p>
      <h1 id="page-title" data-words>Why pastila beats the snack bar <em>you’re holding.</em></h1>
      <p class="lead">Pastila is a baked-apple snack with two ingredients: Antonovka apples and egg white. No added sugar, no flour, no gluten, about 97 kcal a bar. Here is what it is, why it needs nothing else, and how the numbers stack up against the usual suspects.</p>
      <div class="hero-cta">
        <a class="btn btn--lg btn--accent" href="/shop/apple-bars/">Shop apple bars <Icon name="arrow" size={20} class="arrow" /></a>
        <a class="btn btn--lg btn--ghost" href="/how-its-made/">How it’s made</a>
      </div>
    </div>
    <!-- The first lit window, with the one number that matters standing on its corner. -->
    <div class="wp-hero__media" data-reveal>
      <div class="frame frame--4x5 wp-hero__frame">
        <img src={im('apple-render-tall').src} srcset={im('apple-render-tall').srcset} sizes={im('apple-render-tall').srcset && SIZES.half} alt={im('apple-render-tall').alt} width={im('apple-render-tall').width} height={im('apple-render-tall').height} loading="eager" fetchpriority="high" decoding="async" class="img-cover" data-parallax="0.12" />
      </div>
      <p class="wp-hero__fig" aria-hidden="true"><b data-count="97">97</b><small>kcal</small></p>
    </div>
  </section>
  <div class="container">
    <div class="trust wp-trust" data-reveal>
      <div><Icon name="apple" size={22} /><div><strong>99% apples</strong><span>Antonovka, baked and whipped</span></div></div>
      <div><Icon name="check" size={22} /><div><strong>0 g added sugar</strong><span>Sweet from the fruit alone</span></div></div>
      <div><Icon name="clock" size={22} /><div><strong>12 months</strong><span>No fridge, no preservatives</span></div></div>
      <div><Icon name="truck" size={22} /><div><strong>Free shipping over {freeFrom}</strong><span>Parcels leave Riga in 1–2 business days</span></div></div>
    </div>
  </div>

  <!-- ============================== WHAT PASTILA IS ============================== -->
  <section class="section container" aria-labelledby="what-title">
    <div class="split what">
      <div class="frame frame--1x1 what__frame" data-reveal>
        <img src={im('pastila-macro').src} srcset={im('pastila-macro').srcset} sizes={im('pastila-macro').srcset && SIZES.half} alt={im('pastila-macro').alt} width={im('pastila-macro').width} height={im('pastila-macro').height} loading="lazy" decoding="async" class="img-cover" />
      </div>
      <div>
        <p class="eyebrow">What pastila is</p>
        <h2 id="what-title" data-words>A baked apple, whipped with air and dried into a loaf.</h2>
        <div class="prose mt-4" data-reveal>
          <p>Pastila is a traditional confection from the town of Belyov, first made commercially in 1888 by the merchant Amvrosy Prokhorov. The method has barely changed since. Sour Antonovka apples are baked whole until their sugars caramelise. The purée is whipped with egg white until it holds air, spread in thin sheets and dried for hours at low heat. The sheets are stacked, pressed and dried again.</p>
          <p>What comes out is neither a fruit leather nor a cake. It is soft, fibrous and slightly springy, and it tastes of baked apple and very little else. The loaf becomes a bar when we cut it, a meringue when we bake it, a dessert square when we press it thicker. The ingredient list does not change on the way.</p>
        </div>
        <div class="cluster mt-4" data-reveal>
          <a class="btn" href="/shop/pastila/">Shop Belyov pastila</a>
          <a class="link" href="/story/">Read the story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== WHY NO SUGAR ============================== -->
  <!-- Three things, three outlined numerals, one hairline each. The oven is the accent here, so the light is honey. -->
  <section class="section band why" aria-labelledby="sugar-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Why it needs no sugar</p>
          <h2 id="sugar-title" data-words>Three things happen in the oven. None of them involves a sugar bowl.</h2>
        </div>
        <p class="muted" style="max-width:38ch">Most “no added sugar” bars get there with syrups, sweeteners or fruit concentrate. Pastila gets there by physics.</p>
      </div>
      <ol class="why3" data-stagger>
        <li class="why3__item">
          <span class="why3__n" aria-hidden="true">01</span>
          <span class="why3__icon"><Icon name="apple" size={22} /></span>
          <h3>Baking concentrates the fruit</h3>
          <p>An Antonovka apple is mostly water. Bake it slowly and the water leaves while the apple’s own fructose stays, so the purée tastes sweeter than the fruit that went in, without a gram of anything added.</p>
        </li>
        <li class="why3__item">
          <span class="why3__n" aria-hidden="true">02</span>
          <span class="why3__icon"><Icon name="leaf" size={22} /></span>
          <h3>Pectin sets it</h3>
          <p>Antonovka is unusually rich in pectin, the fibre that makes jam set. As the whipped purée dries, that pectin holds the structure, so there is no gelatine, no starch and no flour in the recipe.</p>
        </li>
        <li class="why3__item">
          <span class="why3__n" aria-hidden="true">03</span>
          <span class="why3__icon"><Icon name="egg" size={22} /></span>
          <h3>Egg white lifts it</h3>
          <p>Whipped egg white traps thousands of tiny air pockets in the purée. That is why pastila is light and springy rather than dense and sticky, and why a 35 g bar feels like more than it weighs.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================== THE WHOLE LABEL ============================== -->
  <!-- The one full-bleed photograph on the page: the apple cut open, the copy standing in its light. -->
  <section class="label" aria-labelledby="label-title">
    <div class="label__media">
      <img src={im('apple-split').src} srcset={im('apple-split').srcset} sizes="100vw" alt={im('apple-split').alt} width={im('apple-split').width} height={im('apple-split').height} loading="lazy" decoding="async" data-parallax="0.2" />
    </div>
    <div class="container label__copy">
      <p class="eyebrow">The whole label</p>
      <h2 id="label-title" data-words>Baked apples. Egg white. Read it again, it does not get longer.</h2>
      <p class="label__text" data-reveal>There is nothing to decode on a Semers pack. No “natural flavouring”, no sweeteners with numbers for names, no oil to keep things soft. Slow drying does the preserving, which is why a bar keeps for twelve months in a drawer.</p>
      <div class="stats label__stats" data-stagger>
        <div class="stat"><strong data-count="99">99%</strong><span>apples</span></div>
        <div class="stat"><strong data-count="2">2</strong><span>ingredients</span></div>
        <div class="stat"><strong>0 g</strong><span>added sugar</span></div>
        <div class="stat"><strong data-count="12">12</strong><span>months, no fridge</span></div>
      </div>
      <div class="cluster mt-6" data-reveal>
        <a class="btn" href="/shop/">Shop all products</a>
        <a class="link" href="/products/apple-bar-35g/">The 35 g Apple Bar</a>
      </div>
    </div>
  </section>

  <!-- ============================== HONEST NUMBERS: THE WALL ============================== -->
  <!--
    The comparison table, rebuilt as a wall of display numbers. Each snack is a
    row; energy and added sugar carry a meter drawn against the chocolate bar,
    so the gap is seen before it is read. Our row is the one lit in mint; the
    rivals are set as outlines, which is what they are next to it.
  -->
  <section class="section wall-sec" aria-labelledby="numbers-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Honest numbers</p>
          <h2 id="numbers-title" data-words>One bar next to the things it replaces.</h2>
        </div>
        <p class="muted" style="max-width:38ch">Typical values for the mainstream product in each category. Ours are for one App’Lite Apple Bar; the full table is on every product page.</p>
      </div>
      <p class="sr-only" id="cmp-caption">Energy, added sugar and ingredient count of a 35 g Apple Bar compared with typical snacks</p>
      <ol class="wall" aria-labelledby="cmp-caption" data-reveal>
        {rows.map((r) => (
          <li class={`wall__row ${r.ours ? 'is-ours' : ''}`}>
            <div class="wall__who">
              <h3>{r.name}{r.ours && <em class="cmp__tag">ours</em>}</h3>
              <span class="wall__size">{r.size}</span>
            </div>
            <div class="wall__cell wall__cell--kcal">
              <span class="wall__lbl">Energy</span>
              <div class="wall__num"><b data-count={r.kcalN} data-count-prefix={r.approx ? '~' : undefined}>{r.kcal}</b> <small>kcal</small></div>
              <div class="wall__meter" aria-hidden="true"><i style={`--w:${(r.kcalN / KCAL_MAX).toFixed(3)}`}></i></div>
            </div>
            <div class="wall__cell wall__cell--sugar">
              <span class="wall__lbl">Added sugar</span>
              <div class="wall__num">{r.sugarN ? <b data-count={r.sugarN} data-count-prefix="~">{r.sugar}</b> : <b>{r.sugar}</b>}</div>
              <div class="wall__meter" aria-hidden="true"><i style={`--w:${(r.sugarN / SUGAR_MAX).toFixed(3)}`}></i></div>
            </div>
            <div class="wall__cell wall__cell--n">
              <span class="wall__lbl">Ingredients</span>
              <div class="wall__num wall__num--n">{r.n}</div>
            </div>
            <p class="wall__note">{r.note}</p>
          </li>
        ))}
      </ol>
      <p class="tiny muted mt-4 wall__foot">Chocolate, granola and dried-apple figures are typical values for mainstream products in each category, rounded. An Apple Bar still contains about 20 g of sugars, all of them the apple’s own; we would rather you knew. Apple Bar values are typical for the recipe; see the pack for the batch label. More on reading labels in the <a href="/journal/healthy-snacks-no-added-sugar/">journal</a>.</p>
    </div>
  </section>

  <!-- ============================== WHO IT'S FOR ============================== -->
  <!-- A strip of lit cards that runs off the right edge. Snaps on touch, drags with a mouse, and takes focus so a keyboard can scroll it too. -->
  <section class="section who" aria-labelledby="who-title">
    <div class="container section-head who__head">
      <div>
        <p class="eyebrow">Who it’s for</p>
        <h2 id="who-title" data-words>Anyone who wants something sweet and would rather not think about it.</h2>
      </div>
      <p class="eyebrow who__hint" aria-hidden="true">Drag <Icon name="arrow" size={14} /></p>
    </div>
    <p class="sr-only" id="who-strip-title">Five kinds of people, one bar.</p>
    <div class="who__scroller">
    <div class="strip" data-strip role="region" aria-labelledby="who-strip-title" tabindex="0" data-cursor="Drag">
      <ul class="strip__track" data-stagger>
        <li class="strip__card strip__card--photo">
          <div class="frame frame--4x5 strip__frame">
            <img src={im('flatlay-lunchbox').src} srcset={im('flatlay-lunchbox').srcset} sizes={im('flatlay-lunchbox').srcset && SIZES.third} alt={im('flatlay-lunchbox').alt} width={im('flatlay-lunchbox').width} height={im('flatlay-lunchbox').height} loading="lazy" decoding="async" class="img-cover" />
          </div>
        </li>
        {who.map((w, i) => (
          <li class="strip__card" data-tilt>
            <span class="strip__n" aria-hidden="true">{num(i)}</span>
            <span class="strip__icon"><Icon name={w.icon} size={22} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
        <li class="strip__card strip__card--cta">
          <p class="strip__cta-text">For the drawer, or for someone else.</p>
          <a class="btn" href="/products/apple-bar-12-pack/">Box of 12 bars</a>
          <a class="link" href="/shop/gift-sets/">Gift sets and boxes</a>
        </li>
      </ul>
    </div>
    </div>
  </section>

  <!-- ============================== HOW TO EAT IT ============================== -->
  <!-- Five ways, numbered in outlined type, beside a photograph that stays put while they scroll past. -->
  <section class="section container" aria-labelledby="eat-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">How to eat it</p>
        <h2 id="eat-title" data-words>Straight from the pack works. So do these.</h2>
      </div>
      <a class="link" href="/shop/">Shop all products</a>
    </div>
    <div class="ways">
      <div class="ways__pic">
        <div class="frame frame--4x5 ways__frame" data-reveal>
          <img src={im('pastila-slices').src} srcset={im('pastila-slices').srcset} sizes={im('pastila-slices').srcset && SIZES.third} alt={im('pastila-slices').alt} width={im('pastila-slices').width} height={im('pastila-slices').height} loading="lazy" decoding="async" class="img-cover" />
        </div>
      </div>
      <div>
        <ol class="ideas" data-stagger>
          {ideas.map((i, k) => (
            <li class="idea">
              <span class="idea__n" aria-hidden="true">{num(k)}</span>
              <div>
                <h3>{i.title}</h3>
                <p>{i.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="small muted mt-4">For the plate rather than the pocket: the <a href="/products/applite-baked-apple-dessert-50g/">App’Lite Dessert</a> and the <a href="/products/belyov-apple-pastila-180g/">180 g Belyov loaf</a>.</p>
      </div>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="section band" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title" data-words>The questions that come before the first bite.</h2>
        <p class="muted mt-2">More in the <a href="/faq/">full FAQ</a>, or <a href="/contact/">write to us</a>.</p>
      </div>
      <div class="acc" data-reveal>
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><div class="acc__body"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== CTA ============================== -->
  <section class="section container cta-sec" aria-labelledby="cta-title">
    <div class="cta-band" data-reveal>
      <p class="eyebrow">Try it</p>
      <h2 id="cta-title">Start with a bar. The loaf can wait.</h2>
      <p>App’Lite Apple Bars leave Riga in 1–2 business days and ship free on orders over {freeFrom}. Prefer a shelf? We are also at Maxima and on Barbora — see <a class="cta-band__a" href="/where-to-buy/">where to buy</a>.</p>
      <div class="cluster mt-2">
        <a class="btn" href="/shop/apple-bars/">Shop apple bars <Icon name="arrow" size={18} class="arrow" /></a>
        <a class="btn btn--ghost" href="/products/tasting-box/">Try the Tasting Box</a>
      </div>
    </div>
  </section>
</Base>

<script>
  /*
   * The strip of cards scrolls sideways. A thumb already knows what to do with
   * it; a mouse gets to drag it too. Snapping is switched off for the length of
   * the drag — a snap container re-snaps on every programmatic scrollLeft, which
   * would turn a drag into a stutter — and back on at release, when it settles
   * the nearest card into place. A drag that moved is not a click.
   */
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  if (strip && matchMedia('(pointer: fine)').matches) {
    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    strip.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = strip.scrollLeft;
      strip.classList.add('is-drag');
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      strip.scrollLeft = startLeft - dx;
    }, { passive: true });
    const release = () => {
      if (!down) return;
      down = false;
      strip.classList.remove('is-drag');
    };
    addEventListener('pointerup', release);
    addEventListener('pointercancel', release);
    strip.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  }
</script>

<style>
  /* ------------------------------------------------------------- hero */
  .wp-hero { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: end; }
  .wp-hero h1 { max-width: 16ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .wp-hero__media { position: relative; }
  .wp-hero__frame { border-radius: var(--r-xl); background: var(--night-800); box-shadow: var(--shadow-3), var(--glow-honey); }
  /* Taller than its window so the parallax never shows an edge. */
  .wp-hero__frame img { position: absolute; inset: -10% 0; width: 100%; height: 120%; object-fit: cover; object-position: 50% 45%; }
  /* The calorie count, outlined, standing on the corner of the frame. */
  .wp-hero__fig { position: absolute; left: clamp(-0.5rem, -2vw, -1.5rem); bottom: clamp(-0.6rem, -1.5vw, -1.2rem); z-index: 2; margin: 0; display: inline-flex; align-items: baseline; font-family: var(--font-display); font-weight: 400; font-size: clamp(5rem, 14vw, 10rem); line-height: 0.8; letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1px var(--cream-3); font-variant-numeric: tabular-nums; filter: drop-shadow(0 0 24px rgb(11 18 14 / 0.8)); pointer-events: none; }
  .wp-hero__fig b { font-weight: inherit; }
  .wp-hero__fig small { font-family: var(--font-sans); font-size: 0.18em; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--honey-500); -webkit-text-stroke: 0; margin-left: 0.3em; text-shadow: 0 0 20px rgb(253 185 19 / 0.5); }
  @media (max-width: 63.99rem) { .wp-hero__frame { aspect-ratio: 4 / 3; } .wp-hero__media { margin-top: 0.5rem; } }
  @media (min-width: 64rem) {
    .wp-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); column-gap: clamp(2rem, 6vw, 6rem); }
    .wp-hero__media { max-width: 30rem; justify-self: end; width: 100%; }
  }
  .wp-trust { margin-top: clamp(1.5rem, 4vw, 2.5rem); border-bottom: 0; }

  /* ------------------------------------------------------------- what */
  .what__frame { border-radius: var(--r-xl); box-shadow: var(--shadow-2); }
  @media (min-width: 56rem) { .what { grid-template-columns: 0.9fr 1.1fr; } }

  /* ------------------------------------------------------------- why: three numerals */
  .why { background: radial-gradient(50% 60% at 15% 10%, rgb(240 176 74 / 0.08), transparent 60%), var(--bg-sunken); }
  .why3 { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem; }
  @media (min-width: 48rem) { .why3 { grid-template-columns: repeat(3, 1fr); gap: 0 clamp(1.5rem, 3vw, 3rem); } }
  .why3__item { position: relative; display: grid; gap: 0.75rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .why3__n { font-family: var(--font-display); font-size: var(--fs-4xl); font-weight: 400; line-height: 0.85; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px var(--cream-3); }
