---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
---
<Base title="Thank you" description="We received your order request." canonical="/order/thank-you/" noindex>
  <section class="container ty">
    <div class="ty__card">
      <div class="ty__icon"><Icon name="check" size={32} /></div>
      <p class="eyebrow">Order request received</p>
      <h1>Thank you. We’re on it.</h1>
      <p class="lead"><span id="ty-ref-line" hidden>Your reference is <strong class="num" id="ty-ref">—</strong>. </span>Within one business day you will get an e-mail from {site.email} confirming availability, the delivery estimate and a secure payment link.</p>
      <ol class="ty__steps">
        <li><strong>Confirmation e-mail</strong><span>Check spam if it doesn’t arrive within a few hours.</span></li>
        <li><strong>Payment link</strong><span>Card or bank transfer, whichever you prefer.</span></li>
        <li><strong>Packed in Riga</strong><span>Sealed and shipped within 1–2 business days of payment.</span></li>
      </ol>
      <section class="ty__recap" id="ty-recap" aria-labelledby="ty-recap-title" hidden>
        <h2 id="ty-recap-title">What you ordered</h2>
        <ul id="ty-lines"></ul>
        <dl id="ty-totals"></dl>
        <p class="tiny muted" id="ty-recap-note"></p>
      </section>
      <div class="cluster mt-4">
        <a class="btn" href="/shop/">Back to the shop</a>
        <a class="btn btn--ghost" href="/journal/">Read the journal</a>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var ref = new URLSearchParams(location.search).get('ref');
      var el = document.getElementById('ty-ref');
      var line = document.getElementById('ty-ref-line');
      if (el && line && ref) { el.textContent = ref; line.hidden = false; }
      // Recap of the order just placed (stashed by the checkout; stays until the tab closes).
      try {
        var raw = sessionStorage.getItem('semers.lastOrder');
        var o = raw ? JSON.parse(raw) : null;
        if (!o || !o.items || !o.items.length || (ref && o.ref && o.ref !== ref)) return;
        var eur = function (n) { return new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR' }).format(n); };
        var lines = document.getElementById('ty-lines');
        o.items.forEach(function (i) {
          var li = document.createElement('li');
          var name = document.createElement('span');
          name.textContent = i.qty + ' × ' + i.name + (i.variant ? ' (' + i.variant + ')' : '') + (i.note ? ' — ' + i.note : '');
          var sum = document.createElement('strong');
          sum.className = 'num';
          sum.textContent = eur(i.total);
          li.appendChild(name); li.appendChild(sum); lines.appendChild(li);
        });
        var totals = document.getElementById('ty-totals');
        var row = function (k, v) { var dt = document.createElement('dt'); dt.textContent = k; var dd = document.createElement('dd'); dd.className = 'num'; dd.textContent = v; totals.appendChild(dt); totals.appendChild(dd); };
        row('Subtotal', eur(o.subtotal));
        row('Shipping', o.shippingNote ? 'quoted by e-mail' : o.shipping ? eur(o.shipping) : 'free');
        row('Total', eur(o.total) + (o.shippingNote ? ' + shipping' : ''));
        var note = document.getElementById('ty-recap-note');
        note.textContent = (o.delivery ? o.delivery + '. ' : '') + (o.email ? 'Confirmation goes to ' + o.email + '.' : '');
        document.getElementById('ty-recap').hidden = false;
      } catch (e) { /* no recap without storage */ }
    })();
  </script>
</Base>
<style>
  .ty { padding-block: clamp(3rem, 8vw, 6rem); }
  .ty__card { max-width: 40rem; margin-inline: auto; text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .ty__icon { width: 4.5rem; height: 4.5rem; border-radius: 50%; background: var(--leaf-100); color: var(--leaf-500); display: grid; place-items: center; margin-bottom: 0.5rem; }
  .ty__steps { counter-reset: s; list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 0.75rem; text-align: left; width: 100%; }
  .ty__steps li { counter-increment: s; display: grid; grid-template-columns: 2.2rem 1fr; gap: 0 0.5rem; align-items: start; padding: 0.9rem 1rem; background: var(--bg-raised); border-radius: var(--r-md); box-shadow: var(--shadow-1); }
  .ty__steps li::before { content: counter(s); grid-row: 1 / 3; font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 600; color: var(--accent); }
  .ty__steps span { font-size: var(--fs-sm); color: var(--fg-3); }
  .ty__recap { width: 100%; text-align: left; margin-top: 1.5rem; padding: 1rem 1.25rem; background: var(--bg-raised); border-radius: var(--r-md); box-shadow: var(--shadow-1); }
  .ty__recap[hidden] { display: none; }
  .ty__recap h2 { font-size: var(--fs-lg); margin-bottom: 0.5rem; }
  .ty__recap ul { list-style: none; margin: 0; padding: 0; }
  /* Rows and totals are created by the inline script, so they carry no scope attribute: :global() keeps the rules matching. */
  .ty__recap :global(li) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
  .ty__recap :global(li strong) { flex: none; }
  .ty__recap dl { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; margin: 0.6rem 0 0; font-size: var(--fs-sm); }
  .ty__recap :global(dd) { margin: 0; text-align: right; }
  .ty__recap :global(dt:last-of-type), .ty__recap :global(dd:last-of-type) { font-weight: 700; }
  .ty__recap p { margin-top: 0.75rem; }
  /* Phones: the two buttons wrap onto separate lines; keep them centred like the rest of the card. */
  .ty__card .cluster { justify-content: center; }
</style>
