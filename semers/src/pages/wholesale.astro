---
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import { PRODUCTS, FLAVORS, DIET_TAGS } from '~/data/products';
import { img, imgSrc } from '~/data/images';
import { site } from '~/data/site';
import { FAQS } from '~/data/faq';
import { faqPage } from '~/lib/schema';

const im = (k: string) => ({ ...img(k), src: imgSrc(k) });

/** Export markets are whatever site.ts lists outside the home market. */
const exportMarkets = [...new Set(site.retailers.filter((r) => r.country !== site.country).map((r) => r.country))];
const exportCount = exportMarkets.length;
const exportList = exportCount > 1 ? `${exportMarkets.slice(0, -1).join(', ')} and ${exportMarkets[exportCount - 1]}` : exportMarkets.join('');

/** Retail formats straight from the catalogue; bundles and gift sets are web-shop only. */
const formats = PRODUCTS.filter((p) => p.collection !== 'gift-sets')
  .sort((a, b) => a.order - b.order)
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    brand: p.brand,
    weight: `${p.weightGrams} g`,
    flavours: p.variants.map((v) => FLAVORS[v.key].label),
    claims: p.diet.filter((d) => d === 'no-added-sugar' || d === 'gluten-free').map((d) => DIET_TAGS[d]),
    shelf: `${p.shelfLifeMonths} months`,
  }));
const skuCount = formats.reduce((n, f) => n + f.flavours.length, 0);

const segments = [
  { icon: 'box', bg: 'var(--mint-100)', fg: 'var(--mint-600)', title: 'Retail chains', text: 'Already on the shelf at Maxima across Latvia. EAN-coded SKUs, shelf-ready cases and a bar that sells as well at the till as it does next to the dried fruit.' },
  { icon: 'star', bg: 'var(--honey-100)', fg: 'var(--bar-700)', title: 'Independent stores', text: 'Delis, health-food shops, farm shops, concept stores. A small first order by parcel, then reorders whenever the shelf runs low.' },
  { icon: 'apple', bg: 'var(--coral-100)', fg: 'var(--coral-600)', title: 'Cafés & HoReCa', text: 'A sweet with no added sugar for the counter, the coffee saucer or the minibar. No fridge, no crumbs, nothing to throw away at closing time.' },
  { icon: 'clock', bg: 'var(--leaf-100)', fg: 'var(--leaf-600)', title: 'Offices', text: 'A snack drawer that does not end in a four o’clock slump. Boxes of bars for kitchens, meetings and welcome packs.' },
  { icon: 'globe', bg: 'var(--apple-100)', fg: 'var(--apple-700)', title: 'Distributors', text: `Our products are already sold in ${exportList}. Pallets from Riga, spec sheets for every SKU, one person to talk to.` },
  { icon: 'shield', bg: 'var(--cream-2)', fg: 'var(--ink-700)', title: 'Private label', text: 'The same two-ingredient recipe under your own brand, for larger volumes. Your artwork, our ovens.' },
] as const;

const BALTICS = ['Latvia', 'Lithuania', 'Estonia'];
const EU_REST = ['Austria', 'Belgium', 'Bulgaria', 'Croatia', 'Cyprus', 'Czechia', 'Denmark', 'Finland', 'France', 'Germany', 'Greece', 'Hungary', 'Ireland', 'Italy', 'Luxembourg', 'Malta', 'Netherlands', 'Poland', 'Portugal', 'Romania', 'Slovakia', 'Slovenia', 'Spain', 'Sweden'];
const KINDS = ['Retail chain', 'Independent store', 'Café or HoReCa', 'Office', 'Distributor', 'Private label', 'Other'];
const VOLUMES = ['Under 100 units a month', '100–1,000 units a month', '1,000–10,000 units a month', '10,000+ units a month'];

const wholesaleFaq = FAQS.find((f) => f.group === 'wholesale');
const faqs = [
  ...(wholesaleFaq ? [wholesaleFaq] : []),
  { q: 'Is there a minimum order?', a: 'It depends on the format and on whether the order travels by parcel or by pallet. Tell us what you have in mind in the form and we will say straight away.' },
  { q: 'Does it need a fridge?', a: 'No. Apple Bars, Flourless Bars, the App’Lite dessert and Belyov pastila keep for twelve months at room temperature, unopened. Meringues and zephyr have shorter shelf lives; see the formats table.' },
  { q: 'Do you provide spec sheets and EAN codes?', a: 'Yes. Our SKUs are EAN-coded, and the line sheet comes with a spec sheet for each product: ingredients, allergens and nutrition per 100 g.' },
  { q: 'Can we taste it before we order?', a: 'The quickest way is a Tasting Box from the web shop: four Apple Bars, two Flourless Bars, two bags of meringues and a 100 g pastila loaf, shipped free. Or mention samples in the form and we will tell you what we can send.' },
  { q: 'Where do you already sell?', a: `In Latvia at Maxima and on Barbora, and through selected retailers in ${exportList}. See the Where to buy page for the list.` },
];

const mailHref = `mailto:${site.wholesaleEmail}?subject=${encodeURIComponent('Wholesale enquiry')}`;
---
<Base
  title="Wholesale apple bars & pastila for retailers and cafés"
  description="Wholesale apple bars, meringues and Belyov pastila with no added sugar for retailers, cafés, offices and distributors. Made in Riga, shipped EU-wide."
  canonical="/wholesale/"
  ogImage="retail-boxes"
  breadcrumb={[{ name: 'Home', href: '/' }, { name: 'Wholesale', href: '/wholesale/' }]}
  schema={[faqPage(faqs)]}
>
  <!-- ============================== HERO ============================== -->
  <section class="container ws-hero" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Wholesale &amp; B2B · {site.brand.legalName}, {site.locality}</p>
      <h1 id="page-title">Put a 99% apple snack <em>on your shelf.</em></h1>
      <p class="lead">Semers supplies wholesale apple bars, apple meringues and Belyov pastila to retail chains, independent stores, cafés, offices and distributors across the EU. Two ingredients, no added sugar, twelve months on an ambient shelf. Already at Maxima and on Barbora in Latvia, and in stores in {exportList}.</p>
      <div class="ws-hero__cta">
        <a class="btn btn--lg" href="#enquiry">Request the line sheet <Icon name="arrow" size={20} class="arrow" /></a>
        <a class="btn btn--lg btn--ghost" href="#formats">See the formats</a>
      </div>
      <div class="hero__proof">
        <span><Icon name="check" size={16} /> No added sugar</span>
        <span><Icon name="check" size={16} /> EAN-coded SKUs</span>
        <span><Icon name="check" size={16} /> Ships from Riga, EU-wide</span>
      </div>
    </div>
    <div class="hero__media" data-reveal>
      <div class="frame ws-hero__img">
        <img src={im('retail-boxes').src} alt={im('retail-boxes').alt} width={im('retail-boxes').width} height={im('retail-boxes').height} loading="eager" fetchpriority="high" decoding="async" class="img-cover" />
      </div>
      <div class="hero__float hero__float--a"><strong>Maxima</strong><span>on shelves across Latvia</span></div>
      <div class="hero__float hero__float--b"><strong>{exportCount}</strong><span>export markets in the EU</span></div>
    </div>
  </section>

  <div class="container">
    <div class="trust" data-reveal>
      <div><Icon name="box" size={22} /><div><strong>Already on shelves</strong><span>Maxima, Barbora and stores in {exportCount} export markets</span></div></div>
      <div><Icon name="globe" size={22} /><div><strong>Made in Riga, Latvia</strong><span>An EU producer: {site.brand.legalName}</span></div></div>
      <div><Icon name="clock" size={22} /><div><strong>12 months ambient</strong><span>Bars and pastila need no cold chain</span></div></div>
      <div><Icon name="mail" size={22} /><div><strong>Reply within one business day</strong><span>Line sheet, prices and spec sheets</span></div></div>
    </div>
  </div>

  <!-- ============================== WHO WE SUPPLY ============================== -->
  <section class="section container" aria-labelledby="who-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Who we supply</p>
        <h2 id="who-title">From one café to a national chain.</h2>
      </div>
      <p class="muted" style="max-width:38ch">Same bars, same pastila, packed for the way you sell. Pick the line that sounds like you.</p>
    </div>
    <div class="grid grid--3" data-reveal>
      {segments.map((s) => (
        <article class="feat" style={`--feat-bg:${s.bg};--feat-fg:${s.fg}`}>
          <div class="feat__icon"><Icon name={s.icon} size={22} /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ============================== WHY IT SELLS ============================== -->
  <section class="section band" aria-labelledby="why-title">
    <div class="container split">
      <div class="frame frame--4x5 rounded ws-why__img" data-reveal>
        <img src={im('hero-bars').src} alt={im('hero-bars').alt} width={im('hero-bars').width} height={im('hero-bars').height} loading="lazy" decoding="async" class="img-cover" />
      </div>
      <div data-reveal>
        <p class="eyebrow">Why it sells</p>
        <h2 id="why-title">The label does the selling.</h2>
        <p class="lead">Shoppers read ingredient lists now. Ours has two entries, and the first one is 99% of the pack. That is the whole pitch, and it fits on the front.</p>
        <div class="stats ws-stats">
          <div class="stat"><strong>99%</strong><span>baked Antonovka apples</span></div>
          <div class="stat"><strong>2</strong><span>ingredients: apples, egg white</span></div>
          <div class="stat"><strong>0 g</strong><span>added sugar</span></div>
          <div class="stat"><strong>12</strong><span>months on an ambient shelf</span></div>
        </div>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> No added sugar, no flour, no gluten, no preservatives</li>
          <li><Icon name="check" size={18} /> No cooling: room temperature from our door to your shelf</li>
          <li><Icon name="check" size={18} /> Small footprint: a 35 g bar takes the space of a chocolate bar</li>
          <li><Icon name="check" size={18} /> EAN-coded SKUs, ready for your system</li>
          <li><Icon name="check" size={18} /> Made in Riga, Latvia, by {site.brand.legalName}: an EU producer</li>
          <li><Icon name="check" size={18} /> A recipe with a date on it: Belyov pastila, made commercially since 1888</li>
        </ul>
        <div class="cluster mt-4">
          <a class="link" href="/why-pastila/">Why pastila</a>
          <a class="link" href="/how-its-made/">How it’s made</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== FORMATS ============================== -->
  <section class="section container" id="formats" aria-labelledby="formats-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Formats</p>
        <h2 id="formats-title">Seven formats. One ingredient list.</h2>
      </div>
      <p class="muted">{formats.length} formats · {skuCount} SKUs · <a href="/shop/">see them in the shop</a></p>
    </div>
    <div class="table-wrap ws-table" data-reveal>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col">Weight</th>
            <th scope="col">Flavours</th>
            <th scope="col">On the label</th>
            <th scope="col">Shelf life</th>
          </tr>
        </thead>
        <tbody>
          {formats.map((f) => (
            <tr>
              <td><a class="ws-table__name" href={`/products/${f.slug}/`}>{f.title}</a><span class="tiny muted">{f.brand}</span></td>
              <td class="nowrap">{f.weight}</td>
              <td>{f.flavours.join(', ')}</td>
              <td><div class="ws-table__claims">{f.claims.map((c) => <span class="chip chip--leaf">{c}</span>)}</div></td>
              <td class="nowrap">{f.shelf}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted mt-4">Shelf life is unopened, at room temperature. Case sizes, pallet configurations and trade prices are in the line sheet; <a href="#enquiry">request it below</a>. Gift boxes and the Apple Bar 12-pack are web-shop formats, but ask if you want them for corporate gifting.</p>
  </section>

  <!-- ============================== HOW ORDERING WORKS ============================== -->
  <section class="section container section--tight" aria-labelledby="how-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">How ordering works</p>
        <h2 id="how-title">Three steps, no portal, no password.</h2>
      </div>
    </div>
    <div class="steps ws-steps" data-reveal>
      <div class="step">
        <h3>Tell us about you</h3>
        <p>Fill in the form below: who you are, where you sell and roughly what volume you have in mind. Two minutes, no attachments needed.</p>
      </div>
      <div class="step">
        <h3>We send the line sheet and prices</h3>
        <p>Within one business day you get the line sheet with formats, case sizes and trade prices, plus a spec sheet per product with ingredients, allergens, nutrition and EAN codes.</p>
      </div>
      <div class="step">
        <h3>First order ships from Riga</h3>
        <p>Confirm the order and we pack it. Small orders travel by parcel, larger ones by pallet, anywhere in the EU. Reorders are one e-mail.</p>
      </div>
    </div>
  </section>

  <!-- ============================== LOGISTICS ============================== -->
  <section class="section band--ink ws-log" aria-labelledby="log-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Logistics</p>
          <h2 id="log-title">Ships from Riga. Lands anywhere in the EU.</h2>
        </div>
        <p class="ws-log__lead">We make and ship everything from Riga, Latvia. From here, goods move by road and sea to the whole European Union, and our web-shop parcels already leave within 1–2 business days.</p>
      </div>
      <div class="grid grid--3" data-reveal>
        <div class="ws-log__item">
          <div class="feat__icon"><Icon name="box" size={22} /></div>
          <h3>Parcels</h3>
          <p>For first orders, independents, cafés and offices. Sent by courier from Riga, the same route our web-shop orders take every day.</p>
        </div>
        <div class="ws-log__item">
          <div class="feat__icon"><Icon name="truck" size={22} /></div>
          <h3>Pallets</h3>
          <p>For chains and distributors. Pallets from Riga to your warehouse anywhere in the EU. Lead times and pallet configurations are in the line sheet.</p>
        </div>
        <div class="ws-log__item">
          <div class="feat__icon"><Icon name="shield" size={22} /></div>
          <h3>Paperwork</h3>
          <p>A spec sheet for every SKU with ingredients, allergens, nutrition per 100 g and EAN codes. Twelve-month shelf life on bars and pastila; no cold chain to arrange.</p>
        </div>
      </div>
      <p class="ws-log__foot small">Already stocked at Maxima and Barbora in Latvia, and by selected retailers in {exportList}. <a href="/where-to-buy/">Where to buy</a></p>
    </div>
  </section>

  <!-- ============================== PRIVATE LABEL ============================== -->
  <section class="section container" aria-labelledby="pl-title">
    <div class="split split--rev">
      <div class="frame frame--4x5 rounded" data-reveal>
        <img src={im('gift-box').src} alt={im('gift-box').alt} width={im('gift-box').width} height={im('gift-box').height} loading="lazy" decoding="async" class="img-cover" />
      </div>
      <div data-reveal>
        <p class="eyebrow">Private label</p>
        <h2 id="pl-title">Your name on the pack. Our apples inside.</h2>
        <p class="lead">For larger volumes we make the same baked-apple bars, meringues and pastila under your brand. You bring the name and the artwork; we bring the recipe, the ovens in Riga and packaging ready for your EAN codes.</p>
        <p>Start from any format in the table above, from a 35 g bar to a 180 g loaf. Tell us the format and the monthly volume in the form and we will tell you what is possible, and how soon.</p>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> Same two-ingredient recipe, no added sugar</li>
          <li><Icon name="check" size={18} /> Made in the EU, in Riga, with a twelve-month ambient shelf life</li>
          <li><Icon name="check" size={18} /> A story to print on the back: Belyov pastila, since 1888</li>
        </ul>
        <div class="cluster mt-4">
          <a class="btn btn--ghost" href="#enquiry">Ask about private label</a>
          <a class="link" href="/story/">Read our story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="section container section--tight" aria-labelledby="faq-title">
    <div class="ws-faq">
      <div>
        <p class="eyebrow">Questions buyers ask</p>
        <h2 id="faq-title">Before the first purchase order.</h2>
        <p class="muted mt-2">More in the <a href="/faq/">full FAQ</a>, or <a href="/contact/">write to us</a>.</p>
      </div>
      <div class="acc" data-reveal>
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><div class="acc__body"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== ENQUIRY FORM ============================== -->
  <section class="section container" id="enquiry" aria-labelledby="enq-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Wholesale enquiry</p>
        <h2 id="enq-title">Tell us about your shelf.</h2>
      </div>
      <p class="muted" style="max-width:38ch">We reply within one business day with the line sheet, trade prices and spec sheets.</p>
    </div>
    <div class="ws-enq">
      <div class="ws-form" data-reveal>
        <form data-form="wholesale" data-success="Thanks — we reply within one business day with prices and the line sheet.">
          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="ws-company">Company</label>
              <input class="input" id="ws-company" name="company" type="text" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="ws-name">Your name</label>
              <input class="input" id="ws-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="ws-email">Work e-mail</label>
              <input class="input" id="ws-email" name="email" type="email" autocomplete="email" inputmode="email" required />
            </div>
            <div class="field">
              <label for="ws-phone">Phone <span class="muted">(optional)</span></label>
              <input class="input" id="ws-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
            </div>
            <div class="field">
              <label for="ws-country">Country</label>
              <select class="select" id="ws-country" name="country" required>
                <option value="">Choose a country</option>
                <optgroup label="Baltics">
                  {BALTICS.map((c) => <option value={c}>{c}</option>)}
                </optgroup>
                <optgroup label="Rest of the EU">
                  {EU_REST.map((c) => <option value={c}>{c}</option>)}
                </optgroup>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="field">
              <label for="ws-kind">You are a</label>
              <select class="select" id="ws-kind" name="kind" required>
                <option value="">Choose one</option>
                {KINDS.map((k) => <option value={k}>{k}</option>)}
              </select>
            </div>
            <div class="field span-2">
              <label for="ws-volume">Expected volume</label>
              <select class="select" id="ws-volume" name="volume">
                <option value="">Not sure yet</option>
                {VOLUMES.map((v) => <option value={v}>{v}</option>)}
              </select>
              <span class="hint">A rough guess is fine. It helps us send the right price list.</span>
            </div>
            <div class="field span-2">
              <label for="ws-message">Message <span class="muted">(optional)</span></label>
              <textarea class="textarea" id="ws-message" name="message" rows="5" placeholder="Which formats interest you, how many locations, when you would like to start, whether you want samples or private label…"></textarea>
            </div>
            <div class="honey" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
            <label class="checkbox span-2">
              <input type="checkbox" name="consent" value="yes" required />
              <span>I agree that Semers stores this enquiry to reply to it. Read the <a href="/legal/privacy/">privacy policy</a>.</span>
            </label>
            <div class="span-2">
              <button class="btn btn--lg" type="submit">Request the line sheet</button>
            </div>
          </div>
        </form>
        <p class="small" data-form-note></p>
      </div>

      <aside class="ws-enq__aside" data-reveal>
        <div class="frame frame--3x2 rounded ws-aside__img">
          <img src={im('lifestyle-desk').src} alt={im('lifestyle-desk').alt} width={im('lifestyle-desk').width} height={im('lifestyle-desk').height} loading="lazy" decoding="async" class="img-cover" />
        </div>
        <div class="ws-aside__card">
          <div class="feat__icon"><Icon name="mail" size={22} /></div>
          <h3>Prefer e-mail?</h3>
          <p>Write to <a class="ws-aside__mail" href={mailHref}>{site.wholesaleEmail}</a> with your company name and country and we will send the line sheet the same way.</p>
          <p class="eyebrow ws-aside__eyebrow">What happens next</p>
          <ul class="ticks small">
            <li><Icon name="check" size={16} /> A reply from a person within one business day</li>
            <li><Icon name="check" size={16} /> Line sheet, trade prices and spec sheets</li>
            <li><Icon name="check" size={16} /> First order by parcel or pallet from Riga</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============================== TASTE FIRST ============================== -->
  <section class="section container section--tight" aria-labelledby="taste-title">
    <div class="cta-band" data-reveal>
      <p class="eyebrow">Taste it first</p>
      <h2 id="taste-title">Order a Tasting Box today. Talk wholesale tomorrow.</h2>
      <p>Four Apple Bars, two Flourless Bars, two bags of meringues and a 100 g pastila loaf, shipped free from Riga. Bring it to your next range meeting.</p>
      <div class="cluster mt-2">
        <a class="btn btn--paper" href="/products/tasting-box/">Order a Tasting Box</a>
        <a class="btn btn--ghost ws-cta__ghost" href="/shop/">Shop all products</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .ws-hero { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); }
  @media (min-width: 56rem) { .ws-hero { grid-template-columns: 1.05fr 0.95fr; } }
  .ws-hero h1 { font-size: var(--fs-4xl); max-width: 14ch; }
  .ws-hero h1 em { font-style: italic; font-weight: 400; color: var(--accent); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .ws-hero .lead { margin-top: 1rem; }
  .ws-hero__cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }
  .ws-hero__img { aspect-ratio: 4 / 5; max-width: 30rem; margin-inline: auto; }
  @media (min-width: 56rem) { .ws-hero__img { aspect-ratio: 3 / 4; max-width: none; } }

  /* why it sells */
  .ws-why__img { box-shadow: var(--shadow-2); }
  .ws-stats { margin: var(--sp-6) 0; grid-template-columns: repeat(2, 1fr); }
  .ws-stats .stat strong { color: var(--accent); }

  /* formats table */
  .ws-table { border-radius: var(--r-lg); background: var(--bg-raised); box-shadow: var(--shadow-1); padding: 0.5rem 1.25rem; }
  .ws-table .table { min-width: 44rem; font-size: var(--fs-sm); }
  .ws-table .table th { font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); padding-block: 0.9em; }
  .ws-table .table td { padding-block: 0.9em; }
  .ws-table tbody tr:last-child td { border-bottom: 0; }
  .ws-table__name { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-md); text-decoration: none; line-height: 1.2; }
  .ws-table__name:hover { color: var(--accent); }
  .ws-table__claims { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  /* steps: three, not four */
  @media (min-width: 56rem) { .ws-steps { grid-template-columns: repeat(3, 1fr); gap: var(--sp-6); } }

  /* logistics band */
