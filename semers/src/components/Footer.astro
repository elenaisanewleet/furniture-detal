---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, footerNav } from '~/data/site';
import { localePath, stripLocale } from '~/i18n/config';
import { t } from '~/i18n/ui';
const year = new Date().getFullYear();
const { locale } = stripLocale(Astro.url.pathname);
const ui = t(locale);
const L = (href: string) => localePath(href, locale);
const columns = [
  { key: 'shop' as const, label: ui.footerHeadings.shop, links: footerNav.shop },
  { key: 'learn' as const, label: ui.footerHeadings.learn, links: footerNav.learn },
  { key: 'company' as const, label: ui.footerHeadings.company, links: footerNav.company },
];
---
<footer class="ftr">
  <div class="ftr__cta container">
    <div class="ftr__cta-inner">
      <p class="eyebrow">{ui.newsletterEyebrow}</p>
      <h2 class="display">{ui.newsletterTitle}</h2>
      <p class="muted">{ui.newsletterLead}</p>
      <form class="ftr__form" data-form="newsletter" data-success={ui.newsletterSuccess}>
        <div class="honey" aria-hidden="true"><label>{ui.website} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="sr-only" for="ftr-email">{ui.emailLabel}</label>
        <input class="input" id="ftr-email" type="email" name="email" placeholder={ui.emailPlaceholder} required autocomplete="email" />
        <button class="btn" type="submit">{ui.subscribe} <Icon name="arrow" size={18} class="arrow" /></button>
      </form>
      <p class="tiny muted" data-form-note>{ui.newsletterConsent} <a href={L('/legal/privacy/')}>{ui.privacyPolicy}</a>.</p>
    </div>
  </div>
  <div class="ftr__main container">
    <div class="ftr__brand">
      <a href={L('/')} aria-label={ui.home}><Logo size={34} /></a>
      <p class="ftr__tag">{ui.footerTagline}</p>
      <div class="ftr__social">
        {site.social.instagram && <a href={site.social.instagram} rel="noopener" target="_blank" aria-label={ui.instagramAria}><Icon name="instagram" /></a>}
        <a href={`mailto:${site.email}`} aria-label={ui.emailLabel}><Icon name="mail" /></a>
      </div>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.label}>
        <h3>{c.label}</h3>
        <ul>{c.links.map((l) => <li><a href={L(l.href)}>{ui.footerLinks[l.key]}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="ftr__legal container">
    <p>© {year} {site.brand.legalName} · {site.locality}, {site.country}</p>
    <p>{ui.vatLine} <a href={L('/legal/shipping-returns/')}>{ui.footerLinks.shippingReturns}</a> · <a href={L('/legal/terms/')}>{ui.footerLinks.terms}</a> · <a href={L('/legal/privacy/')}>{ui.footerLinks.privacy}</a></p>
  </div>
</footer>
<style>
  .ftr { margin-top: clamp(3rem, 8vw, 7rem); background: var(--bg-sunken); border-top: 1px solid var(--line); }
  .ftr__cta { padding-block: clamp(3rem, 7vw, 6rem); }
  .ftr__cta-inner { max-width: 44rem; }
  .ftr__cta h2 { margin: 0.6rem 0 0.6rem; font-size: var(--fs-3xl); }
  .ftr__form { display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; margin: 1.5rem 0 0.75rem; max-width: 34rem; }
  @media (max-width: 30rem) { .ftr__form { grid-template-columns: 1fr; } }
  .ftr__main { display: grid; gap: 2.5rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  @media (min-width: 48rem) { .ftr__main { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
  .ftr__brand a { text-decoration: none; display: inline-flex; }
  .ftr__tag { margin: 1rem 0; max-width: 28ch; color: var(--fg-2); }
  .ftr__social { display: flex; gap: 0.5rem; }
  .ftr__social a { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line); transition: background var(--dur-fast), color var(--dur-fast); }
  .ftr__social a:hover { background: var(--ink-900); color: var(--cream-0); }
  .ftr h3 { margin-bottom: 0.9rem; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .ftr ul a { text-decoration: none; }
  .ftr ul a:hover { text-decoration: underline; }
  .ftr__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.25rem 2rem; border-top: 1px solid var(--line); font-size: var(--fs-xs); color: var(--fg-3); }
  .ftr__legal p { margin: 0; }
</style>
