---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '~/data/site';
import { formatThreshold } from '~/data/products';
import { LOCALES, LOCALE_META, localePath, stripLocale } from '~/i18n/config';
import { t, bold } from '~/i18n/ui';
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const { locale, path } = stripLocale(Astro.url.pathname);
const ui = t(locale);
const L = (href: string) => localePath(href, locale);
const languages = LOCALES.map((l) => ({ locale: l, href: localePath(path, l), native: LOCALE_META[l].native, current: l === locale }));
---
<!--
  The header floats over the page as a strip of glass: nothing behind it is
  hidden, and it only takes a ground once the reader has scrolled. The mark
  sits on a small cream sticker so the brand's own colours survive the night.
-->
<header class={`hdr ${transparent ? 'hdr--float' : ''}`} id="hdr">
  <div class="hdr__bar">
    <span class="hdr__bar-text" set:html={bold(ui.headerBar(formatThreshold(site.shipping.freeFrom, locale)))} />
  </div>
  <div class="hdr__main container--wide">
    <button class="hdr__burger" id="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label={ui.openMenu}>
      <Icon name="menu" size={24} />
    </button>
    <a class="hdr__logo" href={L('/')} aria-label={ui.home}><Logo size={30} /></a>
    <nav class="hdr__nav" id="nav" aria-label={ui.primaryNav}>
      <button class="hdr__nav-close" type="button" data-nav-close aria-label={ui.closeMenu}><Icon name="close" size={24} /></button>
      <ul>
        {nav.map((n, i) => (
          <li style={`--i:${i}`}><a href={L(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{ui.nav[n.key]}</a></li>
        ))}
      </ul>
      <div class="hdr__nav-cta">
        <a class="btn btn--block" href={L('/shop/')}>{ui.shopAll}</a>
        <ul class="hdr__langs" aria-label={ui.language}>
          {languages.map((l) => (
            <li><a href={l.href} lang={l.locale} hreflang={l.locale} aria-current={l.current ? 'true' : undefined}>{l.native}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <div class="hdr__actions">
      <div class="lang" aria-label={ui.language}>
        {languages.map((l) => (
          <a class="lang__a" href={l.href} lang={l.locale} hreflang={l.locale} aria-current={l.current ? 'true' : undefined}>{l.locale.toUpperCase()}</a>
        ))}
      </div>
      <a class="hdr__shop btn btn--sm" href={L('/shop/')}>{ui.shop}</a>
      <button class="hdr__cart" id="cart-open" aria-label={ui.openCart} aria-haspopup="dialog">
        <Icon name="cart" size={22} />
        <span class="hdr__count" id="cart-count" hidden>0</span>
      </button>
    </div>
  </div>
</header>
<div class="hdr__scrim" id="nav-scrim" hidden></div>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: transparent; transition: background var(--dur), box-shadow var(--dur), backdrop-filter var(--dur); }
  .hdr.is-stuck { background: rgb(14 28 15 / 0.92); backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%); box-shadow: 0 1px 0 var(--line); }
  .hdr--float { position: fixed; left: 0; right: 0; }
  .hdr__bar { text-align: center; font-size: var(--fs-xs); letter-spacing: 0.04em; padding: 0.45rem 1rem; color: var(--night-900); background: var(--cream-1); }
  .hdr__bar :global(strong) { font-weight: 700; }
  /* On a phone the bar is one line cut with an ellipsis, so it never pushes the header down. */
  @media (max-width: 40rem) { .hdr__bar { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-inline: 0.75rem; } }
  .hdr__main { display: flex; align-items: center; gap: 1rem; height: 4.6rem; }
  .hdr__logo { display: inline-flex; align-items: center; padding: 0.3rem 0.7rem; border-radius: var(--r-pill); background: var(--cream-0); color: var(--night-900); text-decoration: none; margin-right: auto; transition: transform var(--dur) var(--ease-spring); }
  .hdr__logo:hover { transform: scale(1.04); }
  .hdr__logo :global(img) { height: 46px; width: auto; display: block; }
  .hdr__burger { display: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; place-items: center; color: var(--cream-1); }
  .hdr__nav ul { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a { display: inline-flex; white-space: nowrap; padding: 0.55rem 0.85rem; border-radius: var(--r-pill); text-decoration: none; font-weight: 500; font-size: var(--fs-sm); color: var(--cream-2); transition: color var(--dur-fast), background var(--dur-fast); }
  .hdr__nav a:hover { color: var(--cream-0); background: rgb(243 233 214 / 0.08); }
  .hdr__nav a[aria-current="page"] { color: var(--cream-0); background: rgb(243 233 214 / 0.12); }
  .hdr__nav-close, .hdr__nav-cta { display: none; }
  .hdr__actions { display: flex; align-items: center; gap: 0.35rem; margin-left: auto; }
  .lang { display: flex; gap: 0.1rem; margin-right: 0.4rem; }
  .lang__a { padding: 0.35rem 0.5rem; border-radius: var(--r-pill); text-decoration: none; font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.06em; color: var(--fg-3); transition: color var(--dur-fast), background var(--dur-fast); }
  .lang__a:hover { color: var(--cream-0); }
  .lang__a[aria-current="true"] { color: var(--night-900); background: var(--cream-1); }
  .hdr__cart { position: relative; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; color: var(--cream-1); transition: background var(--dur-fast), color var(--dur-fast); }
  .hdr__cart:hover { background: var(--cream-1); color: var(--night-900); }
  .hdr__count { position: absolute; top: 0.15rem; right: 0.15rem; min-width: 1.15rem; height: 1.15rem; padding: 0 0.3rem; border-radius: var(--r-pill); background: var(--accent); color: var(--night-900); font-size: 0.65rem; font-weight: 800; display: grid; place-items: center; line-height: 1; box-shadow: 0 0 12px var(--accent); }
  .hdr__scrim { position: fixed; inset: 0; z-index: 49; background: rgb(6 10 8 / 0.7); backdrop-filter: blur(6px); }

  /* Russian and Latvian labels run long: between the drawer and full width the links sit tighter. */
  @media (min-width: 62.01rem) and (max-width: 74rem) { .hdr__nav a { padding-inline: 0.55rem; font-size: var(--fs-xs); } }
  @media (max-width: 62rem) {
    .hdr__main { height: 4.1rem; gap: 0.5rem; }
    .hdr__burger { display: grid; }
    .hdr__shop, .lang { display: none; }
    .hdr__nav { position: fixed; inset: 0 auto 0 0; z-index: 60; width: min(24rem, 88vw); padding: 1.25rem; background: var(--night-800); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 1.5rem; transform: translateX(-102%); transition: transform var(--dur-slow) var(--ease-expo); visibility: hidden; }
    .hdr__nav.is-open { transform: none; visibility: visible; }
    .hdr__nav ul { flex-direction: column; gap: 0.15rem; margin-top: 2.5rem; }
    .hdr__nav a { font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 500; letter-spacing: -0.02em; padding: 0.45rem 0.4rem; color: var(--cream-1); }
    .hdr__nav-close { display: grid; position: absolute; top: 0.9rem; right: 0.9rem; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: 50%; color: var(--cream-1); }
    .hdr__nav-cta { display: grid; gap: 1rem; margin-top: auto; }
    .hdr__langs { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; }
    .hdr__langs a { padding: 0.4rem 0.7rem; font-size: var(--fs-sm); font-family: var(--font-sans); border-radius: var(--r-pill); color: var(--fg-2); }
    .hdr__langs a[aria-current="true"] { background: var(--cream-1); color: var(--night-900); }
  }
</style>
