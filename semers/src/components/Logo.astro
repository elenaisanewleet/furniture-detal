---
/** Wordmark: "Semers" set in Fraunces with an apple-leaf mark. Inline SVG so it scales crisply and inherits currentColor. */
interface Props { class?: string; size?: number }
const { class: cls = '', size = 28 } = Astro.props;
---
<span class={`logo ${cls}`} translate="no" style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" width={size} height={size}>
    <path d="M16 6.5c3.2-3.4 8.6-2.6 10.3 1.3.8 2 .6 4.5-.5 7.5-1.6 4.6-4.6 8.9-8.1 10.7-1.1.6-2.3.6-3.4 0C10.8 24.2 7.8 19.9 6.2 15.3c-1.1-3-1.3-5.5-.5-7.5C7.4 3.9 12.8 3.1 16 6.5Z" fill="var(--apple-500)"/>
    <path d="M16.4 7.2c.3-2.9 2.1-4.7 4.9-5.2-.2 2.8-1.9 4.7-4.9 5.2Z" fill="var(--leaf-500)"/>
    <path d="M12.6 10.2c.9-1.8 2.7-2.4 4.1-1.6" stroke="#fff" stroke-opacity=".7" stroke-width="1.4" stroke-linecap="round" fill="none"/>
  </svg>
  <span class="logo__word" translate="no">Semers</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.45em; font-family: var(--font-display); font-weight: 700; font-size: calc(var(--logo-size) * 0.95); letter-spacing: -0.03em; line-height: 1; font-variation-settings: 'opsz' 48, 'SOFT' 80; color: inherit; }
  .logo__mark { flex: none; transition: transform var(--dur) var(--ease-spring); }
  a:hover .logo__mark { transform: rotate(-12deg) scale(1.08); }
</style>
