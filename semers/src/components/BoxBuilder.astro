---
/**
 * "Build your box" in a given size. The size and the discount come in as props
 * so each size can be its own page with its own URL, the way the strongest
 * subscription shops sell a 4-, 6- and 8-pack: a set you can advertise, not a
 * number hidden in a dropdown.
 *
 * All the state lives in src/scripts/site.ts, which reads `size` and `discount`
 * off the data attributes below.
 */
import Icon from './Icon.astro';
import { productBySlug, FLAVORS, formatPrice, formatThreshold } from '~/data/products';
import { img, imgSrc, imgSmall } from '~/data/images';
import { site } from '~/data/site';
import { stripLocale } from '~/i18n/config';
import { localizedProduct } from '~/data/copy';
import { t } from '~/i18n/ui';

interface Props {
  size: number;
  discount: number;
  /** The other sizes, so a shopper who wants a bigger box does not have to go back to the shop. */
  siblings: { size: number; discount: number; href: string }[];
}
const { size, discount, siblings } = Astro.props;

const { locale } = stripLocale(Astro.url.pathname);
const ui = t(locale);
const sources = ['apple-bar-35g', 'flourless-apple-bar-50g', 'apple-meringue-35g']
  .map((s) => productBySlug(s)!)
  .filter(Boolean)
  .map((p) => localizedProduct(p, locale));
const items = sources.flatMap((p) =>
  p.variants.map((v) => ({
    id: `${p.slug}:${v.key}`,
    name: `${p.name} ${ui.flavours[v.key]}`,
    sub: `${p.weightGrams} g · ${p.kcalPerUnit} kcal · ${formatPrice(v.price ?? p.price, locale)}`,
    price: v.price ?? p.price,
    image: imgSmall(p.images[0]),
    weight: p.weightGrams,
    color: FLAVORS[v.key].color,
    group: p.name,
  })),
);
const groups = [...new Set(items.map((i) => i.group))];
const boxImg = { ...img('gift-box'), src: imgSrc('gift-box') };
const cheapest = Math.min(...items.map((i) => i.price));
const minPrice = cheapest * size * (1 - discount);
const pct = Math.round(discount * 100);
---

<section class="container builder" data-builder data-size={size} data-discount={discount} data-image={boxImg.src}>
  <div class="builder__list">
    {siblings.length > 0 && (
      <div class="boxsizes" role="group" aria-label={ui.boxSize}>
        <span class="boxsizes__label">{ui.boxSize}</span>
        {[{ size, discount, href: '' }, ...siblings]
          .sort((a, b) => a.size - b.size)
          .map((s) =>
            s.href ? (
              <a class="boxsize" href={s.href}>
                <b>{ui.pieces(s.size)}</b>
                <span>{ui.savePct(Math.round(s.discount * 100))}</span>
              </a>
            ) : (
              <span class="boxsize is-on" aria-current="page">
                <b>{ui.pieces(s.size)}</b>
                <span>{ui.savePct(pct)}</span>
              </span>
            ),
          )}
      </div>
    )}

    {groups.map((g) => (
      <div class="builder__group">
        <h2 class="builder__h">{g}</h2>
        <div class="builder__items">
          {items.filter((i) => i.group === g).map((i) => (
            <div class="bi">
              <img class="bi__img" src={i.image} alt="" width="64" height="64" loading="lazy" decoding="async" />
              <div>
                <div class="bi__name"><span class="bi__dot" style={`--sw:${i.color}`}></span>{i.name}</div>
                <div class="bi__sub">{i.sub}</div>
              </div>
              <button class="btn btn--sm btn--ink" type="button" data-builder-pick data-id={i.id} data-name={i.name} data-price={i.price} data-image={i.image} data-weight={i.weight} aria-label={ui.addToBoxAria(i.name)}><Icon name="plus" size={16} /> {ui.add}</button>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <aside class="builder__aside">
    <div class="builder__box">
      <div class="co__row"><h2>{ui.yourBox}</h2><strong data-builder-count>0 / {size}</strong></div>
      <div class="builder__slots" aria-live="polite">
        {Array.from({ length: size }).map(() => <div class="builder__slot" data-builder-slot></div>)}
      </div>
      <ul class="builder__picked small" data-builder-list></ul>
      <div class="co__row co__total"><span>{ui.boxPrice}</span><span><s class="muted small" data-builder-was></s> <span class="num" data-builder-price>{formatPrice(0, locale)}</span></span></div>
      <button class="btn btn--lg btn--block" type="button" data-builder-add disabled>{ui.addBoxToCart}</button>
      <p class="tiny muted">{ui.boxNote(pct, formatPrice(minPrice, locale), formatPrice(minPrice / size, locale), formatThreshold(site.shipping.freeFrom, locale))}</p>
    </div>
  </aside>
</section>

<style>
  .builder__group + .builder__group { margin-top: 1.75rem; }
  .builder__h { font-size: var(--fs-lg); margin-bottom: 0.75rem; }
  .builder__items { display: grid; gap: 0.6rem; }
  .bi__dot { display: inline-block; width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--sw); margin-right: 0.4em; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1); }
  .builder__picked { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  /* Rows are rendered by the client script, outside Astro's style scope. */
  .builder__picked :global(li) { display: flex; justify-content: space-between; gap: 1rem; }
  .builder__box .co__row h2 { font-size: var(--fs-xl); }

  /* Size switcher: each size is a real page, so these are links, not a control. */
  .boxsizes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 1.75rem; }
  .boxsizes__label { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--fg-3); margin-right: 0.25rem; }
  .boxsize {
    display: grid; gap: 0.05rem; padding: 0.45rem 0.85rem; text-align: center; text-decoration: none; color: inherit;
    border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg-raised); line-height: 1.25;
  }
  .boxsize:hover { border-color: var(--fg-3); }
  .boxsize.is-on { border-color: var(--accent); background: color-mix(in oklab, var(--accent) 8%, var(--bg-raised)); }
  .boxsize b { font-size: var(--fs-sm); }
  .boxsize span { font-size: var(--fs-xs); color: var(--fg-3); }
  .boxsize.is-on span { color: var(--accent); }
</style>
