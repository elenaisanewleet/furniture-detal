# ---- Public (baked into the static site at build time) ----
SITE_URL=https://semers.org
PUBLIC_MAIL=av@semers.org
PUBLIC_WHOLESALE_MAIL=sales@semers.org
PUBLIC_PHONE=+371 22841714
PUBLIC_WHATSAPP=
PUBLIC_INSTAGRAM=https://www.instagram.com/semers
PUBLIC_TIKTOK=
PUBLIC_FACEBOOK=
PUBLIC_LINKEDIN=
PUBLIC_ORDER_ENDPOINT=/api/order
PUBLIC_GOOGLE_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_PLAUSIBLE_DOMAIN=

# ---- Server only (Vercel project settings → Environment Variables) ----
# Orders and forms are forwarded to Telegram and/or e-mail. Configure at least one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
# Where the shop's copy of every order goes. The address is in DEPLOY.md § 1b; it is never printed on a page.
ORDER_TO_EMAIL=
ORDER_FROM_EMAIL=Semers Shop <shop@semers.org>
# Where a customer's reply to their receipt lands: the published customer address.
REPLY_TO_EMAIL=av@semers.org

# ---- Payments: Paysera (Cloudflare Worker only; see DEPLOY.md § 1c) ----
# With both of the first two set, the checkout takes payment; without them it sends order requests.
PAYSERA_PROJECT_ID=
PAYSERA_PASSWORD=
# 1 = Paysera test payments (no money moves). Remove it, or set 0, to go live.
PAYSERA_TEST=1
